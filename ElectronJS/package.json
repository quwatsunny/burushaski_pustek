{
  "name": "flask-electron-app",
  "version": "1.0.0",
  "description": "Electron desktop app for Flask backend using existing UI files.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pyinstaller": "python -m PyInstaller app.spec --distpath dist",
    "predist": "npm run pyinstaller",
    "dist": "npm run pyinstaller && electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.girmintok.app",
    "productName": "GirminTok",
    "files": [
      "main.js",
      "package.json",
      "dist/GirminTok.exe",
      "ui/**",
      "ui/assets/**",
      "ui/css/**",
      "dictionaries/**",
      "tools/**",
      "uploads/**",
      "dictionaries.db"
    ],
    "extraResources": [
      {
        "from": "dist/GirminTok.exe",
        "to": "GirminTok.exe"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
