<sense id="4c674942-9ce2-4ad0-9990-36b40c8e9b5d">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>inundate, submerge, sag</text></gloss>
<gloss lang="ur-PK"><text>دھنس یا ڈوب جاؤ</text></gloss>
<example>
<form lang="bsk"><text>śón gorʰcum bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The bed has sagged. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus toq ulle moġorʰću. </text></form>
<translation type="Free translation">
<form lang="en"><text>That lady sunk in the mud. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>śolʰt yaṭe búṭ gye eti ka, śolʰt ġorʰcićimi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The roof will sink in if it snowed a lot. </text></form>
</translation>
</example>
</sense>
</entry>
