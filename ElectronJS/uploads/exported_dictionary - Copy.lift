<relation type="Compare" ref="gótá_6c2d64a4-f0e1-490f-b274-205be318f41e"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʌt</text></form>
</field>
<trait name="Past Participle" value="Past Participial"/>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اَت</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>t</text></form>
</field>
<trait name="Possessors" value="O-Obligatorily Possessors"/>
<sense id="a8cf629c-867e-4c97-9e53-9eceb6d29706" order="0">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>make me</text></gloss>
<gloss lang="ur-PK"><text>مجھے بنا لو</text></gloss>
<example>
<form lang="bsk"><text>ja thoṣallall át. </text></form>
<translation type="Free translation">
<form lang="en"><text>Make me bride/groom</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja śuwa át.</text></form>
<translation type="Free translation">
<form lang="en"><text>Make me better.  </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un ja śuwa aiata. </text></form>
<translation type="Free translation">
<form lang="en"><text>You did not make me better. </text></form>
</translation>
</example>
</sense>
<sense id="0069c21c-9884-4497-a755-c51aca8e7399" order="1">
<gloss lang="en"><text>With the word 'phat', it is used in the sense of 'allowing'. </text></gloss>
<gloss lang="ur-PK"><text>مجھ سے کر والو</text></gloss>
<example>
<form lang="bsk"><text>ja cheraġa phát át</text></form>
<translation type="Free translation">
<form lang="en"><text>Allow me to go.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja dora ġa phat at.</text></form>
<translation type="Free translation">
<form lang="en"><text>Allow me to work or let me work. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un ja holla phat aiatá. </text></form>
<translation type="Free translation">
<form lang="en"><text>You did not let me out. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-07-12T17:37:06Z" dateModified="2025-11-22T14:20:44Z" id="áta_e8bb2c17-1388-444f-affc-c242300e4b74" guid="e8bb2c17-1388-444f-affc-c242300e4b74">
<lexical-unit>
<form lang="bsk"><text>áta</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>

- á- → Prefix for 1SG - Marks the first person singular subject. 
- -t- → Bound clitic - Functions as a grammatical connector or marker that cannot stand alone.
 - It “leans” on the prefix and suffix, binding them together. 
- -a → Past tense suffix for 2SG - Marks second person singular in the past tense.</text></form>
</note>
<relation type="Compare" ref="étt_60304497-dab2-43e5-8696-8be2db986e51"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʌta</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اتاࣷ</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>ta</text></form>
</field>
<trait name="Possessors" value="O-Obligatorily Possessors"/>
<sense id="0c93c06f-fef2-4a44-a89e-f4300a406da4">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>2SG made 1SG something, you made me</text></gloss>
<gloss lang="ur-PK"><text>(آپ نے) مجھے بنایا</text></gloss>
<example>
<form lang="bsk"><text>un ja masqara áta. </text></form>
<translation type="Free translation">
<form lang="en"><text>You made me fool. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un ja xośaan áta.</text></form>
<translation type="Free translation">
<form lang="en"><text>You made me happy. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-12-17T15:05:59Z" dateModified="2025-11-22T17:36:01Z" id="ataġaśi_992c92b1-de62-4166-bec1-a768e03f99da" guid="992c92b1-de62-4166-bec1-a768e03f99da">
