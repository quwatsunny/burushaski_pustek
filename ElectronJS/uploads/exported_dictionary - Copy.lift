<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>breaking (nut or shell)</text></gloss>
<gloss lang="ur-PK"><text>اخروٹ وغیرہ توڑنا۔</text></gloss>
<example>
