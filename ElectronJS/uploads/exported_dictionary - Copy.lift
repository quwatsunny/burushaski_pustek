<example>
<form lang="bsk"><text>un thár-naśár boota guwayum ba, waarʰca guchara. </text></form>
<translation type="Free translation">
<form lang="en"><text>Why are you swaying, could you walk properly. </text></form>
</translation>
</example>
</sense>
