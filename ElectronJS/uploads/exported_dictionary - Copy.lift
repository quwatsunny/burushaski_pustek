</translation>
</example>
</sense>
<sense id="b95a016e-7bd7-4f27-b613-c477e9158066" order="1">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>coldness, state of being cold</text></gloss>
<gloss lang="ur-PK"><text>ٹھنڈ یا سردی</text></gloss>
<example>
<form lang="bsk"><text>holle búṭ ćhaġorum duwa. </text></form>
<translation type="Free translation">
