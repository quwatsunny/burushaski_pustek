<sense id="8cf6bd6a-b8ef-4298-ab80-667bf146aed3" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>bottom, base</text></gloss>
<gloss lang="ur-PK"><text>پیندہ</text></gloss>
<example>
<form lang="bsk"><text>chell gamún ca galī. </text></form>
<translation type="Free translation">
<form lang="en"><text>The water went to the bottom. </text></form>
</translation>
</example>
</sense>
<sense id="f3ada2ef-fa69-49eb-9792-1543fc01b71c" order="1">
<gloss lang="en"><text>lower part of anything such as a tree trunk, wall or land</text></gloss>
<gloss lang="ur-PK"><text>کسی جگہ یا چیز کا نچلا حصہ۔ </text></gloss>
<example>
<form lang="bsk"><text>gamúnum dalla yani.</text></form>
<translation type="Free translation">
<form lang="en"><text>He started from the bottom up. </text></form>
</translation>
</example>
</sense>
<sense id="854193a5-d780-4a18-8615-e4420ecc16c0" order="2">
<grammatical-info value="Noun">
</grammatical-info>
