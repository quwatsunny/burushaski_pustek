<sense id="e656c067-cf7a-4a7c-aac2-2952b29013dc">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>a flowering plant with white flowers.</text></gloss>
<gloss lang="ur-PK"><text>ایک قسم کی جھاڑی جس کے پھول سفید رنگ کے ہوتے ہیں۔</text></gloss>
<trait name ="semantic-domain-ddp4" value="1.5 Plant"/>
</sense>
</entry>
<entry dateCreated="2020-08-17T06:38:03Z" dateModified="2025-10-08T01:12:46Z" id="śareś_f5f089ba-6ed1-47f4-94e9-abd1e0e78f34" guid="f5f089ba-6ed1-47f4-94e9-abd1e0e78f34">
