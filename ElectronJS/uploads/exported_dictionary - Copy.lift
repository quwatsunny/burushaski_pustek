<entry dateCreated="2022-02-08T05:22:06Z" dateModified="2025-11-12T21:45:52Z" id="a1_544258cc-2719-406a-bb33-466a88f4e812" guid="544258cc-2719-406a-bb33-466a88f4e812" order="1">
<lexical-unit>
<form lang="bsk"><text>a</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="-śku_de866746-5d28-4478-9399-77a01e3ff248"/>
<relation type="Compare" ref="jursuma_2a973bbe-e56c-4128-ab3c-2b56e3e9b14b"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>a</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ا</text></form>
</field>
<trait name="Review 1" value="202511121"/>
<sense id="c02ae9a1-32cc-48c8-bc22-163d18c2e656">
<gloss lang="en"><text>Plural suffix, used with certain nouns and adjectives</text></gloss>
<gloss lang="ur-PK"><text>بعض الفاط کو جمع بناتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>haġor → haġora</text></form>
<translation type="Free translation">
<form lang="en"><text>horse, horses</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>huk → huka</text></form>
<translation type="Free translation">
<form lang="en"><text>dog,dogs</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>urʰk → hurʰka</text></form>
<translation type="Free translation">
<form lang="en"><text>wolf, wolves </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>henum → henuma</text></form>
<translation type="Free translation">
<form lang="en"><text>learned, learned ones</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-10-09T16:37:41Z" dateModified="2025-11-12T21:45:52Z" id="a2_ba05ae07-7be6-4901-9901-4de23d81e729" guid="ba05ae07-7be6-4901-9901-4de23d81e729" order="2">
<lexical-unit>
<form lang="bsk"><text>a</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<trait name="do-not-publish-in" value="Idioms"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>a</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اࣷ</text></form>
</field>
<trait name="Review 1" value="202511111"/>
<sense id="52db8435-14bc-4853-a983-33908f46634f" order="0">
<gloss lang="en"><text>Past Suffix, agrees in person mostly with 1SG. </text></gloss>
<gloss lang="ur-PK"><text>
لاحقہ فعل ماضی کے لیے فاعل متکلم (واحد ) کے ساتھ استعمال ہوتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>ja doro etá (et +a).</text></form>
<translation type="Free translation">
<form lang="en"><text>I did the work.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja herá (her +a).</text></form>
<translation type="Free translation">
<form lang="en"><text>I cried</text></form>
</translation>
</example>
</sense>
<sense id="5fcd36c0-a56a-403f-a0b7-442c256ec95a" order="1">
<gloss lang="en"><text>Past Suffix, agrees in person with all types of pronouns in the case of the verb came (d-i).</text></gloss>
<example>
<form lang="bsk"><text>ja daia  (da-i-a).</text></form>
<translation type="Free translation">
<form lang="en"><text>I came. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ses duia (du -i-a).</text></form>
<translation type="Free translation">
<form lang="en"><text>People came. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus domoia.</text></form>
<translation type="Free translation">
<form lang="en"><text>The woman came. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>hir īlja dia (di +a).</text></form>
<translation type="Free translation">
<form lang="en"><text>The man came back. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2025-11-16T13:44:46Z" dateModified="2025-11-16T14:44:56Z" id="a3_46e8ddb7-0293-4362-a24f-f91145c52a3f" guid="46e8ddb7-0293-4362-a24f-f91145c52a3f" order="3">
<lexical-unit>
<form lang="bsk"><text>a</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<trait name="do-not-publish-in" value="Idioms"/>
<sense id="94d5a42b-80eb-440e-a9d2-daf623760085">
<grammatical-info value="Determiner">
</grammatical-info>
<gloss lang="en"><text>Proximal Determiner used with adverbs</text></gloss>
<gloss lang="ur-PK"><text>قریب اشارہ گر تعین کنندہ</text></gloss>
<example>
<form lang="bsk"><text>jaa daroġo, akho (a +kho)), apaći (a+pa+ći) oos. </text></form>
<translation type="Free translation">
<form lang="en"><text>Place my staff, nearer here, near my side. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-11-07T15:37:06Z" dateModified="2025-11-11T23:41:31Z" id="a-1_9426b638-0c18-47f1-9de3-ec8332ab64f0" guid="9426b638-0c18-47f1-9de3-ec8332ab64f0">
<lexical-unit>
<form lang="bsk"><text>a-</text></form>
</lexical-unit>
<trait  name="morph-type" value="prefix"/>
<relation type="Compare" ref="aalʰta_0270ed2a-c819-4530-bd73-dffb4a810bb3"/>
<pronunciation>
</pronunciation>
<field type="IPA Burushaski">
<form lang="bsk"><text>a-</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اَ</text></form>
</field>
<sense id="235ff257-debf-4bdb-88b9-b61541ee66b2">
<gloss lang="en"><text>Pronominal prefix used with verbs in Objective case, where the receiver of the action is 1SG. </text></gloss>
<example>
<form lang="bsk"><text>bape ja ajó ćamalʰtóq adeli (a + deli)</text></form>
<translation type="Free translation">
<form lang="en"><text>The grandpa struck me with a hard slap.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-09-30T12:12:51Z" dateModified="2025-11-21T17:20:39Z" id="a-2_8d8ad6c1-41d8-49c8-af58-3cb3cd506be3" guid="8d8ad6c1-41d8-49c8-af58-3cb3cd506be3">
<lexical-unit>
<form lang="bsk"><text>a-</text></form>
</lexical-unit>
<trait  name="morph-type" value="prefix"/>
<relation type="Compare" ref="aiućhi_7793682c-580b-429d-a1db-afa37b60e87e"/>
<relation type="Compare" ref="aśato_5f58411f-b392-47c1-974f-efbab83cbcd2"/>
<relation type="Compare" ref="ai/-_f78b33b8-dc4e-4c15-bb91-eb5f2121dffe"/>
<relation type="Compare" ref="aćhara_2bc70ae9-1dc3-47f5-843e-96ddf932b124"/>
<relation type="Compare" ref="aparʰciki ġaayum_f599bfe8-ab60-46f9-a7ad-8af383219cde"/>
<relation type="Compare" ref="akuheyám_7dc7fde6-0675-4595-a135-80b733b6b492"/>
<relation type="Compare" ref="akaśum_10c0c66a-e1a4-42d2-957c-8891243c2b3a"/>
<relation type="Compare" ref="apaastimi_ecd8a3f2-41fc-4bf5-9248-2b7cc31c45e0"/>
<relation type="Compare" ref="apú_9af34df3-b35a-4435-a583-18cd56d40ddd"/>
<relation type="Compare" ref="apai_8669fba5-e3f0-4a4b-bd0e-eac3f80502ed"/>
<relation type="Compare" ref="akheen_3659b5b3-bc89-4d5d-8a35-dc2a58076569"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>a-</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ا-</text></form>
</field>
<sense id="7d7be58e-cbdf-4fe6-8b24-65cbd206d49d">
<gloss lang="en"><text>A negative prefix used with verbs.  The negative prefix in Yasin Burushaski has two allomorphs: /a/ and /ai/). Sometimes phonemes change as a result of Inflectional change.  For example: dohón (hold) will be atohón (d → t), bai, apai (b → p).  gaṭí, akaṭi (g → k), gumán, akumán (g → k). ġaten, axaten (ġ → x)

The prefix /ai/ does not affect voiced consonants, whereas the prefix /a/ induces devoicing. Notably, the prefix /ai/ is almost never used with Copular verbs; constructions like aibai, aibu, or aibi are considered incorrect. Instead, /ai/ is exclusively applied to regular verbs, such as aigirmin ("Do not write"). Conversely, certain verbs like mani or gali only accept /ai/ or /ayi/ as negative prefixes, rejecting /a/.</text></gloss>
<gloss lang="ur-PK"><text>سابقہ جو بعض افعال کو افعالِ نفی میں تبدیل کرتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>momo ġa amuu (a + muu)</text></form>
<translation type="Free translation">
<form lang="en"><text>Don't give it to her. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo ane śuwa hir en ce amuyáyu (a + muyáyu)</text></form>
<translation type="Free translation">
<form lang="en"><text>She could not find a good man.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne akho apái (a + bai)</text></form>
<translation type="Free translation">
<form lang="en"><text>He is not here.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hir ayigali (aigalí). </text></form>
<translation type="Free translation">
<form lang="en"><text>That man did  not go. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-11-11T00:05:11Z" dateModified="2025-11-12T00:28:54Z" id="-a1_ef89a41f-8785-4aef-ade4-7d86999fd2d5" guid="ef89a41f-8785-4aef-ade4-7d86999fd2d5">
<lexical-unit>
<form lang="bsk"><text>-a</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-a</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>-ا</text></form>
</field>
<sense id="19d1431e-85ad-4592-8be7-9c6b43d6d80e">
<gloss lang="en"><text>a Dubitative case marker used with verbs</text></gloss>
<gloss lang="ur-PK"><text>فعل کے اخر میں تزبذب کو بیان کرتا ہے۔ </text></gloss>
<example>
<translation type="Free translation">
</translation>
</example>
<example>
<form lang="bsk"><text>ćub eta, neé bo bar án ećimia.  </text></form>
<translation type="Free translation">
<form lang="en"><text>Hang on,please, let's see if he makes some statement.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>née bo xolum bia</text></form>
<translation type="Free translation">
<form lang="en"><text>I wonder if he has something hurting.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-11-09T17:21:50Z" dateModified="2025-11-12T00:40:13Z" id="-a2_7f584230-0949-46b4-a16c-d14a1e89c7e8" guid="7f584230-0949-46b4-a16c-d14a1e89c7e8">
<lexical-unit>
<form lang="bsk"><text>-a</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<note>
<form lang="en"><text>The Dative Suffix /a/ is used only with words ending in consonants. Words ending with vowels will take /ġa/ as Dative suffix marker. </text></form>
</note>
<relation type="Compare" ref="-ġa_1ed28eb4-2cd7-46b1-9e75-a6936a7aff7e"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-a</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ا</text></form>
</field>
<sense id="6b81cc3c-598c-482d-8bb3-b9b5497c7007">
<gloss lang="en"><text>Dative Case suffix, used with nouns, signifying motion towards the noun or transfer of action or change of location. </text></gloss>
<gloss lang="ur-PK"><text>مفعولی الفاظ جئسے کو، تجھے، مجھے وغیرہ کے لیے استعمال ہوتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>ja Karima (Karim +a ) sená.</text></form>
<translation type="Free translation">
<form lang="en"><text>I told (something) to Karim.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja Giilʰta ( Giilʰt +a)  cheraam ba.</text></form>
<translation type="Free translation">
<form lang="en"><text>I am going to Gilgit.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne Giilʰtum dalla (dall +a) díya.</text></form>
<translation type="Free translation">
<form lang="en"><text>He came (to) up from Gilgit. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>moo gulei arenćia waśiyú.</text></form>
<translation type="Free translation">
<form lang="en"><text>She put the pill into my hand. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-14T01:45:22Z" dateModified="2025-11-12T01:35:43Z" id="á, gu/go, mu/mo, i/e, u, ma, mi/me-_080fd3ec-f6c7-4f0e-a4b6-898577d24fd6" guid="080fd3ec-f6c7-4f0e-a4b6-898577d24fd6">
<lexical-unit>
<form lang="bsk"><text>á, gu/go, mu/mo, i/e, u, ma, mi/me-</text></form>
</lexical-unit>
<trait  name="morph-type" value="prefix"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʌ, gu/go, mu/mo, i/ɛ, u, ma, mi/mɛ-</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اࣷ، گُ، گوࣷ، مُ، اِ، ایࣷ، اُ، ماࣷ، میࣷ/مےࣷ</text></form>
</field>
<sense id="bf850059-2bd2-4533-8c3d-799c70adca05" order="0">
<gloss lang="en"><text>Prefixes used as Obligatory Possessors or possessive determiners. Obligatory Possessive singular markers are: 

SINGULAR
a_ (1SG.hmf) as in amuś → my nose
gu_,go_(2SG.hmf) as in gumuś → your nose
i,e_ (3SG.hm,xy) as in ilʰći → his eye
mo,mu_ (3SG.hf) as in mumuś → her nose 

PLURAL
me, mi_(1PL) as in milʰćimo → our eyes
ma_(2PL) as in malʰćimo → your eyes
u,o_(3PL) as in ulʰćimo → their eyes. 


These Obligatory Possessive markers are necessary for certain nouns such as body parts, kinship terms and abstract ideas such as pain, dream, anger, feeling which cannot be perceived independent of the Possessor.  The same markers are used with temporal or  spatial relations such as _yakal (toward), _pai (near). Locative terms are inalienable and hence meaningless without the pronominal prefixes.  

In Yásin Burushaski /i,e/ as Pronominal prefixes are  omitted but are implicit,  whereas in Hunza Burushaski, they are not omitted.  

Example: HB: /iśak/ means his arm. YB: /śak/ means arm or his arm.  
Vowels in prefixes may vary by dialect or phonological context: - i ↔ e, u ↔ o, mi ↔ me, etc.

</text></gloss>
<example>
<form lang="bsk"><text>jaa amúś axollum bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>My nose is hurting</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>amúś a<span lang="en">x</span>áte epai bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>My nose is near my mouth. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>jaa ac̣o goo gópai bai, da un jaa ápai ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>My brother is near you and you are near me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ápai (á +pai), gópai (gó+ pai), mópai (mó+pai)</text></form>
<translation type="Free translation">
<form lang="en"><text>Near me, near you, near her.</text></form>
</translation>
</example>
</sense>
<sense id="98395983-1986-4aae-94e5-a3d8f23e37f1" order="1">
<gloss lang="en"><text>Prefixes used  with _khár to make Reflexive Pronouns in Burushaski. </text></gloss>
<gloss lang="ur-PK"><text>سابقہ جو -کھر کے ساتھ لگ کراضطراری ضمیر بناتا ہے، جیسے اپنا، اپنے وغیرہ</text></gloss>
<example>
<form lang="bsk"><text>ja akhár desqaṭam ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I have isolated myself. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un gukhár deephoġora.</text></form>
<translation type="Free translation">
<form lang="en"><text>You bragged about yourself. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>wee ukhara ćai án eten</text></form>
<translation type="Free translation">
<form lang="en"><text>They made a tea for themselves. </text></form>
</translation>
</example>
</sense>
<sense id="df86292d-efc9-4fff-a924-f05bd60673dd" order="2">
<gloss lang="en"><text>Prefixes used with /_ya/ to make Intensive Pronouns.</text></gloss>
<gloss lang="ur-PK"><text>سابقہ جو -یاࣷ  کے ساتھ لگ کر تاکیدی ضمیر بناتا ہے، جیسے خود ہی</text></gloss>
<example>
<form lang="bsk"><text>doro un gúya etaa?</text></form>
<translation type="Free translation">
<form lang="en"><text>Did you yourself do the work?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>nee doro ġa aqareśa ja áya eta. </text></form>
<translation type="Free translation">
<form lang="en"><text>Upon his refusal to do the work, I did it myself.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-02-08T14:53:41Z" dateModified="2025-11-12T01:42:14Z" id="aa1_9100c2a2-00c4-4fef-ae20-ae082a7d5d82" guid="9100c2a2-00c4-4fef-ae20-ae082a7d5d82">
<lexical-unit>
<form lang="bsk"><text>aa</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>aː</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ا</text></form>
</field>
<sense id="37a18998-0855-451d-9c0a-2c279913a669">
<gloss lang="en"><text>A long vowel functions as a Pronominal affix in Burushaski verbs when the object is first-person singular (1SG). It gives a Causative sense to the verb. In most verb classes, it appears as a prefix, marking the experiencer or recipient of the action. - In the case of the D-verbs (a distinct morphological class in Burushaski), the same long vowel is inserted as an infix, occurring within the verb stem rather than at its edge.</text></gloss>
<gloss lang="ur-PK"><text>آ</text></gloss>
<example>
<form lang="bsk"><text>ne hire khawuṣ án aakhawui. </text></form>
<translation type="Free translation">
<form lang="en"><text>The man fed me a morsel. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ayaṭes aasell</text></form>
<translation type="Free translation">
<form lang="en"><text>Help me comb my head (hiar).</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>doro daamar (d-mar)</text></form>
<translation type="Free translation">
<form lang="en"><text>Assist me in the work. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-02-21T03:19:09Z" dateModified="2025-11-12T01:49:49Z" id="aa2_3039833b-666a-4b96-ba23-a52527ec4220" guid="3039833b-666a-4b96-ba23-a52527ec4220">
<lexical-unit>
<form lang="bsk"><text>aa</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>aː</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>آ</text></form>
</field>
<sense id="5cf7c0cb-411e-49b6-92af-3ec62e00108a">
<gloss lang="en"><text>Suffix used with verbs to create a sense of politeness.  </text></gloss>
<gloss lang="ur-PK"><text>فعل کے آخر میں لمبا الف شائستگی اور سوالیہ بنانے کے لیے لگا یا جاتا ہے۔</text></gloss>
<example>
<form lang="bsk"><text>ẓoaa cheran</text></form>
<translation type="Free translation">
<form lang="en"><text>Come on, please, let's go.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>minyas án ja ġa etaa (et +aa)</text></form>
<translation type="Free translation">
<form lang="en"><text>Could you please tell me a story. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-07T03:47:41Z" dateModified="2025-11-12T01:52:46Z" id="-aa1_cccbc542-00c7-42d1-9976-38faf4353be4" guid="cccbc542-00c7-42d1-9976-38faf4353be4">
<lexical-unit>
<form lang="bsk"><text>-aa</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-aː</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>۔ آ</text></form>
</field>
<sense id="88000314-110a-4508-a7e1-9618468235a7">
<gloss lang="en"><text>Suffix used with verbs to make an Interrogative Case. </text></gloss>
<gloss lang="ur-PK"><text>فعل کے آخر میں سوالیہ بنانے کے لیے لگایا جاتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>un girminaa (girmin +aa )?</text></form>
<translation type="Free translation">
<form lang="en"><text>Did you write ?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un ne llell etaa?</text></form>
<translation type="Free translation">
<form lang="en"><text>Did you recognize him?</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-02-20T05:19:25Z" dateModified="2025-11-12T01:53:12Z" id="-aa2_58ae2ccf-0d44-491c-9d9d-f818b3341ace" guid="58ae2ccf-0d44-491c-9d9d-f818b3341ace">
<lexical-unit>
<form lang="bsk"><text>-aa</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-aː</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>- آ</text></form>
</field>
<sense id="820ef914-f9cd-450e-be44-36622bc71f33">
<gloss lang="en"><text>Suffix used as Genitive case marker where nouns end with the vowel /a/.  Such nouns will be followed by the Possessed noun. </text></gloss>
<example>
<form lang="bsk"><text>iṣqáa (iṣqa +a) búśu dooyi. </text></form>
<translation type="Free translation">
<form lang="en"><text>Make the sheaves of the grass stand. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hir haġoraa (haġora +a) damán bai. </text></form>
<translation type="Free translation">
<form lang="en"><text>That man is the owner of the horses. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>gukye báa (bá + a) phallo bica. </text></form>
<translation type="Free translation">
<form lang="en"><text>These are grains of proso millet. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-01-29T04:40:28Z" dateModified="2025-11-12T02:00:31Z" id="aá_75b12a71-f44a-4ee8-bed2-4544bb493275" guid="75b12a71-f44a-4ee8-bed2-4544bb493275">
<lexical-unit>
<form lang="bsk"><text>aá</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="éa-_a4d3cb86-97ed-4896-a460-e691580c97a0"/>
