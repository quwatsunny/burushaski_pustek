<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>access, window of opportunity</text></gloss>
<gloss lang="ur-PK"><text>آزادی کا موقع، اندر یا باہر جانے کا عارضی موقع</text></gloss>
<example>
<form lang="bsk"><text>guyuhár halle apai, goġa carʰt ḍuusum duwa, ġare beérum ġarićum ba ka. </text></form>
<translation type="Free translation">
<form lang="en"><text>Your husband is not home, a window of opportunity has opened up for you, bark as much as you want.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-01-03T04:05:59Z" dateModified="2025-12-22T04:18:49Z" id="carʰt1_1ab02450-7ff8-42ec-a50c-fb0362a69404" guid="1ab02450-7ff8-42ec-a50c-fb0362a69404">
