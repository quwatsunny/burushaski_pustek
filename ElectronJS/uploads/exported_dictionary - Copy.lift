<sense id="5ab1657b-f9f9-4551-b1e1-6a28e82cfdb6">
<gloss lang="en"><text>wide open as if ripped off like a hide</text></gloss>
<gloss lang="ur-PK"><text>بالکل کُھلا</text></gloss>
<example>
<form lang="bsk"><text>un guxat tarabarʰce net herʰćum ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>You are crying  with your mouth wide open (as if it is ripped off). </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>hiṅ tarabarʰce duwa, ćhayeṣk ayetum ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>The door is wide open, you have not locked it. </text></form>
</translation>
</example>
</sense>
</entry>
