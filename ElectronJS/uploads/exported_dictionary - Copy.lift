<entry dateCreated="2020-08-15T20:37:17Z" dateModified="2025-10-08T01:12:46Z" id="mená1_537405f2-8084-416b-a522-a2d5718fb63f" guid="537405f2-8084-416b-a522-a2d5718fb63f">
<lexical-unit>
<form lang="bsk"><text>mená</text></form>
</lexical-unit>
