<form lang="en"><text>The king is inviting you to the court. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>gute ne hir haayume kheen duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>This is the time of inviting him. </text></form>
</translation>
</example>
</sense>
</entry>
