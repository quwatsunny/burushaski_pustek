<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>Intensifier for a slope, straight (up or down), perpendicular etc.  Intensifier for position or direction. straight, complete</text></gloss>
<gloss lang="ur-PK"><text>(حرفِ تاکید) سیدھا، بالکل</text></gloss>
<example>
<form lang="bsk"><text>caṭ ísqa</text></form>
<translation type="Free translation">
