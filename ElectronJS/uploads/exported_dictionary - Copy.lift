<entry dateCreated="2022-05-03T22:56:11Z" dateModified="2025-10-30T13:54:45Z" id="ulle_40854910-b28d-481c-97d0-b079d1296668" guid="40854910-b28d-481c-97d0-b079d1296668">
<lexical-unit>
<form lang="bsk"><text>ulle</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<citation>
<form lang="bsk"><text>ulle</text></form>
</citation>
<note>
<form lang="en"><text>DAT: ulla (to inside), ABL: ullum (from inside), LOC: ulle (inside)</text></form>
</note>
<relation type="Compare" ref="ull_ffd2731e-4fc0-4758-af1f-0f49d2c2fb3e"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>uɫɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اُڵےࣷ</text></form>
</field>
<sense id="a9bcfe49-74f7-42a2-a165-d4ac3f861520" order="0">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>in, inside</text></gloss>
<gloss lang="ur-PK"><text>اندر</text></gloss>
<example>
<form lang="bsk"><text>húk ulle bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The dog is inside. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>húk ulla galī</text></form>
<translation type="Free translation">
<form lang="en"><text>The dog went inside. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>húk ullum duusí. </text></form>
<translation type="Free translation">
<form lang="en"><text>The dog came out from inside. </text></form>
</translation>
</example>
</sense>
<sense id="c0cd7a8c-a36d-4365-b2fe-8385f9390816" order="1">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>in, by means of</text></gloss>
<gloss lang="ur-PK"><text>میں یا کے ذریعے</text></gloss>
<example>
<form lang="bsk"><text>ne bas ulle doro ġa galí</text></form>
<translation type="Free translation">
<form lang="en"><text>He went to work in the bus.</text></form>
</translation>
</example>
<trait name ="semantic-domain-ddp4" value="9.5.1.3 Means"/>
</sense>
</entry>
