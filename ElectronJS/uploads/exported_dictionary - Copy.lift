</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>khɛɛna</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>کھینا</text></form>
</field>
<sense id="20ffefaf-6a66-4278-a481-d105876c9f74" order="0">
<grammatical-info value="Dative (a, ġa)">
</grammatical-info>
<gloss lang="en"><text>at the time of, the the time</text></gloss>
<gloss lang="ur-PK"><text>کے وقت</text></gloss>
<example>
<form lang="bsk"><text>teta paqo ṣic̣ume kheéna diyá. </text></form>
<translation type="Free translation">
<form lang="en"><text>Father came at the time of eating food.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>nenaa bõ kheéna domoya?</text></form>
<translation type="Free translation">
<form lang="en"><text>At what time, the mother came?</text></form>
</translation>
</example>
</sense>
<sense id="9c28a1d2-a612-41ac-8b80-332e1218f8e6" order="1">
<gloss lang="en"><text>during or at the season</text></gloss>
<gloss lang="ur-PK"><text>موسم میں  یا مو سم کے دوران</text></gloss>
<example>
<form lang="bsk"><text>Canaḍa uule bõ kheéna ju duġoyum biyen?</text></form>
<translation type="Free translation">
<form lang="en"><text>In Canada, what time (season) do the apricots ripen?</text></form>
</translation>
</example>
</sense>
</entry>
