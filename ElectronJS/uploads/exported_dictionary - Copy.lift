<relation type="Compare" ref="ce yaćum_bb33375f-f0f6-440f-b00d-a031722125f1"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʈaːnʒo</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ٹانجو</text></form>
</field>
<sense id="73bf867e-214d-4678-a8e0-d707326d3cef" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>collision, encounter, pumping into something</text></gloss>
<gloss lang="ur-PK"><text>ٹکراؤ</text></gloss>
<example>
<form lang="bsk"><text>miyaṭiśu uhan ce ṭanjo dellen. </text></form>
<translation type="Free translation">
<form lang="en"><text>Our heads god pumped into each other. </text></form>
</translation>
</example>
</sense>
