<entry dateCreated="2020-02-26T18:11:22Z" dateModified="2025-10-08T01:12:46Z" id="ṣiṣ_40222dd3-c05e-42a9-a0e4-daefe1fe3eed" guid="40222dd3-c05e-42a9-a0e4-daefe1fe3eed">
<lexical-unit>
<form lang="bsk"><text>ṣiṣ</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="Ŝhee_511561bb-8b37-48a9-af6f-5aec72739fcd"/>
<relation type="Compare" ref="-iṣ or ṣ_b802e5a6-7723-45b7-a488-1951a98cb470"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʂiʂ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ݜِݜ</text></form>
</field>
<sense id="c3f6fc2a-2af1-4500-9b62-3e474a540d77">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>/ṣ/ is a suffix appended to a verb in order to give a sense of permission, approval or recommendation. be eaten, may eat. /ṣi/ is an imperative to eat something of noun class x. </text></gloss>
<gloss lang="ur-PK"><text>کھالے</text></gloss>
<example>
<form lang="bsk"><text>huke guṣiṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>May the dog eat you. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne paqo chor ṣiṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>He must eat the food early. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2021-01-19T01:47:17Z" dateModified="2025-10-14T03:55:57Z" id="ṣiṣar2_967346bc-ddf1-4cfd-91c5-1a17c2be16bf" guid="967346bc-ddf1-4cfd-91c5-1a17c2be16bf">
