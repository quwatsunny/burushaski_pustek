<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>غاࣷ</text></form>
</field>
<sense id="f203573d-507f-486a-98ad-a65e8233ecdc">
<gloss lang="en"><text>to or for  the purpose of. It is a Dative Case suffix used with pronouns or action nouns, signifying motion towards the noun, transfer of action or change of location. /ġa/ is only used with the nouns or pronouns ending with vowels, otherwise only /a/ is  used as Dative Case ending.  khaṭa (khaṭ +a) dálla (dáll+a)  jaġa (ja +ġa), goġa (go +ġa). In some rare cases, ca, ća, lla are also used. Please the suffixes cross=referenced.</text></gloss>
<gloss lang="ur-PK"><text>مفعولی لاحقہ   </text></gloss>
<example>
<form lang="bsk"><text>ja goġa minyás etá.</text></form>
<translation type="Literal translation">
<form lang="en"><text>I told you a story. </text></form>
</translation>
<translation>
<form lang="en"><text>(lit.) I made a story to you. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne bulla ġa gali. </text></form>
<translation type="Free translation">
<form lang="en"><text>He went to (play) polo (game). </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>túll bahaća (baha + ća) galí. </text></form>
<translation type="Free translation">
<form lang="en"><text>The snake went into the hole. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un akholla (akho + lla)/</text></form>
<translation type="Free translation">
<form lang="en"><text>You came (to) here. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>awuśin hiṅ ca diya. </text></form>
<translation type="Free translation">
<form lang="en"><text>The guest came (to) outside (of the house).</text></form>
</translation>
</example>
</sense>
</entry>
