</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>تھمام</text></form>
</field>
<sense id="50a72717-93f4-4200-9ae4-913b94692f41">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>sufficiently, considerable </text></gloss>
<gloss lang="ur-PK"><text>کافی</text></gloss>
<example>
<form lang="bsk"><text>ja amese thamam an doro jaġa etu. </text></form>
<translation type="Free translation">
<form lang="en"><text>My granddaughter did some considerable work. </text></form>
</translation>
</example>
</sense>
</entry>
