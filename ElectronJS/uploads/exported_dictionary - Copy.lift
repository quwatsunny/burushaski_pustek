<entry dateCreated="2023-11-23T03:06:51Z" dateModified="2025-10-08T01:12:46Z" id="śár2_4e4351da-0303-46db-958e-e3e5bbccf3e1" guid="4e4351da-0303-46db-958e-e3e5bbccf3e1">
<lexical-unit>
<form lang="bsk"><text>śár</text></form>
</lexical-unit>
