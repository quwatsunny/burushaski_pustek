<entry dateCreated="2019-09-09T21:12:09Z" dateModified="2025-10-08T01:12:46Z" id="galʰći_35b82cba-85a8-4e33-85d9-a428a4b41221" guid="35b82cba-85a8-4e33-85d9-a428a4b41221">
<lexical-unit>
<form lang="bsk"><text>galʰći</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="galʰt_4a38b96b-57f8-49c7-b63b-c36d19834f2e"/>
<relation type="Compare" ref="yár galʰći_43ac0f4c-b4e7-4fd2-85c2-e305fad19ce4"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>galʰtʃi</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>گلْچیࣷ</text></form>
</field>
<sense id="498dd790-3649-4580-8716-6cf19a924dd9">
<grammatical-info value="Locative (ći, i)">
</grammatical-info>
<gloss lang="en"><text>in number of times, in turns, used with numerals to create multiplicative sense. The word is a contraction of gálʰt and ći (in). </text></gloss>
<gloss lang="ur-PK"><text>دفعہ</text></gloss>
<example>
<form lang="bsk"><text>ja go ġa hek galʰtći senam baa,daa axatiam</text></form>
<translation type="Free translation">
<form lang="en"><text>I have told you once, I would not say it gain.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne alʰto galʰćti (galʰt +ći) akho diya. </text></form>
<translation type="Free translation">
<form lang="en"><text>He came here twice (in two turns)</text></form>
</translation>
</example>
</sense>
</entry>
