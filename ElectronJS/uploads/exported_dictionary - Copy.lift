<trait name="Review 1" value="202512301"/>
<sense id="60651be5-41b3-4109-af5f-2cf2b6a85700">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>intestinal spasm, cramp, strong painful contraction especially in the stomach</text></gloss>
<gloss lang="ur-PK"><text>درد کی ایک لہر جو اچانک اُٹھے خاص کر پیٹ میں، مروڑ</text></gloss>
<example>
<form lang="bsk"><text>ja ás ćaraaṭ aaćum bi</text></form>
<translation type="Free translation">
<form lang="en"><text>My stomach is hurting or I have intestinal spasm. </text></form>
</translation>
</example>
<trait name ="semantic-domain-ddp4" value="2.5.2 Disease"/>
</sense>
</entry>
<entry dateCreated="2020-02-04T22:33:54Z" dateModified="2025-12-31T15:12:52Z" id="ćaraaṭi_205aad1a-41cb-46c8-9d13-dbe80d026744" guid="205aad1a-41cb-46c8-9d13-dbe80d026744">
<lexical-unit>
<form lang="bsk"><text>ćaraaṭi</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>tʃaraːʈi</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چراٹیࣷ</text></form>
</field>
<field type="Plural Suffix">
<form lang="bsk"><text>mo</text></form>
</field>
<sense id="a36b0e66-3752-4b5f-9848-13db5ec6700b">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>(of standing crop field) little portion that can be reaped in one go. Small portion of field or small crop field</text></gloss>
<example>
<form lang="bsk"><text>ja mall nupisaarʰk músca diwusam ba, hek ćaraaṭi án diwaasum bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>I have completed reaping the crop field. Only a little portion has left (to reap). </text></form>
</translation>
</example>
