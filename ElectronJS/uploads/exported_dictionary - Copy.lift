<entry dateCreated="2021-04-04T01:52:19Z" dateModified="2025-10-08T01:12:46Z" id="lloṭo2_ff36f329-23aa-4c34-90f0-2d37245954ab" guid="ff36f329-23aa-4c34-90f0-2d37245954ab">
<lexical-unit>
