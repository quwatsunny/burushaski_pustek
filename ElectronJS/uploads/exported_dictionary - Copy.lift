<entry dateCreated="2019-12-09T16:10:20Z" dateModified="2025-03-19T02:19:50Z" id="jaall et_1463b7ac-d56a-410e-83a2-1cc7fa60f3e5" guid="1463b7ac-d56a-410e-83a2-1cc7fa60f3e5">
<lexical-unit>
<form lang="bsk"><text>jaall et</text></form>
</lexical-unit>
