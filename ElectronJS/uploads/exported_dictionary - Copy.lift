<entry dateCreated="2020-06-01T20:28:39Z" dateModified="2026-01-02T03:13:56Z" id="ćhani_56f815cb-80cb-45c4-a8a8-32dea8056e68" guid="56f815cb-80cb-45c4-a8a8-32dea8056e68">
<lexical-unit>
<form lang="bsk"><text>ćhani</text></form>
</lexical-unit>
