<entry dateCreated="2019-08-30T16:27:29Z" dateModified="2025-10-08T01:12:46Z" id="darak_02ad45d0-9be5-4cbb-88d3-a755a4c768f9" guid="02ad45d0-9be5-4cbb-88d3-a755a4c768f9">
<lexical-unit>
<form lang="bsk"><text>darak</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="bedarak_59c54202-6cad-472c-9ad1-660310c8984e"/>
