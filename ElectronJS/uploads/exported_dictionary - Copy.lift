<trait name="do-not-publish-in" value="Idioms"/>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>تُس ائی دُوسِݜ</text></form>
</field>
<sense id="0325dd89-331e-4edb-b91e-7208aa9df472">
<grammatical-info value="Idiom">
</grammatical-info>
<gloss lang="en"><text>May the grave not (easily) open, even the grave be struggle for (you). A terrible curse</text></gloss>
<gloss lang="ur-PK"><text>قبر بھی اسانی سے نہ کھُلے</text></gloss>
</sense>
</entry>
