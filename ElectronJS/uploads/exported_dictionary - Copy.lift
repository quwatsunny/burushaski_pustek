<form lang="ur-PK"><text>ایࣷچاࣷ</text></form>
</field>
<sense id="2c41c0c2-0db7-4289-b2de-462abf226095">
<gloss lang="en"><text>to do, to carry out, to perform.</text></gloss>
<gloss lang="ur-PK"><text>کرنے کے لیے</text></gloss>
<example>
<form lang="bsk"><text>mo gus bariṅ eća ćáq bu.</text></form>
<translation type="Free translation">
<form lang="en"><text>The lady is ready to speak.</text></form>
</translation>
</example>
</sense>
</entry>
