<trait name="Possessors" value="U-Obligatorily Possessors"/>
<sense id="2ace6fe9-b41d-48c2-aceb-15f0a70990ed">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>along with me, with me, in my support</text></gloss>
<gloss lang="ur-PK"><text>میرے ساتھ</text></gloss>
<example>
<form lang="bsk"><text>ja akaaṭ un ka ẓó. </text></form>
<translation type="Free translation">
<form lang="en"><text>You also come with me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>jaa akaaṭ iskye thum ses bám. </text></form>
<translation type="Free translation">
<form lang="en"><text>With me there were three more people.  </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>khuwe ses ẓaan ja akaaṭ ban. </text></form>
<translation type="Free translation">
<form lang="en"><text>These people are all with me. (in my support)</text></form>
</translation>
</example>
