<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>Playing or entertaining with something</text></gloss>
<gloss lang="ur-PK"><text>کسی چیز کے ساتھ کھیلنا </text></gloss>
</sense>
<sense id="04559f82-b5cb-4ae4-b8a4-93849010ef82" order="1">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>(of adults) having hidden or illicit relationship, playing with women</text></gloss>
<gloss lang="ur-PK"><text>خفیہ تعلق رکھنا۔ </text></gloss>
<example>
<form lang="bsk"><text>ne hir mo gus muiṅga giratastimi, ġaan</text></form>
<translation type="Free translation">
<form lang="en"><text>That man happened to have illicit relationship with the woman (he was playing with her),you see. </text></form>
</translation>
</example>
</sense>
<sense id="2523cbd4-947a-492b-ad19-7d5954202a8d" order="2">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>dancing</text></gloss>
<gloss lang="ur-PK"><text>ناچنا</text></gloss>
<example>
<form lang="bsk"><text>gárulle ses giraśum baan. </text></form>
<translation type="Free translation">
<form lang="en"><text>People are dancing in the wedding. </text></form>
</translation>
</example>
</sense>
</entry>
