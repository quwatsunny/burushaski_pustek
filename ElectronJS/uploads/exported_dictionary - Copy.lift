<form lang="bsk"><text>baʈakuʃi</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بٹاࣷ کُشی </text></form>
</field>
<sense id="5e072e35-4350-47bd-b3a1-7768de399483">
