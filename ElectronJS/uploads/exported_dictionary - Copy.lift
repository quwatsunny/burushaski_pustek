<entry dateCreated="2022-11-19T17:02:27Z" dateModified="2025-10-08T01:12:46Z" id="parʰki1_db20a51e-2012-4753-9e7a-becb1b493536" guid="db20a51e-2012-4753-9e7a-becb1b493536">
<lexical-unit>
<form lang="bsk"><text>parʰki</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>par̥ki</text></form>
</field>
