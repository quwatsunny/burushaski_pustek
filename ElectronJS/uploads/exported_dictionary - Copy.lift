<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>(astrological) setting (of planets )</text></gloss>
<gloss lang="ur-PK"><text>غروب ہونا</text></gloss>
<example>
<form lang="bsk"><text>sa bawuc̣ume kheén</text></form>
<translation type="Free translation">
<form lang="en"><text>The time of sun setting.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>hallanz bawui ka, ṭaaṅ mayimi.</text></form>
<translation type="Free translation">
<form lang="en"><text>It will get dark once the moon sets.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>khīrum án asumuyu biyen, ce bawuyen ka gon c̣aṭ mayimi. </text></form>
<translation type="Free translation">
<form lang="en"><text>Few stars are there, once they set, the day will break. </text></form>
</translation>
</example>
</sense>
</entry>
