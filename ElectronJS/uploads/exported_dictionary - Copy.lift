<entry dateCreated="2022-02-08T05:12:59Z" dateModified="2025-11-11T23:05:07Z" id="-iu1_bc455d7d-b4ab-428c-8fe9-dcdfea84297b" guid="bc455d7d-b4ab-428c-8fe9-dcdfea84297b">
<lexical-unit>
<form lang="bsk"><text>-iu</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<note>
<form lang="en"><text>Ten (bone) and eken (liver) are Possessed nouns, hence pluralized differently. </text></form>
</note>
<relation type="Compare" ref="c̣hiu2_4329a7d0-a1d3-442e-9265-7c2f45af0217"/>
<relation type="Compare" ref="-śku_de866746-5d28-4478-9399-77a01e3ff248"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-iu</text></form>
</field>
<sense id="20136158-45c0-4e15-8cb8-afe09d1dd020">
<grammatical-info value="Noun">
<trait name="type" value="inflAffix"/>
</grammatical-info>
<gloss lang="en"><text>Plural suffix  used with one syllabled, non-possessed nouns of x-class , mostly ending with /en/</text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو بعض اسموں کو جمع بناتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>khen, khiu</text></form>
<translation type="Free translation">
<form lang="en"><text>fleas</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>c̣hen &gt; c̣hiu</text></form>
<translation type="Free translation">
<form lang="en"><text>sparrow, sparrows</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ten, tenjo</text></form>
<translation type="Free translation">
<form lang="en"><text>bone, bones</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>eken, ekeniṅ</text></form>
<translation type="Free translation">
<form lang="en"><text>liver, livers</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2021-01-22T07:04:36Z" dateModified="2025-11-11T16:04:50Z" id="-iu2_40845d1e-7d56-4c14-a96a-ae2460d2a68d" guid="40845d1e-7d56-4c14-a96a-ae2460d2a68d">
<lexical-unit>
<form lang="bsk"><text>-iu</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<relation type="Compare" ref="-mo_7c4105ab-22eb-4262-bfb7-2d477fad65a9"/>
