</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>یر نیسی ڎھیࣷریࣷم</text></form>
</field>
<sense id="4b59e354-d231-472b-b579-9f7327e55f1e" order="0">
<gloss lang="en"><text>keep going, continuing progress</text></gloss>
<gloss lang="ur-PK"><text>ترقی کرتے رہنا۔ اگے بڑھتے جانا۔ </text></gloss>
<example>
<form lang="bsk"><text>Yásiniiću yár nisi cheremen.</text></form>
<translation type="Free translation">
<form lang="en"><text>The people of Yásin will keep progressing. </text></form>
</translation>
</example>
</sense>
<sense id="2f8decbc-1f1c-4824-bfe9-a9f3edf1bbfa" order="1">
<gloss lang="en"><text>keep proceeding</text></gloss>
<gloss lang="ur-PK"><text>آگے بڑھتے رہنا</text></gloss>
</sense>
</entry>
<entry dateCreated="2019-05-01T05:33:13Z" dateModified="2025-10-28T01:12:50Z" id="yar se_e9525e1d-2723-4ea5-96f2-94e015f3ed31" guid="e9525e1d-2723-4ea5-96f2-94e015f3ed31">
