<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>make 3SG.hm.x in the word, advice etc.</text></gloss>
<gloss lang="ur-PK"><text>پیروی کروا لو۔ </text></gloss>
<example>
