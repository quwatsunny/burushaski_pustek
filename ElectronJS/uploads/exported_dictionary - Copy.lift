<sense id="4bdccec7-a2eb-4b4b-92ad-987df2d1ecbc">
<grammatical-info value="Dative (a, ġa)">
</grammatical-info>
<gloss lang="en"><text>for, to or into a skin or hide</text></gloss>
<gloss lang="ur-PK"><text>چمڑی کے لیے یا چمڑی  میں</text></gloss>
<example>
