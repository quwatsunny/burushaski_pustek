</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The plural suffix for the adjective is determined by the class of noun. If the noun class is x, the plural suffix will be /mo/, if the class of noun is Y, the plural suffix will be /iṅ/</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>baxmali, baxmal</text></form>
</field>
