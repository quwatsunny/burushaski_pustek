</example>
<example>
<translation type="Free translation">
</translation>
</example>
<example>
<form lang="bsk"><text>khene hir phaiṅ aietas hir en bai.</text></form>
<translation type="Free translation">
<form lang="en"><text>This man over here, is not some man who (usually) lies.  </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-11-03T17:38:41Z" dateModified="2025-11-13T02:43:54Z" id="aietiṅ_7627e6bc-3305-41c0-aa10-a9e537f0e5ce" guid="7627e6bc-3305-41c0-aa10-a9e537f0e5ce">
