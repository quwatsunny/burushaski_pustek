<entry dateCreated="2020-05-18T23:15:29Z" dateModified="2025-10-08T01:12:46Z" id="déwaqall_4cf5dfdb-787a-40ed-a359-4a92e391f736" guid="4cf5dfdb-787a-40ed-a359-4a92e391f736">
<lexical-unit>
<form lang="bsk"><text>déwaqall</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>dɛwaqaɫ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دیࣷوقڵ</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>waqall</text></form>
</field>
<trait name="Possessors" value="O-Obligatorily Possessors"/>
<sense id="5aa9a565-4c16-4a80-8f15-208a0dea22bc">
<gloss lang="en"><text>by him, by someone. It is used in a causative speech where something is done through an agent(grammatical).  </text></gloss>
<gloss lang="ur-PK"><text>کے ذریعے</text></gloss>
<example>
<form lang="bsk"><text>ne déwaqall gute eégirmin. </text></form>
<translation type="Free translation">
<form lang="en"><text>Have him write this. Get him write this. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja dawaqall gukhar dell be.</text></form>
<translation type="Free translation">
<form lang="en"><text>Do not get yourself beat by me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ses dowaqall gukhar ce ġase be.</text></form>
<translation type="Free translation">
<form lang="en"><text>Do not make people laugh at you. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mi demewaqall doro ameet.</text></form>
<translation type="Free translation">
<form lang="en"><text>Do not get the work done by us. </text></form>
</translation>
</example>
</sense>
</entry>
