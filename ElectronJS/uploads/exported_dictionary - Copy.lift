<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>dɛɛpʰɛrkani</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دے پھرکنیࣷ</text></form>
</field>
<sense id="44c7c401-49b7-4399-becb-6bbe4b3521cf">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>3SG.mx tripped over something</text></gloss>
<gloss lang="ur-PK"><text>اُس کو ٹھوکر لگی</text></gloss>
<example>
<form lang="bsk"><text>ne hir dan ce deépherkani. </text></form>
<translation type="Free translation">
<form lang="en"><text>That man tripped on a stone. </text></form>
</translation>
</example>
</sense>
</entry>
