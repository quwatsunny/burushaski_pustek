<gloss lang="ur-PK"><text>ٹُھونسا ہوا </text></gloss>
<example>
<form lang="bsk"><text>gómeṣ guxaća ya c̣uk bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>Your finger is always stuffed into your mouth itself. </text></form>
</translation>
</example>
</sense>
</entry>
