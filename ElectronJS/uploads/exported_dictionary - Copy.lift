<entry dateCreated="2020-04-14T04:06:17Z" dateModified="2025-10-08T01:12:46Z" id="śarʰphat_ebbfa751-68da-48f4-b256-830c2754cbc4" guid="ebbfa751-68da-48f4-b256-830c2754cbc4">
