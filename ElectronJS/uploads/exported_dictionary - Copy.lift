</field>
<sense id="21fc2990-a155-437e-9352-7a3f52415295">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>sky, space</text></gloss>
<gloss lang="ur-PK"><text>آسمان، خلا</text></gloss>
<example>
<form lang="bsk"><text>diyarʰci boo, ayaś gallum bi. </text></form>
<translation type="Free translation">
