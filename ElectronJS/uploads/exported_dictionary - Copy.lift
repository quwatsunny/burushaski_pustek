<sense id="27fb284f-5da6-4901-9642-2f82758a4f89" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>gap, aperture,  hole, a wide opening</text></gloss>
<gloss lang="ur-PK"><text>سوراخ یا خالی جگہ جو کسی  چیز کے ہٹنے سے بنا ہو۔ </text></gloss>
<example>
<form lang="bsk"><text>te phat haa hiṅ apí, ballbana aṅan dellum ban</text></form>
<translation type="Free translation">
<form lang="en"><text>That abandoned house has no door, to the opening, they have put a hedge.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>te ballbana loq án della, tayii ajó tiś diya.</text></form>
<translation type="Free translation">
<form lang="en"><text>Could you please put some rag in the hole, some strong wind came through that way (hole).</text></form>
</translation>
</example>
</sense>
