<entry dateCreated="2020-02-28T16:38:30Z" dateModified="2025-10-08T01:12:46Z" id="etum2_d9197a15-701b-45e7-9f60-cdd5dc6f7edb" guid="d9197a15-701b-45e7-9f60-cdd5dc6f7edb">
<lexical-unit>
<form lang="bsk"><text>etum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
