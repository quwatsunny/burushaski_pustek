<gloss lang="en"><text>whom</text></gloss>
<gloss lang="ur-PK"><text>کس کو، کس سے</text></gloss>
<example>
<form lang="bsk"><text>ja men deġareśam?</text></form>
<translation type="Free translation">
<form lang="en"><text>Whom should I ask?</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2021-06-29T00:55:19Z" dateModified="2025-10-08T01:12:46Z" id="men1_5fecb4da-54c1-4511-a5b5-111a81c4111d" guid="5fecb4da-54c1-4511-a5b5-111a81c4111d">
