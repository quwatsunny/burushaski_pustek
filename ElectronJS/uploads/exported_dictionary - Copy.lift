<entry dateCreated="2019-03-18T02:51:06Z" dateModified="2025-11-21T15:39:15Z" id="apai_8669fba5-e3f0-4a4b-bd0e-eac3f80502ed" guid="8669fba5-e3f0-4a4b-bd0e-eac3f80502ed">
<lexical-unit>
<form lang="bsk"><text>apái</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>

- bai → copula verb “is” (3rd singular form). 
- a- → negative prefix. 
- abai → “is not” (negative copula). 
- apai → devoiced variant of abai (phonologically conditioned allomorph).</text></form>
</note>
<relation type="Compare" ref="api_4a0a8d50-2f3c-44d6-ad7a-6a102d48f1f4"/>
<relation type="Compare" ref="a-2_8d8ad6c1-41d8-49c8-af58-3cb3cd506be3"/>
<relation type="Compare" ref="bái1_1220cff0-7e17-42c7-b1fe-3d376889527f"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>apʌi</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اپاۡئ</text></form>
</field>
<sense id="3bf3206e-10a8-4dfb-824f-d46e74ca7c4a">
<grammatical-info value="copula verb">
</grammatical-info>
<gloss lang="en"><text>is not (3SG.hm), devoiced form (a.bai)</text></gloss>
<gloss lang="ur-PK"><text>نہیں ہے ، مرد کے حوالے سے استعمال ہوتا ہے ۔ </text></gloss>
<example>
<form lang="bsk"><text>ne akho apái (a + bai)</text></form>
<translation type="Free translation">
<form lang="en"><text>He is not here. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne lahaz  apái. </text></form>
<translation type="Free translation">
<form lang="en"><text>He is not sick.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-01-13T23:50:55Z" dateModified="2025-11-21T15:48:31Z" id="ápai_46dad038-9759-419a-a2d3-f8755195e97e" guid="46dad038-9759-419a-a2d3-f8755195e97e">
<lexical-unit>
<form lang="bsk"><text>ápai</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>a.pa.i (a→ Proximal prefix, pa → side, i→ Locative suffix). Thus the word means in the proximity of my side.</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʌpai</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اپَئ</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>pai</text></form>
</field>
<trait name="Possessors" value="O-Obligatorily Possessors"/>
<sense id="2c44e85d-d91b-4b1b-8374-3c50c710422d" order="0">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>near me</text></gloss>
<gloss lang="ur-PK"><text>میرے  نزدیک</text></gloss>
</sense>
<sense id="12fee921-eb0e-450c-b545-a27c541f5722" order="1">
<grammatical-info value="Postposition">
</grammatical-info>
<gloss lang="en"><text>with me or me having</text></gloss>
<gloss lang="ur-PK"><text>میر ے پاس</text></gloss>
<example>
<form lang="bsk"><text>ja ápai hún bica. </text></form>
<translation type="Free translation">
<form lang="en"><text>I have wood. Woods are with me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un ápaya ẓo. </text></form>
<translation type="Free translation">
<form lang="en"><text>You come to me. You come nearer to me. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-08-01T22:41:31Z" dateModified="2025-11-21T15:49:10Z" id="apám1_a0d93626-81df-4100-b839-270745f324ca" guid="a0d93626-81df-4100-b839-270745f324ca">
