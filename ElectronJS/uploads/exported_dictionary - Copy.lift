<sense id="25b2d6b7-5a33-4105-b998-5060efcef9ee">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>dazzled, overwhelmed by light</text></gloss>
<gloss lang="ur-PK"><text>جو چُندھیاگیا ہو</text></gloss>
<example>
<form lang="bsk"><text>se hallanz yakalla buṭ ġaana ka ataśí goćimi </text></form>
<translation type="Free translation">
<form lang="en"><text>If you look at the moon too much, it will make you dazzled.</text></form>
</translation>
</example>
</sense>
</entry>
