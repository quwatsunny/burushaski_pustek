<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>A Buruśaaski unit of measurement equal to the length of 12 tip-cat sticks ( 24 feet in total)</text></gloss>
<gloss lang="ur-PK"><text> ۲۴فٹ لمبا</text></gloss>
</sense>
</entry>
