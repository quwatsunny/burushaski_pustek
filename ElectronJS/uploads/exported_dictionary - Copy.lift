<entry dateCreated="2019-09-26T15:52:16Z" dateModified="2025-10-08T01:12:46Z" id="śallda2_68bd6f88-b965-45cb-960a-fcb338da8a49" guid="68bd6f88-b965-45cb-960a-fcb338da8a49">
<lexical-unit>
<form lang="bsk"><text>śallda</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="sát1_f79e4caa-ed4a-43a6-8ac0-9cc6c5dbcc70"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʃaɫda</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>شلٚدہ</text></form>
</field>
<sense id="18e424ed-ca89-4e11-bdb6-6dad1e2fb726">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>when you ask someone to do (instead of doing yourself)</text></gloss>
<gloss lang="ur-PK"><text>کسی کو کرنے کے لیے کہنا، کام کسی اور پر ڈالنا۔</text></gloss>
<example>
<form lang="bsk"><text>má hene hena śallda net, doro mene ka ayeten. </text></form>
<translation type="Free translation">
<form lang="en"><text>You (plural) kept asking each other (to do) and nobody did the work. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-26T04:37:46Z" dateModified="2025-10-08T01:12:46Z" id="śallda1_077a33dc-3799-436a-8fe4-d2a99966b788" guid="077a33dc-3799-436a-8fe4-d2a99966b788">
