<entry dateCreated="2019-09-09T12:20:09Z" dateModified="2025-10-08T01:12:46Z" id="phaṭarʰćum_48c53494-c53a-451a-b389-2c9a4454c2b2" guid="48c53494-c53a-451a-b389-2c9a4454c2b2">
<lexical-unit>
<form lang="bsk"><text>phaṭarʰćum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>pʰaʈar̥tʃum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>پھٹرْچُم</text></form>
</field>
<sense id="e7e6d8f0-34f7-4455-a4ad-f5f73a04b3fc" order="0">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>flaying</text></gloss>
<gloss lang="ur-PK"><text>چمڑی اُتارنا</text></gloss>
<example>
<form lang="bsk"><text>ne cigir phaṭari</text></form>
<translation type="Free translation">
<form lang="en"><text>He flayed the skin of the goat.</text></form>
</translation>
</example>
</sense>
<sense id="2d60604b-09c7-4f40-a815-0e084a156916" order="1">
<gloss lang="en"><text>hulling or removing husk</text></gloss>
<gloss lang="ur-PK"><text>مکئی  وغیرہ کے چھلکے اُتارنا</text></gloss>
</sense>
<sense id="850badd2-01c4-4005-bd94-a6a300de12d2" order="2">
<gloss lang="en"><text>inflicting severe punishment</text></gloss>
<gloss lang="ur-PK"><text>سخت سزادینا یا سزا دینے کی دھمکی </text></gloss>
<example>
<form lang="bsk"><text>bape guyeci ka aparʰciki guphaterćimi.</text></form>
<translation type="Free translation">
<form lang="en"><text>If the grandpa sees you (doing something bad), he will flay you reversely.(He will give you a severe punishment)</text></form>
</translation>
</example>
</sense>
<sense id="9b0d56e3-291b-4322-aff5-fdc2856087d7" order="3">
<gloss lang="en"><text>peeling (skin) off</text></gloss>
<gloss lang="ur-PK"><text>چھلکا یا خول چھیل لینا</text></gloss>
<example>
<form lang="bsk"><text>Ja aalu phaṭerʰćam.</text></form>
<translation type="Free translation">
<form lang="en"><text>I will peel the potato.</text></form>
<form lang="ur-PK"><text>میں آلو کا چھلکا اُتاروں گا۔</text></form>
</translation>
</example>
</sense>
</entry>
