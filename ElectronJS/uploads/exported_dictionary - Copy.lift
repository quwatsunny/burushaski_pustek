<entry dateCreated="2022-02-20T05:05:19Z" dateModified="2025-12-27T02:15:24Z" id="c̣uṅgu_555704bb-a7f5-4f2d-87bb-6f6dfa00c06c" guid="555704bb-a7f5-4f2d-87bb-6f6dfa00c06c">
