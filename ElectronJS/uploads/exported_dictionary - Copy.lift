<gloss lang="en"><text>move forward</text></gloss>
<gloss lang="ur-PK"><text>آگے ہو یا آگے بڑھو۔</text></gloss>
<example>
<form lang="bsk"><text>un phuk an yár se ka ja ka huruśam. </text></form>
<translation type="Free translation">
<form lang="en"><text>You move forward a little bit so that I can sit as well. </text></form>
</translation>
</example>
</sense>
<sense id="aee76be3-00a0-4449-9c81-13235e605f81" order="1">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>progress, proceed</text></gloss>
<gloss lang="ur-PK"><text>ترقی کر</text></gloss>
<example>
<form lang="bsk"><text>un yár se, mi ka dall diyaśćan. </text></form>
<translation type="Free translation">
<form lang="en"><text>You progress and we will go up too. (develop)</text></form>
</translation>
</example>
</sense>
</entry>
