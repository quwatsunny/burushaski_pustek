</field>
<sense id="4f434271-bffd-44c5-a40c-a1170b5a4d68">
<gloss lang="en"><text>hang on, wait for a moment</text></gloss>
<gloss lang="ur-PK"><text>زرہ   رُکئے۔ ذرہ خاموشی سے بیٹھے </text></gloss>
<example>
<form lang="bsk"><text>ćup et ka, ja ne ġa siyam.</text></form>
<translation type="Free translation">
<form lang="en"><text>If you could hang on, I will tell him.</text></form>
</translation>
</example>
</sense>
</entry>
