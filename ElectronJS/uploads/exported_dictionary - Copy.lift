<entry dateCreated="2021-04-23T01:36:15Z" dateModified="2025-12-03T03:48:40Z" id="-ast_e438277b-3fa7-4e8a-b199-efc24f40ac07" guid="e438277b-3fa7-4e8a-b199-efc24f40ac07">
<lexical-unit>
<form lang="bsk"><text>-ast_-</text></form>
</lexical-unit>
<trait  name="morph-type" value="infix"/>
<relation type="Compare" ref="mu1_7be8b31f-ad2f-4932-93d2-9e941773be90"/>
<relation type="Compare" ref="ám_91021efe-ec87-4ac8-ab98-ec892796fe00"/>
<relation type="Compare" ref="bastemen_cb5f3ea5-c501-4b6f-b5de-ccb03c8e0901"/>
<relation type="Compare" ref="men4_91a97138-6308-4e4e-b56a-8102c1576ba4"/>
<relation type="Compare" ref="mi1_c2451b3a-b691-4e06-bed0-fc2aad9b13f8"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-ast_-</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>-است-</text></form>
</field>
<sense id="4980015e-1884-45d8-bd0e-cd3b270109fa" order="0">
<gloss lang="en"><text>affix used to form a Quotative or Dubitative, always used with an Auxiliary followed by Past suffix.  </text></gloss>
<example>
<form lang="bsk"><text>ne hir baastimi</text></form>
<translation type="Free translation">
<form lang="en"><text>He happens to be a man. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus nem buastumu</text></form>
<translation type="Free translation">
<form lang="en"><text>Reportedly the woman has gone.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>we ses too bastmen</text></form>
<translation type="Free translation">
<form lang="en"><text>Those people reportedly were there. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>beliśu yurum biyenaastemen</text></form>
<translation type="Free translation">
<form lang="en"><text>Reportedly the sheep were dead. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>hen hir én baastimi, daa nee hen ye en baastimi.</text></form>
<translation type="Free translation">
<form lang="en"><text>There happens to be a man, and he happens to have a son. </text></form>
</translation>
</example>
</sense>
<sense id="5274e578-590e-4171-a605-45dcd16a2f56" order="1">
