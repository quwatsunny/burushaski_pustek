<entry dateCreated="2019-02-26T21:01:03Z" dateModified="2025-11-03T03:16:27Z" id="étt_60304497-dab2-43e5-8696-8be2db986e51" guid="60304497-dab2-43e5-8696-8be2db986e51">
<lexical-unit>
<form lang="bsk"><text>et</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>/et/ is always used in Active voice.  For Passive voice the morpheme /man-/ is used. See the examples above for both. </text></form>
</note>
<relation type="Compare" ref="phátí_dbf8e292-4b1b-4147-8752-addd94389046"/>
<relation type="Compare" ref="mani_116bc331-d9cb-423c-8fa6-c7496b03c381"/>
<relation type="Compare" ref="ećam_65498b10-d9a2-4cb3-b17b-70dcb43af963"/>
<relation type="Compare" ref="áta_e8bb2c17-1388-444f-affc-c242300e4b74"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛt</text></form>
</field>
<trait name="Past Participle" value="Past Participial"/>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ایࣷت</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>-t-</text></form>
</field>
<trait name="Possessors" value="O-Obligatorily Possessors"/>
<sense id="04487eda-c97a-458e-8bcb-4c41098e354f">
<gloss lang="en"><text>do or make</text></gloss>
<gloss lang="ur-PK"><text>کرو</text></gloss>
<example>
<form lang="bsk"><text>un doro eta.</text></form>
<translation type="Free translation">
<form lang="en"><text>You did the work.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>doro mani. </text></form>
<translation type="Free translation">
<form lang="en"><text>The work was done. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ġariṅ et.</text></form>
<translation type="Free translation">
<form lang="en"><text>Sing (make a song).</text></form>
</translation>
</example>
<trait name ="semantic-domain-ddp4" value="7 Physical actions"/>
</sense>
</entry>
<entry dateCreated="2025-11-03T03:08:39Z" dateModified="2025-11-03T03:15:23Z" id="et et_b5591085-dbad-4b34-b354-0377967a2bf1" guid="b5591085-dbad-4b34-b354-0377967a2bf1">
