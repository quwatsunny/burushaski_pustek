<translation type="Free translation">
<form lang="en"><text>The cow will go out. </text></form>
</translation>
</example>
</sense>
<sense id="26a4f3db-941b-4851-a65f-7ab803e00b85" order="1">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>will pass by</text></gloss>
<gloss lang="ur-PK"><text>گزر جائے گا/گی</text></gloss>
<example>
<form lang="bsk"><text>goo denukuśi gukye doroiṅ ulle cheremi. </text></form>
<translation type="Free translation">
<form lang="en"><text>Your age will pass by in such tasks. </text></form>
</translation>
</example>
</sense>
</entry>
