</field>
<sense id="004beaa4-6d71-49ef-be78-5c462d38e03f" order="0">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>2SG.near, near you</text></gloss>
<gloss lang="ur-PK"><text>آپ کے پاس۔ </text></gloss>
<example>
<form lang="bsk"><text>gopaći han bar an desac̣am, mena ġeen ayet.</text></form>
<translation type="Free translation">
<form lang="en"><text>I will mention a matter near you, do not disclose it to anyone.</text></form>
</translation>
</example>
</sense>
