</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="ek_808ff1ff-bb11-44d8-bce1-3cc0d8100d0f"/>
<relation type="Compare" ref="booten_664f0fe7-379c-493e-982d-5731e7a9bc62"/>
<relation type="Compare" ref="an_f40eb149-6cfa-46ea-821a-3e6402c2237e"/>
<relation type="Compare" ref="botén_85dbd275-6624-47b7-866a-dc5fa828fcc4"/>
<relation type="Compare" ref="bootán1_e17990e1-8169-45ff-8225-f552d7e4328a"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ایࣷن</text></form>
</field>
<sense id="94492533-40aa-41f6-9922-d24f5ac33eef">
<grammatical-info value="Indefinite article">
</grammatical-info>
<gloss lang="en"><text>With the meaning of 'some', it is used as an Indefinite with humans or human roles, representing singularity. </text></gloss>
<gloss lang="ur-PK"><text>ایک، کوئی ایک</text></gloss>
<example>
<form lang="bsk"><text>hen hir en bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>There was  a/some man. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>Hen thám en bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>There was a king.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>hen gus en bum. </text></form>
<translation type="Free translation">
<form lang="en"><text>There was a lady. </text></form>
</translation>
</example>
</sense>
</entry>
