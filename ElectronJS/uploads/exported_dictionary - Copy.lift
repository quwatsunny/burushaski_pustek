<form lang="ur-PK"><text>کولٚوࣷ کہ</text></form>
</field>
<sense id="ffb01ec8-c7a9-49d0-84df-4992288b8f66">
<gloss lang="en"><text>even as, even if</text></gloss>
<gloss lang="ur-PK"><text>بھی تو</text></gloss>
<example>
<form lang="bsk"><text>hek phaiṅ etum ba, amutuk chan sena kollo ka, go guyaṭe jaa bawaar api</text></form>
<translation type="Free translation">
<form lang="en"><text>You have lied once, now even if you tell the truth, I do not have any belief (on or in you)</text></form>
</translation>
</example>
</sense>
</entry>
