<entry dateCreated="2024-08-06T02:11:24Z" dateModified="2025-10-08T01:12:46Z" id="-um4_f5efd44d-4671-4b09-b588-5e62a9813df5" guid="f5efd44d-4671-4b09-b588-5e62a9813df5">
<lexical-unit>
<form lang="bsk"><text>-um</text></form>
</lexical-unit>
