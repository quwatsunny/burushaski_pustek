<sense id="b8974126-182f-4921-8dfe-3c359a36253d">
<grammatical-info value="Interjection">
</grammatical-info>
<gloss lang="en"><text>right then, OK </text></gloss>
<gloss lang="ur-PK"><text>اچھا، اچھا تو یہ بات ہے۔</text></gloss>
