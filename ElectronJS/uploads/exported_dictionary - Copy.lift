<sense id="38ae2fb7-4a0a-41d2-9bda-bf63c597f6f5">
<grammatical-info value="Postpositional Phrase">
</grammatical-info>
<gloss lang="en"><text>from 3PL.x, than 3PL.x</text></gloss>
<gloss lang="ur-PK"><text>(کلاس ایکس، جمع) سے</text></gloss>
<example>
<form lang="bsk"><text>ceé cum, guce śuwa biyen. </text></form>
<translation type="Free translation">
<form lang="en"><text>From those (3PL.x), these are better. </text></form>
</translation>
