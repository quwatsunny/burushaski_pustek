</translation>
</example>
</sense>
</entry>
<entry dateCreated="2021-02-22T00:22:16Z" dateModified="2025-11-08T03:19:34Z" id="till amaaliṅ_4366a433-76f9-4cdf-8ec2-f5796f422283" guid="4366a433-76f9-4cdf-8ec2-f5796f422283">
<lexical-unit>
<form lang="bsk"><text>till amaliṅ</text></form>
</lexical-unit>
