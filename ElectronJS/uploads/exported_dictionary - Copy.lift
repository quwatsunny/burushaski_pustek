<sense id="b668dc64-0918-4633-b5a1-25902a21d1cd">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>taking up (time, space etc)</text></gloss>
<gloss lang="ur-PK"><text>لینا (جگہ، وقت وغیرہ)</text></gloss>
<example>
<form lang="bsk"><text>amutuk ja bariṅ ećam, un buṭ kheen yaná. </text></form>
<translation type="Free translation">
<form lang="en"><text>Now I will talk, you have taken up too much time. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-20T16:28:42Z" dateModified="2025-10-08T01:12:46Z" id="yayum2_45814756-efb8-42f0-bf5d-a6fb1bdf9ba9" guid="45814756-efb8-42f0-bf5d-a6fb1bdf9ba9">
