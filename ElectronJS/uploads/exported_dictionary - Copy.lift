<sense id="9890225c-eb08-4d42-b35e-4a02f9ae2090">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>depth-wise split of sheet or slab.</text></gloss>
<gloss lang="ur-PK"><text>پتھر کی سیل وغیرہ کی چیریا شَقّ   </text></gloss>
<example>
<form lang="bsk"><text>bát ṣu dius</text></form>
<translation type="Free translation">
<form lang="en"><text>Split the stone-slab into sheets (two or more)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja dan ṣu diwusa,. </text></form>
<translation type="Free translation">
<form lang="en"><text>I split the stone (into slabs). </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>dan ṣu duusi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The stone got split. </text></form>
</translation>
</example>
</sense>
</entry>
