<entry dateCreated="2019-10-02T13:32:16Z" dateModified="2025-10-28T01:01:58Z" id="yár manum_607afe89-d36b-47c8-a35e-350fa866ef1f" guid="607afe89-d36b-47c8-a35e-350fa866ef1f">
<lexical-unit>
<form lang="bsk"><text>yár manum</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>yʌr manum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>یر منُم</text></form>
</field>
<sense id="6193dafc-93f4-44dc-99c5-3437ad57e44c" order="0">
<gloss lang="en"><text>event or task previously happened, precedented</text></gloss>
<gloss lang="ur-PK"><text>وہ کا م جو پہلے ہو چکا ہے۔</text></gloss>
<example>
<form lang="bsk"><text>gute bo akheṣ doro api, gute yar manum doro duwa.</text></form>
<translation type="Free translation">
<form lang="en"><text>This is not something unique, this has happened before. </text></form>
</translation>
</example>
</sense>
<sense id="4c716f87-7e76-4914-8da3-ede93ab2f924" order="1">
<gloss lang="en"><text>the one who has gotten ahead or in front, the one who is leading</text></gloss>
<gloss lang="ur-PK"><text>وہ جو آگے ہو چکا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>tati yár manum bai, ye iilji bai. </text></form>
<translation type="Free translation">
<form lang="en"><text>The father is leading and the son is behind him. </text></form>
</translation>
</example>
</sense>
</entry>
