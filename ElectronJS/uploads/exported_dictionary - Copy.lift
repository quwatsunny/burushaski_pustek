</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʈʂuːʈʂaɫu</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>څُوڅلُٚو</text></form>
</field>
<sense id="8f3eb9b6-51e9-4919-bed9-2787b2e4bbc0">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>jumble, chaotic arrangement</text></gloss>
<gloss lang="ur-PK"><text>بے ترتیب، جیسے سر پیز کا پتہ نہ ہو۔</text></gloss>
<example>
<form lang="bsk"><text>hún waarʰca net uhan yaṭa oos, c̣uuc̣allu ayet. </text></form>
<translation type="Free translation">
<form lang="en"><text>Stack the pieces of wood neatly on top of one another—don’t leave them in a jumble.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-12-16T17:42:27Z" dateModified="2025-12-27T02:00:19Z" id="c̣ux _937e8418-c36e-4a55-b13c-a586568f2988" guid="937e8418-c36e-4a55-b13c-a586568f2988">
