<entry dateCreated="2019-05-17T18:17:05Z" dateModified="2025-10-08T01:12:46Z" id="kollo_6b7ed7e6-7e43-43ef-8e09-0ad778b8de1f" guid="6b7ed7e6-7e43-43ef-8e09-0ad778b8de1f">
<lexical-unit>
<form lang="bsk"><text>kollo</text></form>
</lexical-unit>
