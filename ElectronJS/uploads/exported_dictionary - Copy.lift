</field>
<sense id="a3d562f0-3194-4352-9868-01ade0364080">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>companion, supporter, team player</text></gloss>
<gloss lang="ur-PK"><text>ساتھ دینے والا، ساتھ چلنے والا</text></gloss>
<example>
<form lang="bsk"><text>un jaġa yaar guwan ka gukye hún chućan.  </text></form>
<translation type="Free translation">
<form lang="en"><text>Be my support so that we will carry these wood. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>thawus <span lang="en">x</span>aṣ ne báp jaġa yar mani, tollum khaṭa aġanic gallá. </text></form>
