<sense id="1bc618ad-099e-4597-b2a6-218502acd4a3">
<grammatical-info value="Pronoun">
</grammatical-info>
<gloss lang="en"><text>cataphoric pronominal filler, temporarily used before a forgotten or intentionally delayed noun, noun phrase or a complete statement. </text></gloss>
<example>
<form lang="bsk"><text>ne os seni --ja aichuram ba seni. </text></form>
<translation type="Free translation">
<form lang="en"><text>He said, what was that he said – he said, "I am not coming.”</text></form>
</translation>
</example>
</sense>
</entry>
