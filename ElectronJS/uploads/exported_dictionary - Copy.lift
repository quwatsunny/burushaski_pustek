</field>
<sense id="1104b728-4203-4d9f-88d8-968bec071bc9">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>custody, guardianship, control</text></gloss>
<gloss lang="ur-PK"><text>حراست</text></gloss>
<example>
<form lang="bsk"><text>ne yaġi hir, hokmate dasta ći bai. </text></form>
