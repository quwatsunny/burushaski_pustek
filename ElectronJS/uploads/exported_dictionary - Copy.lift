<entry dateCreated="2022-11-26T05:15:55Z" dateModified="2025-10-08T01:12:46Z" id="heẽ_b30a2840-9e81-453f-a45b-aa4aba65bb69" guid="b30a2840-9e81-453f-a45b-aa4aba65bb69">
<lexical-unit>
<form lang="bsk"><text>heẽ</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>hɛɛ̃</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ہیں</text></form>
</field>
<sense id="f483e70e-8d1c-4606-b7b3-d11fa40cf7fc" order="0">
<grammatical-info value="Exclamation">
</grammatical-info>
<gloss lang="en"><text>there you go (I told you)</text></gloss>
<gloss lang="ur-PK"><text>دیکھا۔</text></gloss>
<example>
<form lang="bsk"><text>heẽ! goġa sena beé, guwalʰćum ba noxa. </text></form>
<translation type="Free translation">
<form lang="en"><text>There you go! Didn't I tell you that you were going to fall?</text></form>
</translation>
<translation>
</translation>
</example>
<example>
<form lang="bsk"><text>heẽ<span lang="en">, yeca beé, bar aiyana ka tai guwayuma. </span></text></form>
<translation type="Free translation">
<form lang="en"><text><span lang="bsk">See? There you go—that's what happens when you don't listen!</span></text></form>
</translation>
</example>
</sense>
<sense id="458d082b-a455-4778-a14b-25cef1dde5f8" order="1">
<grammatical-info value="Exclamation">
</grammatical-info>
<gloss lang="en"><text>Pausal expression to recollect something</text></gloss>
<example>
<form lang="bsk"><text>ja go ġa bo siyam, heẽ, ses akho churum ban, cherem baan. </text></form>
<translation type="Free translation">
<form lang="en"><text>What do I tell you, [Pausal Expression], people come here and go.</text></form>
</translation>
</example>
</sense>
</entry>
