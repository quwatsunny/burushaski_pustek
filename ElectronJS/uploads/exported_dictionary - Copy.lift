</field>
<sense id="9c679d24-43d5-41b8-b1a1-a898b886cf05" order="0">
<gloss lang="en"><text>swift move to lift up</text></gloss>
<gloss lang="ur-PK"><text>جٹ سے اُٹھنا۔ </text></gloss>
<example>
<form lang="bsk"><text>ja ne cum thuwek ḍáz dall etá. </text></form>
<translation type="Free translation">
<form lang="en"><text>I swiftly grabbed the gun from him. </text></form>
</translation>
</example>
</sense>
<sense id="cf892d12-d6bc-4199-a09b-cbc33ac0d718" order="1">
<gloss lang="en"><text>swift take off</text></gloss>
<gloss lang="ur-PK"><text>جٹ سے ہوا میں اُڑان</text></gloss>
<example>
<form lang="bsk"><text>ne chera ġa aqareśum bai ka, ḍáz dehuten chú. </text></form>
<translation type="Free translation">
<form lang="en"><text>If he refuses to go, just lift him up and take him. </text></form>
</translation>
</example>
</sense>
</entry>
