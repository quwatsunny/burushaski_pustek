<entry dateCreated="2019-05-11T16:14:53Z" dateModified="2025-10-08T01:12:46Z" id="kaaman_723c5c0e-bf57-4bd2-a2d0-5433be732ae9" guid="723c5c0e-bf57-4bd2-a2d0-5433be732ae9">
<lexical-unit>
<form lang="bsk"><text>kaaman</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The length of the vowels influences the meaning in terms of quantity or amount. Thus, 'kaaman' could also appear with a short vowel, as in 'kaman.</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>kaːman</text></form>
</field>
<field type="Perso Arabic Burushaski">
