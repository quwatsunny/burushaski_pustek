<entry dateCreated="2020-04-13T00:53:07Z" dateModified="2025-10-08T01:12:46Z" id="ek_808ff1ff-bb11-44d8-bce1-3cc0d8100d0f" guid="808ff1ff-bb11-44d8-bce1-3cc0d8100d0f">
<lexical-unit>
<form lang="bsk"><text>ek</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="en_4ecc97bf-8f9f-496a-8b96-a15276180806"/>
<relation type="Compare" ref="an_f40eb149-6cfa-46ea-821a-3e6402c2237e"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛk</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ایࣷک</text></form>
</field>
<sense id="13f15eca-8a79-44a2-8fb4-e65bf06fff49">
<grammatical-info value="Indefinite article">
</grammatical-info>
<gloss lang="en"><text>With the meaning  of 'some',  it is used as an Indefinite with all plural noun classes of Burushaski. See examples. </text></gloss>
<gloss lang="ur-PK"><text>کچھ</text></gloss>
<example>
<form lang="bsk"><text>to ses ek bám</text></form>
<translation type="Free translation">
<form lang="en"><text>There were some people.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>haġoraa ek duhanja gallen.</text></form>
<translation type="Free translation">
<form lang="en"><text>Some horses went by galloping. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>gaṭunz ek jaġa ót.</text></form>
<translation type="Free translation">
<form lang="en"><text>Make me some clothes (as a gift). </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>huri eke guśiṅa eka botán senen.</text></form>
<translation type="Free translation">
<form lang="en"><text>By some people, to some women, 3PL.h said something. </text></form>
</translation>
</example>
</sense>
</entry>
