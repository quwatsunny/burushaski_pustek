</field>
<sense id="c41a0d61-3854-4c43-9a8f-b139d33ac127" order="0">
<grammatical-info value="Interrogative pro-form">
</grammatical-info>
<gloss lang="en"><text>which (noun class y)</text></gloss>
<gloss lang="ur-PK"><text>کونسی</text></gloss>
<example>
<form lang="bsk"><text>ámet gunz</text></form>
<translation type="Free translation">
<form lang="en"><text>which day?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ámét jaġa?</text></form>
<translation type="Free translation">
<form lang="en"><text>which place?</text></form>
</translation>
</example>
</sense>
<sense id="b395283d-0f1c-4eb3-b365-4643afb1560d" order="1">
<grammatical-info value="Relative Pronoun">
</grammatical-info>
<gloss lang="en"><text>what, whatever, whichever</text></gloss>
<gloss lang="ur-PK"><text>جو</text></gloss>
<example>
<form lang="bsk"><text>amet un senum bám ka te bár thum duwa. </text></form>
