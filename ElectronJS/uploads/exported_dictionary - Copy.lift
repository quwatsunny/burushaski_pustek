<sense id="d8165efb-2eaf-45c7-afbd-260b6e0fab86">
<gloss lang="en"><text>plural suffix used with certain nouns of y-class</text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو  بعض الفاظ کو جمع بناتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>cherehaṅ (chere +haṅ) esqóll</text></form>
<translation type="Free translation">
<form lang="en"><text>Burn the roots. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>milihaṅ (mili +haṅ) mene. </text></form>
<translation type="Free translation">
<form lang="en"><text>Drink the medicine. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mii minyaháṅ (minyas +haṅ) musca diyaśai. </text></form>
<translation type="Free translation">
<form lang="en"><text>Our stories concluded. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mućuhaṅ (mućusk +haṅ) galjai.</text></form>
<translation type="Free translation">
<form lang="en"><text>The bread turners broke. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>puhaṅ (puś +haṅ) gagayu mani. </text></form>
<translation type="Free translation">
<form lang="en"><text>The shirts became short.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja ġorʰpuhaṅ (ġorʰpuṣ) dooiya. </text></form>
<translation type="Free translation">
<form lang="en"><text>I built the hay storages (building).</text></form>
</translation>
</example>
</sense>
</entry>
