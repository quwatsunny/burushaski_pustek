<grammatical-info value="Verb Phrases">
</grammatical-info>
<gloss lang="en"><text>what do I know,  not sure what</text></gloss>
<gloss lang="ur-PK"><text>کیا پتہ، کیا معلوم</text></gloss>
<example>
<form lang="bsk"><text>bé heyam, bo mani</text></form>
