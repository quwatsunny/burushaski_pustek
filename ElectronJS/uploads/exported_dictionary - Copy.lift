<form lang="bsk"><text>ćai aiet.</text></form>
<translation type="Free translation">
<form lang="en"><text>Do not make the tea. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-11-03T17:41:14Z" dateModified="2025-11-13T02:40:29Z" id="aieta_438b6e88-c381-475d-b071-756872bf29ed" guid="438b6e88-c381-475d-b071-756872bf29ed">
<lexical-unit>
<form lang="bsk"><text>aieta</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The word has three morphemes [ai]→ do not, [et] do, [a] PST.1SG</text></form>
</note>
<field type="Bound Word">
<form lang="bsk"><text>aiet</text></form>
</field>
<field type="IPA Burushaski">
<form lang="bsk"><text>aiɛta</text></form>
</field>
<trait name="Past Participle" value="Past Participial"/>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ائیࣷ ایࣷتاࣷ</text></form>
</field>
<sense id="b149999e-87f2-4059-a083-06ff28cb3af7">
<gloss lang="en"><text>1SG did not do (it).</text></gloss>
<gloss lang="ur-PK"><text>میں نے نہیں کیا۔ </text></gloss>
<example>
<form lang="bsk"><text>ja doro aieta.</text></form>
<translation type="Free translation">
<form lang="en"><text>I did not work.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>we doro aieten.</text></form>
<translation type="Free translation">
<form lang="en"><text>They did not work. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-26T14:39:47Z" dateModified="2025-11-13T02:40:29Z" id="aietas1_51ab61c9-183b-4440-89bb-7efe1fd5d359" guid="51ab61c9-183b-4440-89bb-7efe1fd5d359" order="1">
