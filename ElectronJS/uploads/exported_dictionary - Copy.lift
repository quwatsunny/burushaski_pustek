<field type="IPA Burushaski">
<form lang="bsk"><text>-ko</text></form>
</field>
<sense id="7e0b1b10-6989-4f7c-8cde-45d752e6d296">
<gloss lang="en"><text>plural suffix</text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو بعض الفاظ کو جمع بناتا ہے ۔</text></gloss>
<example>
<form lang="bsk"><text>han nyu ćhar, daa alhtac noyu ćharʰko</text></form>
<translation type="Free translation">
<form lang="en"><text>One big mountain and two big mountains. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>han ećoġon ṣenẓ, alʰtac noyu ṣenẓoko</text></form>
<translation type="Free translation">
<form lang="en"><text>One small girder, two large girders. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>han gaganum, isko ġosayu phinjoko</text></form>
<translation type="Free translation">
<form lang="en"><text>One short, three long polo sticks. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2024-07-29T04:28:41Z" dateModified="2024-07-29T04:30:29Z" id="-ko2_80a7b7f0-2351-43c9-abc4-b938e7f30274" guid="80a7b7f0-2351-43c9-abc4-b938e7f30274">
