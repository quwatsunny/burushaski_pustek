<gloss lang="ur-PK"><text>نہیں کر کے</text></gloss>
<example>
<form lang="bsk"><text>ne doro aietum gali. </text></form>
<translation type="Free translation">
<form lang="en"><text>He went without doing the work.</text></form>
</translation>
</example>
</sense>
</entry>
