<note>
<form lang="en"><text>a.mu.man.ú (NEG.3SG.hf.become.PST)</text></form>
</note>
<relation type="Compare" ref="amomanú_eff23ca8-645d-45f6-8036-31c0c492659a"/>
<trait name="do-not-publish-in" value="Idioms"/>
<trait name="Past Participle" value="Past Participial"/>
<field type="Perso Arabic Burushaski">
