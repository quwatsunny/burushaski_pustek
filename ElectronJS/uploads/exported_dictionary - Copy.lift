<field type="IPA Burushaski">
<form lang="bsk"><text>ʈʂuŋgu</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>څُنٚگُو</text></form>
</field>
<sense id="6a6ea399-2556-4372-95be-eeacf92c339d">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>Stook of sheaves, standing group of plants or grass sheaves. </text></gloss>
<gloss lang="ur-PK"><text>گھاس یا فصل کی کھڑی گٹھڑیاں</text></gloss>
<example>
<form lang="bsk"><text>iṣqaa buśu c̣ungu nót doyi. </text></form>
<translation type="Free translation">
<form lang="en"><text>Group the grass sheaves into a stook, then stand the whole bundle upright.</text></form>
</translation>
</example>
</sense>
