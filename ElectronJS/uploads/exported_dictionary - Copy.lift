<relation type="Compare" ref="ikall_66537732-3ca0-47e5-90ba-2e3faf349c55"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>yʌkaɫ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>یکلٚ</text></form>
</field>
<sense id="005db523-8b92-439d-9d34-b4219d69bd43" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>Point of reference for directions, depending on the reference, it could mean from or towards</text></gloss>
<gloss lang="ur-PK"><text>نقطہ حوالہ برائے سمت، سمت</text></gloss>
<example>
<form lang="bsk"><text>guyakalum jaa ayakalla men ka ay duuya.</text></form>
<translation type="Free translation">
<form lang="en"><text>Nobody came towards me from your end or side. </text></form>
</translation>
</example>
</sense>
<sense id="bef42106-7ebe-46b4-8df9-841896289b63" order="1">
<gloss lang="en"><text>direction, side</text></gloss>
<gloss lang="ur-PK"><text>سمت، سیدھ</text></gloss>
<example>
<form lang="bsk"><text>ne sendé yakalla gali </text></form>
<translation type="Free translation">
<form lang="en"><text>He went towards the direction of the river. </text></form>
</translation>
</example>
</sense>
</entry>
