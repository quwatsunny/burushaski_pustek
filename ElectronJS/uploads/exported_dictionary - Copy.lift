<entry dateCreated="2019-04-15T04:35:06Z" dateModified="2025-11-09T15:18:56Z" id="śoqa_81889e90-26d2-4c13-9f5f-54c31be84c8d" guid="81889e90-26d2-4c13-9f5f-54c31be84c8d">
<lexical-unit>
<form lang="bsk"><text>śoqa</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>In Balti shoka means a long cloak. </text></form>
</note>
