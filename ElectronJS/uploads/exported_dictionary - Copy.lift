<entry dateCreated="2021-06-30T01:21:34Z" dateModified="2025-10-08T01:12:46Z" id="-ćume_1cb11d3a-cfa4-4d0c-80c6-4dcaead2176f" guid="1cb11d3a-cfa4-4d0c-80c6-4dcaead2176f">
<lexical-unit>
<form lang="bsk"><text>-ćume</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-tʃumɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چُمےࣷ</text></form>
</field>
<sense id="143d763a-21b0-4002-a087-1f0e10a18c16">
<gloss lang="en"><text>suffix used with verbs to form an Imperfective aspect.  </text></gloss>
<example>
<form lang="bsk"><text>gute doro neé ećume dim bai. </text></form>
<translation type="Free translation">
<form lang="en"><text>He has come along by doing this work. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gús herʰcúme gallú. </text></form>
<translation type="Free translation">
<form lang="en"><text>The lady wen crying along the way. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>húk too ġarićume diwaśimi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The dog will be left there barking. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-02-15T06:01:53Z" dateModified="2025-10-08T01:12:46Z" id="-ćumu_7d62e7a0-6cc4-403e-a78b-82e7842a6d8c" guid="7d62e7a0-6cc4-403e-a78b-82e7842a6d8c">
