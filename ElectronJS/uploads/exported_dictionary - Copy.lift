<entry dateCreated="2021-06-30T00:38:42Z" dateModified="2025-10-08T01:12:46Z" id="gaa_1d7d79a5-c322-4e1a-b364-d4dfc5c6eeeb" guid="1d7d79a5-c322-4e1a-b364-d4dfc5c6eeeb">
<lexical-unit>
<form lang="bsk"><text>gaa</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The length of vowel indicates the tone of the speaker. Here the long vowel indicates more of a polite or suggestive tone.</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>gaː</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>گا</text></form>
</field>
<sense id="0805653b-60b4-4ac1-83c7-d4e31c596060">
<grammatical-info value="Exclamation">
</grammatical-info>
<gloss lang="en"><text>here, take it. </text></gloss>
<gloss lang="ur-PK"><text>ذرہ  یہ لو</text></gloss>
<example>
<form lang="bsk"><text>gaa, phuk an chell menéa</text></form>
<translation type="Free translation">
<form lang="en"><text>Here,drink some water. Would you?</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-28T06:06:47Z" dateModified="2025-10-08T01:12:46Z" id="gaan_a9630447-1198-4abb-a753-dfad17eac67e" guid="a9630447-1198-4abb-a753-dfad17eac67e">
