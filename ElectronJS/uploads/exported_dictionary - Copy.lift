<sense id="c69412c0-91ef-4014-8532-8d2c8f78f4f4">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>FUT of /et/ where the subject is 1PL, (1PL) will do or make</text></gloss>
<gloss lang="ur-PK"><text>ہم کریں گے۔</text></gloss>
<example>
<form lang="bsk"><text>mi doro ećan.</text></form>
<translation type="Free translation">
<form lang="en"><text>We will work. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ẓoiṅ, gaṭi nimima, phú ećan.</text></form>
<translation type="Free translation">
<form lang="en"><text>Come (PL), after getting together, we will make fire. </text></form>
</translation>
</example>
</sense>
</entry>
