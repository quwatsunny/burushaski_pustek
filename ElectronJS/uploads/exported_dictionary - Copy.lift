<relation type="Compare" ref="a1_544258cc-2719-406a-bb33-466a88f4e812"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-ʃku</text></form>
</field>
<sense id="e79a43f8-ad22-4a74-a43d-b29522ad643f">
<gloss lang="en"><text>plural suffix used with noun x-class, ending with /t, n, ṅ or m/. </text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو بعض الفاظ کو جمع بناتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>khun &gt; khunaśku</text></form>
<translation type="Free translation">
<form lang="en"><text>corners</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ḍat &gt; ḍaṭaśku</text></form>
<translation type="Free translation">
<form lang="en"><text>ditches </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mán &gt; mánaśku</text></form>
<translation type="Free translation">
<form lang="en"><text>elevated place to sleep on (plural)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>gát &gt; gataśku</text></form>
<translation type="Free translation">
<form lang="en"><text>knots</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>duṅ &gt; <span lang="en">duṅaśku</span></text></form>
<translation type="Free translation">
<form lang="en"><text>pillars</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>suruṅ &gt;suruṅaśku</text></form>
<translation type="Free translation">
<form lang="en"><text>streets</text></form>
</translation>
</example>
</sense>
</entry>
