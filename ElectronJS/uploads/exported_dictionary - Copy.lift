<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>گمِݜ</text></form>
</field>
<sense id="290212c0-dd32-401d-9bb9-745e07a64e65">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>3SG.h.Pay.may,  let him/should return, he/she may pay back</text></gloss>
<gloss lang="ur-PK"><text>وہ ادا کرے، وہ لوٹا دے۔ </text></gloss>
<example>
<form lang="bsk"><text>gute úṣ moo gamiṣ. </text></form>
<translation type="Free translation">
<form lang="en"><text>This loan should be paid by her. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>phat et, nee gámiṣ.</text></form>
<translation type="Free translation">
<form lang="en"><text>Leave him, he should return/pay back. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-16T18:13:51Z" dateModified="2025-10-08T01:12:46Z" id="gamún_2dcc22cc-ef03-453c-a1ab-052958c12e77" guid="2dcc22cc-ef03-453c-a1ab-052958c12e77">
