<relation type="Compare" ref="hundares_577bf6ea-a992-4dd1-8099-af2a76fddfb3"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>darɛʃ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دَریࣷش</text></form>
</field>
<sense id="de5120a2-2918-48e8-87b8-0cc6414ee9fb">
<gloss lang="en"><text>holding something in front (of something) in order to catch or stop</text></gloss>
<gloss lang="ur-PK"><text>کسی چیز کو روکنے کے لیے سامنے کوئی اور شے رکھنا۔ </text></gloss>
<example>
<form lang="bsk"><text>guren dareś et, gumuśa gulei waśćam. </text></form>
<translation type="Free translation">
<form lang="en"><text>Hold your hand (to get), I will put the pill in your palm. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-19T23:26:57Z" dateModified="2025-10-08T01:12:46Z" id="dareś2_3b451d21-3e03-4fc8-9118-a3147b1d4688" guid="3b451d21-3e03-4fc8-9118-a3147b1d4688">
