<form lang="bsk"><text>ćáṣṭakal</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>A compound of ćaṣt (brunch time) + yakall (towards)</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>tʃʌʂʈakal</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چَݜٹکل</text></form>
</field>
<sense id="8cf43636-4982-47b6-80e8-b07ee8c2e107" order="0">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>middle hour between sunrise and noon. </text></gloss>
<gloss lang="ur-PK"><text>دس اور گیارہ بجے کے درمیان کا وقت</text></gloss>
<example>
<form lang="bsk"><text>ja aye ćaṣṭakala akho deṣqalʰti.</text></form>
<translation type="Free translation">
<form lang="en"><text>My sun arrived here around the late morning time. </text></form>
</translation>
</example>
</sense>
<sense id="e67c5eee-29e5-4bcc-b4e2-fb9008ce55ec" order="1">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>brunch</text></gloss>
<gloss lang="ur-PK"><text>ناشتے اور دوپہر کے درمیان کا کھانا۔</text></gloss>
</sense>
</entry>
