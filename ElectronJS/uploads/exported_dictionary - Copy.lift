</field>
<sense id="31e29672-c674-4fab-a419-112ab715ca80">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>excessive and often unnecessary</text></gloss>
<gloss lang="ur-PK"><text>زیادہ اور غیرضروری </text></gloss>
<example>
<form lang="bsk"><text>guxata base sen, ćhaćaki bariṅ ayet. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not do excessive and unnecessary talk, ask your mouth to settle down. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-01T13:52:21Z" dateModified="2026-01-01T19:43:12Z" id="ćhagha_4e026234-a8f6-4f33-a2bf-a347b90daf91" guid="4e026234-a8f6-4f33-a2bf-a347b90daf91">
