<entry dateCreated="2021-01-21T17:20:41Z" dateModified="2025-10-08T01:12:46Z" id="-iṅ1_46d2985c-4823-4524-82f5-d7b7799f1700" guid="46d2985c-4823-4524-82f5-d7b7799f1700">
<lexical-unit>
<form lang="bsk"><text>-iṅ</text></form>
<form lang="bsk-Zxxx-PK-x-Yasin-audio"><text>637637978877151083inǧ.wav</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<note>
<form lang="en"><text>Other examples are: meliṅ (mell + iṅ) wines, cheliṅ (chell + iṅ) waters, bariṅ (bar +iṅ) words or statements,  hiliṅ (hill + iṅ) lips etc. </text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>-iŋ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اݩ</text></form>
</field>
<sense id="203e0862-3692-427f-b3a8-8feb0f3f8223">
<gloss lang="en"><text>Plural suffix, always used with y-class nouns or adjectives describing or referring to y-class nouns. </text></gloss>
<gloss lang="ur-PK"><text>لاحقہ ( بعض   واحد اسموں کو جمع بنا دیتا ہے)</text></gloss>
<example>
<form lang="bsk"><text>terek, terekiṅ</text></form>
<translation type="Free translation">
<form lang="en"><text>poplar tree, poplar trees. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus mo ṣiyeliṅ</text></form>
<translation type="Free translation">
<form lang="en"><text>The beauties (beautiful acts) of that woman. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-11-24T14:39:47Z" dateModified="2025-10-08T01:12:46Z" id="-iṅ2_459409c0-e765-45aa-865b-da1a8512db55" guid="459409c0-e765-45aa-865b-da1a8512db55">
