<entry dateCreated="2020-07-19T02:15:42Z" dateModified="2025-10-08T01:12:46Z" id="roi ce_a84cdc39-6b4e-4213-925d-213559bb2ea6" guid="a84cdc39-6b4e-4213-925d-213559bb2ea6">
<lexical-unit>
<form lang="bsk"><text>roi ce</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>roi tsɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>روࣷ ڎےࣷ</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>roi</text></form>
</field>
<trait name="Possessors" value="U-Obligatorily Possessors"/>
<sense id="a2c29e33-572c-4872-a059-f1cc2e7adc7b">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>Literal meaning of this word is face with. What it really means is to encounter or stumble upon. </text></gloss>
<gloss lang="ur-PK"><text>سامنا ہونا۔ رو بہ رو  ملنا۔    </text></gloss>
<example>
<form lang="bsk"><text>gan ule buśán neé roi ce yay</text></form>
<translation type="Free translation">
<form lang="en"><text>On the way, he came across a cat. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mi Giilʰt mihán roi ce yayen.</text></form>
<translation type="Free translation">
<form lang="en"><text>We met each other at Gilgit.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>Pholok ane guroi ce yay ka, ja bar ne ce ḍis et. </text></form>
<translation type="Free translation">
<form lang="en"><text>If you, somewhere,  stumble into Pholok, get my word (message) to him. </text></form>
</translation>
</example>
</sense>
</entry>
