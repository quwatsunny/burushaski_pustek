<sense id="dd573bd7-9888-4ab4-a661-a8651fe0f819" order="0">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>used to, used for past habit or state</text></gloss>
<gloss lang="ur-PK"><text>ماضی کی عادت یا حلت کو بیناں کرنے کے لیے استعمال ہوتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>yar waviśtaru uyaći pharʰce ećum cek. </text></form>
<translation type="Free translation">
<form lang="en"><text>In the past, elderly ladies (grandmas) used to wear hat (cultural hat)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un Giilʰt doro ećum cek. </text></form>
<translation type="Free translation">
<form lang="en"><text>You used to work in Gilgit. </text></form>
</translation>
</example>
</sense>
<sense id="57fbd8bf-50a4-4c9c-9b31-07cfee5c926f" order="1">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>could have, perhaps</text></gloss>
<gloss lang="ur-PK"><text>ہو سکتا ہے</text></gloss>
<example>
<form lang="bsk"><text>ja ećam cek, un bota éta. </text></form>
<translation type="Free translation">
<form lang="en"><text>I could have done it, why did you do (it)</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-01-08T19:33:41Z" dateModified="2025-12-23T21:13:47Z" id="cek ka_6dadc71b-e25a-4c98-aeda-6c4bb6711886" guid="6dadc71b-e25a-4c98-aeda-6c4bb6711886">
