<form lang="bsk"><text>dɛskʌʈ</text></form>
</field>
<trait name="Past Participle" value="Past Participial"/>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دیࣷسکٹ</text></form>
</field>
<trait name="Possessors" value="DePrifix -i,u"/>
<trait name="Verb Types" value="Transitive Simple"/>
<sense id="ba8d20be-c625-4b4b-aaf4-570c683a0cc4" order="0">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>entrap, ensnare, get (it) stuck in something, block (it) in</text></gloss>
<gloss lang="ur-PK"><text>کسی  چیز کے اندر پھنساؤ </text></gloss>
<example>
<form lang="bsk"><text>khawuṣ guxaći deskáṭ. </text></form>
<translation type="Free translation">
<form lang="en"><text>Get the morsel stuck in your mouth. </text></form>
</translation>
</example>
</sense>
<sense id="1f569c55-5fc5-49ef-8603-328a46a2f171" order="1">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>having entrapped, getting stuck</text></gloss>
<gloss lang="ur-PK"><text>پھنسا کر</text></gloss>
<example>
<form lang="bsk"><text>biyaa, yaṭes bahaći deskáṭ yuri. </text></form>
<translation type="Free translation">
<form lang="en"><text>The cow died, after having its head trapped in the hole. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus dumukhaṭú. </text></form>
<translation type="Free translation">
<form lang="en"><text>The woman got stuck. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-11-18T16:32:53Z" dateModified="2025-10-08T01:12:46Z" id="desmain_48bbb37e-0845-48e4-b272-48b732c26db6" guid="48bbb37e-0845-48e4-b272-48b732c26db6">
