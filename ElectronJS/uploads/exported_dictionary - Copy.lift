<sense id="f6d39ed1-27bf-4ab1-8a7e-d3433a372953">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>show</text></gloss>
<gloss lang="ur-PK"><text>دیکھاوۡ</text></gloss>
<example>
<form lang="bsk"><text>ja ġa aalʰter</text></form>
<translation type="Free translation">
<form lang="en"><text>Show it to me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus moġa asumuyu moólʰter. </text></form>
<translation type="Free translation">
<form lang="en"><text>Show the stars to the woman. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>cigiraa sésa oolʰter. </text></form>
<translation type="Free translation">
<form lang="en"><text>Show the goats to the people. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>wee girmiinum meélʰteren. </text></form>
<translation type="Free translation">
<form lang="en"><text>They showed us the writing (document). </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>gute doro belʰtum net ećum baan, ja goġa goolʰterʰćam. </text></form>
<translation type="Free translation">
<form lang="en"><text>How this work is done, I will show it to you. </text></form>
</translation>
</example>
</sense>
</entry>
