<entry dateCreated="2023-07-07T04:16:14Z" dateModified="2025-10-08T01:12:46Z" id="ná-_cddd3c48-f0df-46b7-ada8-4807fd51abfb" guid="cddd3c48-f0df-46b7-ada8-4807fd51abfb">
<lexical-unit>
<form lang="bsk"><text>ná-</text></form>
</lexical-unit>
<trait  name="morph-type" value="prefix"/>
<note>
<form lang="en"><text>Other forms are: neme- (1PL), nama- (2PL), nogko-(2SG) nii (3SG.hm.x.), nu-/no- (3PL), nomo- (3SG.hf)۔ Each prefix will follow with the same base verb. </text></form>
</note>
<relation type="Compare" ref="-ni_c6273cbc-9191-4d93-bc18-4f2691d43d1c"/>
<relation type="Compare" ref="nomo-_e5a77b00-d833-486a-91ab-ab70db6baaa1"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>nʌ-</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>نہ</text></form>
</field>
<sense id="dcd89e3c-067c-4dcb-b928-c77f3fe8246e" order="0">
<grammatical-info value="V.">
<trait name="type" value="affix"/>
</grammatical-info>
<gloss lang="en"><text>Used exclusively with the first person singular (1SG), this verbal prefix indicates the manner in which an action was performed.</text></gloss>
<example>
<form lang="bsk"><text>nee ja náhu akholla dáci. </text></form>
<translation type="Free translation">
<form lang="en"><text>He brought me here by making me run. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un ja nágirat bo ećum ba?</text></form>
<translation type="Free translation">
<form lang="en"><text>What are you going to do by making me dance?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>nee duġaresi, "ja belʰtum nokót guchućam?" ja seneka, "naguchar, da belʰtum nát"</text></form>
<translation type="Free translation">
<form lang="en"><text>"How will I take you",  he asked. I said, "By making me walk, how else?" I said. </text></form>
</translation>
</example>
</sense>
<sense id="97abd4de-18f8-4fe6-bee9-f371eebb848a" order="1">
<grammatical-info value="V.">
<trait name="type" value="affix"/>
</grammatical-info>
<gloss lang="en"><text>After having (1SG) done or made</text></gloss>
<gloss lang="ur-PK"><text> (مجھے ) کرا کر ہا  بنا کر</text></gloss>
<example>
<form lang="bsk"><text>ja nágućha, un né</text></form>
<translation type="Free translation">
<form lang="en"><text>You go, after making me sleep. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja nasqan ḍaṅ át. </text></form>
<translation type="Free translation">
<form lang="en"><text>Bury me after having me killed</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2021-10-09T03:04:32Z" dateModified="2025-10-08T01:12:46Z" id="naa_f746bfdd-c84b-4b01-b315-6aaed8af4877" guid="f746bfdd-c84b-4b01-b315-6aaed8af4877">
