<entry dateCreated="2019-03-25T02:35:23Z" dateModified="2025-08-30T20:10:48Z" id="phať_483f36ce-4bc6-48f6-8987-857d5f36bcfa" guid="483f36ce-4bc6-48f6-8987-857d5f36bcfa">
<lexical-unit>
<form lang="bsk"><text>phát</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>BUR  → FA: fatt فت (desisting, ceasing). In Balti the word phut is used for release or unfasten. </text></form>
</note>
<relation type="Compare" ref="phátí_dbf8e292-4b1b-4147-8752-addd94389046"/>
<relation type="Compare" ref="harʰphát_6ddc3068-148b-4535-b4ce-0a0dc2ea98dc"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>pʰʌt</text></form>
</field>
<trait name="Past Participle" value="Past Participial"/>
<sense id="432d031d-e768-46d4-a1fe-1c81e30c3792" order="0">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>leave</text></gloss>
<gloss lang="ur-PK"><text>چھوڑو</text></gloss>
<example>
<form lang="bsk"><text>kitep yaare pháṭ et</text></form>
<translation type="Free translation">
<form lang="en"><text>Leave the book down.</text></form>
</translation>
</example>
</sense>
<sense id="ed365000-f8c8-4099-b234-c532c3bfbde7" order="1">
<gloss lang="en"><text>set loose</text></gloss>
<gloss lang="ur-PK"><text>جانے دو</text></gloss>
<example>
<form lang="bsk"><text>mal khaṭa phát ót.</text></form>
<translation type="Free translation">
<form lang="en"><text>Release the cattle.</text></form>
</translation>
</example>
</sense>
<sense id="090d5008-8cb9-4ef2-86b3-ccb24b37ae38" order="2">
<gloss lang="en"><text>abandon, give up</text></gloss>
<gloss lang="ur-PK"><text>ترک کرو</text></gloss>
<example>
<form lang="bsk"><text>phaiṅ phat et</text></form>
<translation type="Free translation">
<form lang="en"><text>Give up (the habit of) lying.</text></form>
</translation>
</example>
</sense>
</entry>
