<entry dateCreated="2021-11-06T16:16:21Z" dateModified="2025-11-16T15:49:23Z" id="akuheyám_7dc7fde6-0675-4595-a135-80b733b6b492" guid="7dc7fde6-0675-4595-a135-80b733b6b492">
<lexical-unit>
<form lang="bsk"><text>akuheyám</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>[a.ku(gu) he.y] 1SG.2SG.know.FUT. As a standalone word, it is normally a Future form the verb. With auxiliary verb 'ba', it becomes a Declarative Progressive verb.</text></form>
</note>
<relation type="Compare" ref="hem3_1a35b705-1c2d-4452-8e62-9827ff48281d"/>
<relation type="Compare" ref="a-2_8d8ad6c1-41d8-49c8-af58-3cb3cd506be3"/>
<relation type="Compare" ref="gu-1_e08e49a6-c917-429e-8219-e2d0f95a7455"/>
