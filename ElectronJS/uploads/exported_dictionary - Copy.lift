</sense>
<sense id="8c1132ce-8769-4bf7-bf30-e383073da430" order="1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>unsubstantial, rhetoric</text></gloss>
<gloss lang="ur-PK"><text>غیر حقیقی، لفاظی کی حد تک</text></gloss>
<example>
