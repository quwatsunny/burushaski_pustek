<entry dateCreated="2019-10-26T15:54:53Z" dateModified="2025-10-08T01:12:46Z" id="-kiṣ_3e8baac9-e539-49c3-a787-61cf40e8828c" guid="3e8baac9-e539-49c3-a787-61cf40e8828c">
<lexical-unit>
<form lang="bsk"><text>-kiṣ</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<note>
<form lang="en"><text>The  suffix is used in ornative case.  </text></form>
</note>
<relation type="Compare" ref="mooskiṣ_523b0922-de3e-4f8b-b67c-79e8faa86758"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-kiʂ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>کِݜ</text></form>
</field>
<sense id="14e6862a-83d8-4ed3-b067-af696cc7d3f9" order="0">
<gloss lang="en"><text>endowed with, characterized by. someone or something that is having,holding, carrying or keeping (something), a possessor </text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو اسم کے ساتھ 'والا یا والی یا مند' کے لیے استعمال ہوتا ہے۔</text></gloss>
<example>
<form lang="bsk"><text>nikiṣ hir</text></form>
<translation type="Free translation">
<form lang="en"><text>man with beard</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>buśkyekiṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>hairy</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>behaikiṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>a person with a chronic disease (as if he is the keeper of the disease)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>turyaṅkiṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>(of animal) with horns</text></form>
</translation>
</example>
</sense>
<sense id="1de02d10-6aeb-4aab-a6c5-fa6192691b8a" order="1">
<gloss lang="en"><text>characterized by, known for or identified as</text></gloss>
<gloss lang="ur-PK"><text>کسی بات کے لیے مشہور ہونا۔ </text></gloss>
<example>
<form lang="bsk"><text>phaiṅkiṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>person known for his lies, lier.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>phiṣkiś</text></form>
<translation type="Free translation">
<form lang="en"><text>person characterized by or known for his flatulence </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>kharukiṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>person who is known to have a lot of lice. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mooskiṣ hir</text></form>
<translation type="Free translation">
<form lang="en"><text>a man with anger</text></form>
</translation>
</example>
</sense>
</entry>
