<entry dateCreated="2021-03-10T18:20:52Z" dateModified="2025-11-12T03:30:03Z" id="aam_068310a7-7fd7-49c6-818f-4577555e3d19" guid="068310a7-7fd7-49c6-818f-4577555e3d19">
<lexical-unit>
<form lang="bsk"><text>aam</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>Derived from aan via nasal assimilation before bilabial consonants (e.g., /b/) of bi, bai, bu and baan, the Copula verbs are mostly needed in the present tense context. aan has its other forms such as ane  → where at, anum → from where and ana → to where.</text></form>
</note>
<relation type="Compare" ref="ané_603b58a8-cfac-48a2-9e49-c30afb6ac72c"/>
<relation type="Compare" ref="aan_de44633b-cccf-4ecf-8f87-99ca5e317f88"/>
<relation type="Compare" ref="ámen2_9d23494e-a7ae-4071-80cf-2c4e0260f270"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>aːm</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>آم </text></form>
</field>
<sense id="47b91caa-0cbd-4cf4-a86c-7875f4211b04">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>where (are, is)</text></gloss>
<gloss lang="ur-PK"><text>کہاں(ہے یا ہیں)</text></gloss>
<example>
<form lang="bsk"><text>ne hir aam bai?</text></form>
<translation type="Free translation">
<form lang="en"><text>Where is the man?</text></form>
<form lang="ur-PK"><text> </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus aam bu?</text></form>
<translation type="Free translation">
<form lang="en"><text>Where is the lady?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>se jinaari aam bi?</text></form>
<translation type="Free translation">
<form lang="en"><text>Where is that object?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>te girminum aan duwá?</text></form>
<translation type="Free translation">
<form lang="en"><text>Where is that document?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>we ses aam baan?</text></form>
<translation type="Free translation">
<form lang="en"><text>Where are those people?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ce huka aam biyen?</text></form>
<translation type="Free translation">
<form lang="en"><text>Where are those dogs?</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-25T20:02:03Z" dateModified="2025-11-12T03:46:02Z" id="aamalla_dbf5effe-d684-4cab-bcbb-465422237239" guid="dbf5effe-d684-4cab-bcbb-465422237239">
<lexical-unit>
