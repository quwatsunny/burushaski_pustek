</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>- ayaśa → to the sky
- ayaśum → from the sky
- ayaśi → in the skyn
</text></form>
</note>
<relation type="_component-lexeme" ref="">
<trait  name="complex-form-type" value="Unspecified Complex Form"/>
