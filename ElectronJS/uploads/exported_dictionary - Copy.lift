<entry dateCreated="2021-02-05T02:37:45Z" dateModified="2025-10-08T01:12:46Z" id="naġar_661597d4-ad22-46f7-bdcf-57f690329ec9" guid="661597d4-ad22-46f7-bdcf-57f690329ec9">
<lexical-unit>
<form lang="bsk"><text>naġar</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="tús_76224a85-2df4-466d-8be7-7d40feed84c2"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>naɣar</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>نغر</text></form>
</field>
