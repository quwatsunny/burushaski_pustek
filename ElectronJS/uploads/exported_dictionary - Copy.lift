<form lang="en"><text>I was not able to remove the dirt of the clothes. </text></form>
</translation>
</example>
</sense>
<sense id="4c8fa547-672b-4c31-948a-3f38868c803f" order="1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>dirty, with dirt</text></gloss>
<gloss lang="ur-PK"><text>گندا</text></gloss>
<example>
<form lang="bsk"><text>gaṭunz ther manum biyen. </text></form>
<translation type="Free translation">
<form lang="en"><text>The clothes have become dirty. </text></form>
</translation>
</example>
</sense>
</entry>
