<form lang="bsk"><text>ʂaːq</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ݜاق</text></form>
</field>
<sense id="ab3f8e36-0490-484a-b637-17dcdd7f08e6" order="0">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>plain, straightened, stretched out, smoothed out</text></gloss>
<gloss lang="ur-PK"><text>سیدھا، کُھلا اور پھیلا ہوا۔</text></gloss>
<example>
<form lang="bsk"><text>gulʰtaiṅ ṣaaq et. </text></form>
<translation type="Free translation">
<form lang="en"><text>Make your legs straightened out.  </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja gaṭunz ṣaaq otá. </text></form>
<translation type="Free translation">
<form lang="en"><text>I smoothed out the clothes. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>jaġa ṣaaq gac̣he an duchuwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>Could you please get me some straightened twig. </text></form>
</translation>
</example>
</sense>
<sense id="6bd20bba-96c9-4f5d-84e2-562607e7a47d" order="1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>what is not dented or crooked</text></gloss>
<gloss lang="ur-PK"><text>وہ جو ٹیڑا نہ ہو</text></gloss>
<example>
<form lang="bsk"><text>gute ćhumár ṣoq manum duwa, phuk an ṣaaq eta. </text></form>
<translation type="Free translation">
<form lang="en"><text>This metal has become dented, could you please make it smooth. </text></form>
</translation>
</example>
</sense>
</entry>
