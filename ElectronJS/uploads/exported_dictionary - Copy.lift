<sense id="5ed08bbe-b622-42d5-91a1-6c9a735f79b8">
<gloss lang="en"><text>not (going) to do, not (going) to make</text></gloss>
<gloss lang="ur-PK"><text> نہ کرنے والا، کرنے والی(کام، بات وغیرہ)</text></gloss>
<example>
<form lang="bsk"><text>ja gute doro aietas ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I am not going to do this work. </text></form>
