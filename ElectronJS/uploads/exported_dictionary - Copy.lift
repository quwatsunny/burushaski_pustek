<entry dateCreated="2020-03-01T17:41:54Z" dateModified="2025-10-08T01:12:46Z" id="gón1_7b6e24db-6f12-4419-be64-0a7a8f2e2783" guid="7b6e24db-6f12-4419-be64-0a7a8f2e2783">
<lexical-unit>
<form lang="bsk"><text>gón</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The interjection 'gón' is used to express an invitation or command, indicating the speaker's desire to accompany or follow the addressee. If the speaker wants the addressee to join them, 'ẓo' will be used.</text></form>
</note>
<relation type="Compare" ref="né_b4ffb70a-afee-401f-8c15-d07d867b59c1"/>
<relation type="Compare" ref="neiṅ_f5b0a7ed-9fc2-4dcb-96a3-cb6aff2c2cf5"/>
<relation type="Compare" ref="cherem_b3998845-0b56-41c4-a946-77026ec1a979"/>
<relation type="Compare" ref="ẓo2_0b4cb131-107a-4161-8fba-3dbf2ac2a6be"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>gɔn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>گوࣷن</text></form>
</field>
<field type="Plural Suffix">
<form lang="bsk"><text>     </text></form>
</field>
<sense id="cc2e214a-27b3-418c-949e-a48137777cc7">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>let's go, come along</text></gloss>
<gloss lang="ur-PK"><text>چلیے، چلو</text></gloss>
</sense>
</entry>
