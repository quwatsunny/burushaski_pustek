<entry dateCreated="2019-09-12T22:50:57Z" dateModified="2025-11-22T05:35:02Z" id="át_ef7cbf9b-469e-4d7f-a9c6-4a035417cc1e" guid="ef7cbf9b-469e-4d7f-a9c6-4a035417cc1e">
<lexical-unit>
<form lang="bsk"><text>át</text></form>
</lexical-unit>
