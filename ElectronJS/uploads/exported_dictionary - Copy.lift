</field>
<sense id="e3408617-c65b-441f-8e04-652f41c33712">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>person in exile, person who has left his native or resident country for reasons beyond his control</text></gloss>
<gloss lang="ur-PK"><text>خود ساختہ جلاوطن</text></gloss>
<example>
<form lang="bsk"><text>ja bathan ka phat net, holle ane garzindá ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>Having left even my own country, I am a refugee somewhere aboard.  </text></form>
</translation>
</example>
</sense>
</entry>
