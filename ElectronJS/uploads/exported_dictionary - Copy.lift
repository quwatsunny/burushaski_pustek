<entry dateCreated="2023-01-29T05:07:30Z" dateModified="2025-10-08T01:12:46Z" id="d-waqall_b5f91854-eb6a-4a11-b7d1-75f195188ff4" guid="b5f91854-eb6a-4a11-b7d1-75f195188ff4">
<lexical-unit>
<form lang="bsk"><text>d-waqall</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>In the first example above, the causer of the action is not involved in the action and hence /domowaqall is used. In the 2nd example, the causer may or may not involve in the performance of the action. </text></form>
</note>
<relation type="Compare" ref="éa-_a4d3cb86-97ed-4896-a460-e691580c97a0"/>
<field type="Bound Word">
<form lang="en"><text>waqall</text></form>
</field>
<field type="IPA Burushaski">
<form lang="bsk"><text>d-waqaɫ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>د- وقڵ</text></form>
</field>
<trait name="Possessors" value="DePrifix -e,o"/>
<sense id="b159830d-ecbf-4bfe-ab56-26ce1d75716b">
<gloss lang="en"><text>used in a causative clause before the causative verb, where the action is performed or caused to be perform by an agent. </text></gloss>
<example>
<form lang="bsk"><text>ne hire mo gus domowaqall doro moóti. </text></form>
<translation type="Free translation">
<form lang="en"><text>The man got the work done by the woman. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hire mo gus moódoroi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The man made the woman work. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-11-15T03:53:35Z" dateModified="2025-10-08T01:12:46Z" id="d-was_2a170ac4-0ffb-4de2-9189-e60e303d3613" guid="2a170ac4-0ffb-4de2-9189-e60e303d3613">
<lexical-unit>
<form lang="bsk"><text>d-was</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>d-was</text></form>
</field>
<trait name="Past Participle" value="Past Participial"/>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>د-وس</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>was</text></form>
</field>
<trait name="Possessors" value="DePrifix -i,u"/>
<trait name="Verb Types" value="INTR. ERG."/>
<sense id="aa03da51-f52b-4493-a927-238d196f5570" order="0">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>-was with pronominal infixes denotes, 'being remained or left'</text></gloss>
<gloss lang="ur-PK"><text>رہنا</text></gloss>
<example>
<form lang="bsk"><text>ja too dawasa (d-a-was-a)</text></form>
<translation type="Free translation">
<form lang="en"><text>I got left there. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo iilji dumuwaśu (d-mu-was-u)</text></form>
<translation type="Free translation">
<form lang="en"><text>She got left behind. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>we ses aqmaq duwasen.(du-was-en) </text></form>
<translation type="Free translation">
<form lang="en"><text>The people were left astonished. </text></form>
</translation>
</example>
<example>
</example>
</sense>
<sense id="8a04c108-1a38-4823-a1b7-3de6d3f9b90a" order="1">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>getting held up</text></gloss>
<gloss lang="ur-PK"><text>پھنس جانا</text></gloss>
</sense>
</entry>
<entry dateCreated="2022-12-23T01:13:22Z" dateModified="2025-10-08T01:12:46Z" id="d-yall_9baa12f8-29c0-4c77-a63f-419640c7ab66" guid="9baa12f8-29c0-4c77-a63f-419640c7ab66">
<lexical-unit>
<form lang="bsk"><text>d-yall</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="doyall_dad79235-4eca-4316-9d3c-a88fd5a35037"/>
<relation type="Compare" ref="dokoyáll_d4dc28f2-9c0c-4027-b2f6-f718059a8108"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>d-yaɫ</text></form>
</field>
<trait name="Past Participle" value="P.PCTP: [-á,-í-ú,-én ]"/>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>د-یࣷڵ</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>yall</text></form>
</field>
<trait name="Possessors" value="DePrifix -e,o"/>
<sense id="d4eec67a-fe8f-400e-9367-17daeaf513c9" order="0">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>after hearing, upon hearing</text></gloss>
<gloss lang="ur-PK"><text>سُن کر، سُنے کے بعد</text></gloss>
<example>
<form lang="bsk"><text>ja ćhár án dayall zran amana. </text></form>
<translation type="Free translation">
<form lang="en"><text>I startled after hearing a sound. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hire aćhar deyall īlja ġani. </text></form>
<translation type="Free translation">
<form lang="en"><text>The man looked back after hearing my voice. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>te xabar we sese doyall taćap leén hurućayen. </text></form>
<translation type="Free translation">
<form lang="en"><text>The people remained dead silent upon hearing the news. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo guse ja bar domoyalluaa beésaa.</text></form>
<translation type="Free translation">
<form lang="en"><text>I wonder whether the lady heard what I said or not. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja bár dokoyall ún llaṅ akomana.</text></form>
<translation type="Free translation">
<form lang="en"><text>You did not move after hearing what I said.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mi gawuu ćhar án demeyallen. </text></form>
<translation type="Free translation">
<form lang="en"><text>We heard sound of a partridge.</text></form>
</translation>
</example>
</sense>
<sense id="bd4f33d9-a2aa-4ecd-ace2-9ee644fd7333" order="1">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>hearing, mostly used with past Inflections. </text></gloss>
<gloss lang="ur-PK"><text>سُنا، جو زیادہ تر فعل ماضی میں استعمال ہوتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>ja gute bár neé cum dayalla. </text></form>
<translation type="Free translation">
<form lang="en"><text>I heard this (statement) from him. </text></form>
</translation>
</example>
</sense>
</entry>
