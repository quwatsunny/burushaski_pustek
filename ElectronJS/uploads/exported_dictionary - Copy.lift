<entry dateCreated="2022-02-02T03:35:56Z" dateModified="2025-10-08T01:12:46Z" id="da1_e54e9b8a-1338-42c2-9c7c-eb6f8b974b8a" guid="e54e9b8a-1338-42c2-9c7c-eb6f8b974b8a">
<lexical-unit>
<form lang="bsk"><text>da</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>da</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دا</text></form>
</field>
<sense id="ba34fc9f-b35a-465b-bb2d-438f7a5067a4">
<grammatical-info value="Conjunction">
</grammatical-info>
<gloss lang="en"><text>used in rhetorical questions, where the speaker does not seek an answer for the question. again</text></gloss>
<example>
<form lang="bsk"><text>bariṅ khul mani, da thum bo siyam. </text></form>
<translation type="Free translation">
<form lang="en"><text>The talking is done, what else should I say. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2024-05-01T14:54:24Z" dateModified="2025-10-08T01:12:46Z" id="da2_6bdb70be-a725-4831-ac61-663e178dca67" guid="6bdb70be-a725-4831-ac61-663e178dca67">
<lexical-unit>
<form lang="bsk"><text>da</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
