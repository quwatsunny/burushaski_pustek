<trait name="Noun Class" value=" bai"/>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بَم</text></form>
</field>
<sense id="b46a1995-2d40-4177-81e3-4aca740c30e0">
<grammatical-info value="copula verb">
</grammatical-info>
<gloss lang="en"><text>were, was</text></gloss>
<gloss lang="ur-PK"><text>تھے یا تھا</text></gloss>
<example>
<form lang="bsk"><text>we ses tóo bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>The people were there. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hir tóo bam.</text></form>
<translation type="Free translation">
<form lang="en"><text>The man was there. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>we guśiṅa doro et et bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>The women were working. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hire doro et et bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>The man was working.  </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-08-01T22:35:47Z" dateModified="2025-12-01T05:53:58Z" id="bám2_8e229938-e16f-4813-98f8-a15478ff2268" guid="8e229938-e16f-4813-98f8-a15478ff2268">
