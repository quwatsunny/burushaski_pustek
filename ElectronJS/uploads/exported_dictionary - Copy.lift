<form lang="bsk"><text>ṭiṅan ne ġa aiuú. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not give the egg to him or to them. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ṭiṅayu we ġa aiuú. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not give the eggs to them. </text></form>
</translation>
</example>
</sense>
</entry>
