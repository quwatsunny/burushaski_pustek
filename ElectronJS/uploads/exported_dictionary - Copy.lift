<sense id="2e084e26-ff61-4ea0-9a85-87d2400b9482" order="0">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>sharp and pointy, having a pointy tip or end</text></gloss>
<gloss lang="ur-PK"><text>نوکدار</text></gloss>
<example>
