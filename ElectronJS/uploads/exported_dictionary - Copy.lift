</field>
<sense id="536d189a-938e-42e8-8149-3d837acd6790">
<gloss lang="en"><text>Putting someone in a position where one can choose between options or alternatives</text></gloss>
<gloss lang="ur-PK"><text>کسی کو انتخاب کرنے دینا۔</text></gloss>
<example>
<form lang="bsk"><text>thuwek ka har haraṅ ne <span lang="en">x</span>atar<span lang="en">x</span>a eća, thuwék yani.</text></form>
<translation type="Free translation">
<form lang="en"><text>When he was given the option to choose between the rifle and the ox, he chose the rifle.</text></form>
</translation>
</example>
</sense>
</entry>
