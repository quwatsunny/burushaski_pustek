<entry dateCreated="2021-01-26T22:32:08Z" dateModified="2025-10-08T01:12:46Z" id="-um2_ed3c3f2c-24fa-477f-8819-d6d77fa53770" guid="ed3c3f2c-24fa-477f-8819-d6d77fa53770">
<lexical-unit>
<form lang="bsk"><text>-um</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<relation type="Compare" ref="bárum_33763601-1249-4196-974c-dc48bbeb71e4"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-um</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اُم</text></form>
</field>
<sense id="3c1fa6a6-a4ea-4460-9d8c-27c705deeff2" order="0">
<gloss lang="en"><text>a suffix used with numerals to give a sense of set, batch or pair.</text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو گنتی کے ساتھ لگتا ہے اور سیٹ یا جوڑے کا عنصر پید ا کرتا ہے۔   </text></gloss>
<example>
<form lang="bsk"><text>alʰtokum</text></form>
<translation type="Free translation">
<form lang="en"><text>two pairs/set/group</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>hekum (hek +um)</text></form>
<translation type="Free translation">
<form lang="en"><text>One pair/set/group</text></form>
</translation>
</example>
</sense>
<sense id="f47bf5b0-d803-4a84-8dbe-44b3bb64d3ee" order="1">
<gloss lang="en"><text>suffix when used with numerals creates a sense of order</text></gloss>
<gloss lang="ur-PK"><text>سابقہ جو گنتی کے ساتھ مل کر ترتیب کو بیان کرتا ہے ۔</text></gloss>
<example>
<form lang="bsk"><text>hawelum</text></form>
<translation type="Free translation">
<form lang="en"><text>first</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>alʰtoum bar</text></form>
<translation type="Free translation">
<form lang="en"><text>secondly, second (of what is being stated)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>iskium </text></form>
<translation type="Free translation">
<form lang="en"><text>Thirdly, third.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-11T04:17:04Z" dateModified="2024-08-06T02:22:06Z" id="-um1_e2539de1-2718-4871-b3a2-6ecb7ffd2fa1" guid="e2539de1-2718-4871-b3a2-6ecb7ffd2fa1">
