<form lang="ur-PK"><text>خݜ</text></form>
</field>
<sense id="ae63f25e-0883-4a78-94b9-0811bb9f51d0">
<grammatical-info value="Postposition">
</grammatical-info>
<gloss lang="en"><text>till, until, up to</text></gloss>
<gloss lang="ur-PK"><text>تک</text></gloss>
<example>
<form lang="bsk"><text>ja ayuriṣ xaaṣ un gutheeyam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I will wait for your till I die. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2021-03-14T16:37:21Z" dateModified="2025-10-23T01:18:43Z" id="xabár_ce78e7fd-2251-45e0-b9bb-bf852fe415e9" guid="ce78e7fd-2251-45e0-b9bb-bf852fe415e9">
<lexical-unit>
<form lang="bsk"><text>xabár</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>Although this word is found in several Indo-Aryan languages,  Buruśo claim the word is a combination of xa (pure, original) and bár (word, statement) </text></form>
</note>
<relation type="Compare" ref="xa_caa6b107-cf68-4bc4-ac49-b69f2b68daca"/>
<relation type="Compare" ref="bar2_05fc23ec-74d4-4a96-b102-814014e139f2"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>xabʌr</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>خَبر</text></form>
</field>
<field type="Plural Suffix">
<form lang="bsk"><text>iṅ</text></form>
</field>
<trait name="Review 1" value="202510221"/>
<sense id="dd9b653d-f83e-4455-ae16-ad4f1009f069">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>news, word of mouth, original word or fact</text></gloss>
<gloss lang="ur-PK"><text>خبر،  حقیقت، اصل بات، منہ سے نکلی ہوئی بات</text></gloss>
</sense>
</entry>
