<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بونوࣷ</text></form>
</field>
<sense id="6e0deb97-37c8-4935-b445-881ef0396520">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>raid, loot, plundering, confiscation for failing an obligation</text></gloss>
<gloss lang="ur-PK"><text>ضبط کرنا، لوٹ مار</text></gloss>
<example>
<form lang="bsk"><text>ṣadariśu duu, bono nidelll, hallum ẓaan ġayarum chuyen. </text></form>
<translation type="Free translation">
<form lang="en"><text>Authorities raided and took away everything form home. </text></form>
</translation>
</example>
</sense>
</entry>
