</entry>
<entry dateCreated="2019-03-18T03:12:44Z" dateModified="2025-11-12T02:40:43Z" id="aa&apos;khaw_89d6f37e-2bc4-41fd-aa79-e208af3085dd" guid="89d6f37e-2bc4-41fd-aa79-e208af3085dd">
<lexical-unit>
