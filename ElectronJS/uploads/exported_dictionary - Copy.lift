<entry dateCreated="2020-08-01T23:20:05Z" dateModified="2025-11-06T15:14:01Z" id="yaṭe3_bbaa3c33-d7d4-46f8-8904-a2477a5319af" guid="bbaa3c33-d7d4-46f8-8904-a2477a5319af" order="3">
<lexical-unit>
<form lang="bsk"><text>yaṭe</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>yaʈɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>یٹےࣷ</text></form>
</field>
<sense id="caea3d68-97c8-4ab0-9476-77c7343f2d4c" order="0">
<grammatical-info value="Conjunction">
</grammatical-info>
<gloss lang="en"><text>at or during (something), while</text></gloss>
<gloss lang="ur-PK"><text>کے دوران</text></gloss>
<example>
<form lang="bsk"><text>doro ećum yaṭe ġariṅ ećum</text></form>
<translation type="Free translation">
<form lang="en"><text>Singing while working.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>doro ećum yaṭe bariṅ ayet.</text></form>
<translation type="Free translation">
<form lang="en"><text>Do not talk while at work.</text></form>
</translation>
</example>
</sense>
<sense id="a3fd3c44-a3f1-45eb-aea5-fbbbb85ff8a6" order="1">
<grammatical-info value="Conjunction">
</grammatical-info>
<gloss lang="en"><text>When used with indication of time or event,  yaṭe means after that or then. </text></gloss>
<gloss lang="ur-PK"><text>کے بعد</text></gloss>
<example>
<form lang="bsk"><text>mu guse jaġa ne senú. te yaṭe ja gallá. </text></form>
<translation type="Free translation">
<form lang="en"><text>That woman asked me to leave, then I left. </text></form>
</translation>
</example>
</sense>
</entry>
