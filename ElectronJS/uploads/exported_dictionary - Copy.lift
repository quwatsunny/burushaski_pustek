<grammatical-info value="Postposition">
</grammatical-info>
<gloss lang="en"><text>with or, at </text></gloss>
<gloss lang="ur-PK"><text>مجھ پر، میرے  ساتھ</text></gloss>
<example>
<form lang="bsk"><text>mo jaa ace (a + ce) gasú. </text></form>
