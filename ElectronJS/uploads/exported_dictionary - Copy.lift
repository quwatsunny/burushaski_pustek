<entry dateCreated="2020-03-02T15:36:40Z" dateModified="2025-08-30T20:11:04Z" id="phíri_51ff1831-a907-4fc8-ae77-e1ba07213733" guid="51ff1831-a907-4fc8-ae77-e1ba07213733">
<lexical-unit>
<form lang="bsk"><text>phíri</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>pʰɪri</text></form>
</field>
