</field>
<sense id="56aabe46-9bb4-419e-8921-ee98bc77ad88" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>trace of presence, indication of existence</text></gloss>
<gloss lang="ur-PK"><text>ہونے کا نشان، موجودگی </text></gloss>
<example>
<form lang="bsk"><text>ne darak ya api</text></form>
<translation type="Free translation">
<form lang="en"><text>There is no trace of him (being present).</text></form>
</translation>
</example>
<example>
</example>
<example>
<form lang="bsk"><text>ćai ulle mamu darak ya api.</text></form>
<translation type="Free translation">
<form lang="en"><text>There is no existence of milk in the tea.</text></form>
</translation>
</example>
</sense>
<sense id="36ea149f-3696-490b-bf1e-f878db5f00cb" order="1">
<gloss lang="en"><text>prominence and popularity</text></gloss>
<gloss lang="ur-PK"><text>اہمیت، نمایاں</text></gloss>
<example>
<form lang="bsk"><text>mo gus muyek duusum gus bú, momo darak duwa, dési duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>That woman's name is in the spotlight, she has popularity and respect. </text></form>
</translation>
</example>
</sense>
</entry>
