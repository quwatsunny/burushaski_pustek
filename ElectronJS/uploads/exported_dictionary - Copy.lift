<entry dateCreated="2019-08-27T03:38:03Z" dateModified="2025-12-31T04:20:07Z" id="ćaraaṭ_1cc67de0-7332-437e-bdd4-eb953620419e" guid="1cc67de0-7332-437e-bdd4-eb953620419e">
<lexical-unit>
<form lang="bsk"><text>ćaraaṭ</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>tʃaraːʈ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چراٹ</text></form>
</field>
<field type="Plural Suffix">
