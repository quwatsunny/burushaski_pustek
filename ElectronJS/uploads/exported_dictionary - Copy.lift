<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دُو</text></form>
</field>
<sense id="1fd96541-7496-4996-9088-ce1a9c65843f">
<grammatical-info value="Verb">
<trait name="type" value="inflAffix"/>
</grammatical-info>
<gloss lang="en"><text>verbal prefix, often used with ergative verbs.</text></gloss>
<gloss lang="ur-PK"><text>سابقہ جو بعض افعال کے ساتھ لگتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>ja haġor delʰtumana,  haġor iilja dulʰtumaní.</text></form>
<translation type="Free translation">
<form lang="en"><text>I returned the horse, the horse returned back. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja hun dixará, hun duxarí. </text></form>
<translation type="Free translation">
<form lang="en"><text>I split the wood. The wood got split. </text></form>
</translation>
</example>
</sense>
</entry>
