<entry dateCreated="2019-02-27T16:49:47Z" dateModified="2025-11-30T16:34:28Z" id="ball phaar (éćhüm,  mayüm)_febf08e9-8113-4c19-8a25-6f34590a2039" guid="febf08e9-8113-4c19-8a25-6f34590a2039">
<lexical-unit>
<form lang="bsk"><text>báll phaar -ćum</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<field type="literal-meaning">
<form lang="en"><text>mind spinning</text></form>
<form lang="ur-PK"><text>دماغ پھر جانا </text></form>
</field>
<relation type="_component-lexeme" ref="671d4c2e-2d3c-4d96-9b6c-a9ce56040758" order="0">
<trait name="is-primary" value="true"/>
<trait  name="complex-form-type" value="Phrasal Verb"/>
</relation>
<field type="IPA Burushaski">
<form lang="bsk"><text>bʌɫ pʰaːr -tʃum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بَڵ پھار -چُم</text></form>
</field>
<sense id="6c99c1b6-d48f-4642-b7e0-849cff95d41d">
<grammatical-info value="Idiom">
</grammatical-info>
<gloss lang="en"><text>bothering or bugging someone, spinning someone's brain</text></gloss>
<gloss lang="ur-PK"><text>کسی کا دماغ خراب کرنا۔</text></gloss>
<example>
<form lang="bsk"><text>ja doro yaṭe ba, báll phar ayaat (bo ka doġares)</text></form>
<translation type="Free translation">
<form lang="en"><text>I am at work, do not bug me. (by asking - whatever)</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2024-07-22T04:40:36Z" dateModified="2025-11-30T16:37:45Z" id="báll śećum_95a2d94f-4cb8-40f3-ac16-c94a0415199d" guid="95a2d94f-4cb8-40f3-ac16-c94a0415199d">
<lexical-unit>
