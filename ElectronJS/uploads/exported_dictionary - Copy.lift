</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-11-09T15:47:08Z" dateModified="2025-11-15T01:56:56Z" id="akhi ane_66db8c2b-c8b3-422a-a7b8-9f3ae973c065" guid="66db8c2b-c8b3-422a-a7b8-9f3ae973c065">
<lexical-unit>
<form lang="bsk"><text>akhii ane</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<trait name="do-not-publish-in" value="Idioms"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhi anɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکھی انےࣷ</text></form>
</field>
<sense id="7219ae7f-dd4c-4a6c-849e-aba5402c6b6a">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>Somewhere around here</text></gloss>
<gloss lang="ur-PK"><text>یہی کہیں</text></gloss>
<example>
<form lang="bsk"><text>we ses akhi ane baan, ja ġa llell apí. </text></form>
<translation type="Free translation">
<form lang="en"><text>Those people are somewhere around here, I have no knowledge. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-06T17:53:15Z" dateModified="2025-11-15T02:29:28Z" id="akhilʰc_d3d15e37-2769-4678-a938-ccf162a0c768" guid="d3d15e37-2769-4678-a938-ccf162a0c768">
