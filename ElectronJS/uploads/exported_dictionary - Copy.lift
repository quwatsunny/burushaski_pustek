<entry dateCreated="2020-07-25T07:37:34Z" dateModified="2025-10-08T01:12:46Z" id="ḍuqaḍaqa_0ccc8530-faec-49fc-919c-b21cbced6ec7" guid="0ccc8530-faec-49fc-919c-b21cbced6ec7">
