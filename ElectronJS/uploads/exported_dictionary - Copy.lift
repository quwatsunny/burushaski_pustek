<entry dateCreated="2022-05-14T22:38:29Z" dateModified="2026-01-01T04:06:57Z" id="ćaspan_48f598e4-e5ec-4f6d-b5c2-a47bcf0a5be0" guid="48f598e4-e5ec-4f6d-b5c2-a47bcf0a5be0">
<lexical-unit>
<form lang="bsk"><text>ćaspan</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>tʃaspan</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چسپان</text></form>
</field>
<sense id="e199e18b-5d8a-4cc3-9a0b-86ae6b536c59">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>A person skilled at setting traps or devising clever maneuvers in a game; a strategist, schemer, or crafty player who wins through planning, trickery, or tactical foresight.</text></gloss>
<gloss lang="ur-PK"><text>بازی گر،  چال باز</text></gloss>
<example>
<form lang="bsk"><text>ne ajo ćaspan hir bai. </text></form>
<translation type="Free translation">
<form lang="en"><text>He is such a crafty man. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-12-30T06:53:31Z" dateModified="2025-12-31T04:29:07Z" id="ćast_5ffe1106-1e1f-4c86-91ea-6401ceb8c05b" guid="5ffe1106-1e1f-4c86-91ea-6401ceb8c05b">
