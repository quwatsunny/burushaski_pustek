<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>aunt, father's sister</text></gloss>
<gloss lang="ur-PK"><text>پھوپھی یا ممانی</text></gloss>
<trait name ="semantic-domain-ddp4" value="4.1.9 Kinship"/>
</sense>
</entry>
