</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>laġor in Balti means at onceor quickly. </text></form>
</note>
<relation type="Compare" ref="ablaaq_2c5bc5be-e822-4881-92be-be0b18f16953"/>
