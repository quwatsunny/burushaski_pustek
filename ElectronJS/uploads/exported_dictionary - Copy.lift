<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بُٹ</text></form>
</field>
<sense id="7d717810-8b85-41fe-987a-d4d58f0e026b" order="0">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>(of an intensity) much, too much</text></gloss>
<gloss lang="ur-PK"><text>زیادہ، بہت</text></gloss>
<example>
<form lang="bsk"><text>buṭ ḍáṅ hun án</text></form>
<translation type="Free translation">
<form lang="en"><text>a much harder wood</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja buṭ dareś eća awulám.</text></form>
<translation type="Free translation">
<form lang="en"><text>I would not be able to endure much</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>nóṣ buṭ llaq ayet, depherʰćimi. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not shake the plant too much, it will root out.</text></form>
</translation>
</example>
</sense>
<sense id="be0750b9-8c6c-442f-9462-6740e431ac89" order="1">
<grammatical-info value="Quantifier">
</grammatical-info>
<gloss lang="en"><text>enough</text></gloss>
<gloss lang="ur-PK"><text>کافی</text></gloss>
<example>
<form lang="bsk"><text>ma sabaq buṭ senen, amutuk bo doro án etiṅ. </text></form>
<translation type="Free translation">
<form lang="en"><text>You have studied enough, now do some work (get a job). </text></form>
</translation>
</example>
</sense>
<sense id="62dde050-a60e-4045-ad91-970374085bcd" order="2">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>(of quality) very</text></gloss>
<gloss lang="ur-PK"><text>بہت </text></gloss>
<example>
<form lang="bsk"><text>buṭ mariṅ</text></form>
<translation type="Free translation">
<form lang="en"><text>of very good quality (mostly used for plural)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>buṭ śuwa hir.</text></form>
<translation type="Free translation">
<form lang="en"><text>A very fine man. </text></form>
</translation>
</example>
</sense>
<sense id="3a041098-f842-43e7-9f54-94b03218061d" order="3">
<grammatical-info value="Quantifier">
</grammatical-info>
<gloss lang="en"><text>(quantifier) a lot, multiple, too many</text></gloss>
<gloss lang="ur-PK"><text>بہت زیادہ، بہت سارے</text></gloss>
<example>
<form lang="bsk"><text>ja buṭ ćai ayimiyam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I would not drink tea a lot. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>tóo buṭ ses gaṭi manen, bo mani, bo llell. </text></form>
<translation type="Free translation">
<form lang="en"><text>A lot of people gathered over there — who knows what happened.</text></form>
</translation>
</example>
</sense>
</entry>
