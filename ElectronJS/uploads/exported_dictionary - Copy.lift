</field>
<sense id="665fd91e-8337-4623-8d08-f7226ebe7e86">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>pain, bruise, injury</text></gloss>
<gloss lang="ur-PK"><text>چوٹ، درد</text></gloss>
<example>
<form lang="bsk"><text>aren ćaṅ etam ba.  </text></form>
<translation type="Free translation">
<form lang="en"><text>I have hurt my hand. I have injured my hand. </text></form>
</translation>
</example>
<example>
