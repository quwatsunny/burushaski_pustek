<entry dateCreated="2020-01-02T17:58:08Z" dateModified="2025-12-29T21:41:35Z" id="ćakeṣ_dc5b5d2a-1ff1-4d6e-a8fa-f59780d85ef6" guid="dc5b5d2a-1ff1-4d6e-a8fa-f59780d85ef6">
<lexical-unit>
