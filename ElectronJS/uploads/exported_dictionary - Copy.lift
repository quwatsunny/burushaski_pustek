</entry>
<entry dateCreated="2022-05-18T01:36:49Z" dateModified="2025-10-08T01:12:46Z" id="ḍaṅa2_e0937aee-9cb4-4c38-bcbc-a851fe60cc78" guid="e0937aee-9cb4-4c38-bcbc-a851fe60cc78">
