<form lang="bsk"><text>hɛnɛ hɛna ʃaɫda</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ہنےࣷ ہیࣷنا شلٚداࣷ</text></form>
