</field>
<sense id="0ae4ef30-433a-4506-a4bb-e6f4b8be3f90">
<gloss lang="en"><text>(locative suffix) in  or within (something), through</text></gloss>
<gloss lang="ur-PK"><text>میں ، کسی  چیز کے وسط میں۔</text></gloss>
<example>
<form lang="bsk"><text><span lang="en">ganći khaṭa, ne hire renći,mo gus mo muren dullum, da mo gus mo murenći han asqór an bim.</span></text></form>
<translation type="Free translation">
<form lang="en"><text>On the way down, in the man's hand was the woman's hand and in the woman's hand there was a flower. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>bazarći khaṭa galí.</text></form>
<translation type="Free translation">
<form lang="en"><text>He went down through the market. </text></form>
</translation>
</example>
</sense>
</entry>
