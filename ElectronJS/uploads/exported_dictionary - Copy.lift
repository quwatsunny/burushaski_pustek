<entry dateCreated="2019-05-20T16:42:57Z" dateModified="2025-10-23T23:05:19Z" id="xaraṭi_159ebff7-2f8e-4219-a090-1a49aa2975ea" guid="159ebff7-2f8e-4219-a090-1a49aa2975ea">
<lexical-unit>
<form lang="bsk"><text>xaraṭi</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="exaraṭ_64926b49-5f78-4433-87fc-2652385d9fd1"/>
<relation type="Compare" ref="ćhar xaraśum_a09e441f-f6e6-4c74-86a4-a1490674f8e6"/>
<field type="Bound Word">
<form lang="en"><text> </text></form>
</field>
<field type="CAUS">
<form lang="bsk"><text>xaraṭ</text></form>
</field>
<field type="IPA Burushaski">
<form lang="bsk"><text>xaraʈi</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>خرَٹیࣷ</text></form>
</field>
<trait name="Possessors" value="P.PCTP: [-á,-í-ú,-én ]"/>
<sense id="92dc8ea0-92a0-4e9e-9a29-b5712e72629a">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>(of or with a paste or adhesive) stuck, binded, attached</text></gloss>
<gloss lang="ur-PK"><text>چپک گیا۔ لگ گیا، چسپا ں ہوگیا، جوڑ گیا</text></gloss>
<example>
<form lang="bsk"><text>daġo aren ce xaraṭi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The glue stuck with my hand. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>puśti xaraṭi</text></form>
<translation type="Free translation">
<form lang="en"><text>The cover (of the book) got binded. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hire ćhumar ćhumar ce exaraṭi. </text></form>
<translation type="Free translation">
<form lang="en"><text>That man binded the metal with the metal. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hire ćhumariṅ uhán ce exaraćai.</text></form>
<translation type="Free translation">
<form lang="en"><text>That man jointed the metals with each other.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ćhumariṅ uhán ce xaraćai. </text></form>
<translation type="Free translation">
<form lang="en"><text>The metals got stuck to each other. </text></form>
</translation>
</example>
</sense>
</entry>
