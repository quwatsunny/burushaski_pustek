</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="śumi, śumikuṣ_a6896742-224a-4f7d-be56-49e7beb47824"/>
<relation type="Compare" ref="śuwá_d2217c40-ae7d-4587-9d3e-93c801b8e4c2"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʃuwakuʂ</text></form>
