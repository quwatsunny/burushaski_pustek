<sense id="9a6a7fea-8c35-471f-870b-792874d52896">
<gloss lang="en"><text>somewhat, a little bit, at some point or  stage</text></gloss>
<gloss lang="ur-PK"><text>تھوڑا سا،  ذرا سا، ایک خاص حد یا  مقام تک </text></gloss>
<example>
<form lang="bsk"><text>bláśreén</text></form>
<translation type="Free translation">
<form lang="en"><text>at a later time, a bit late</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>kamreén khita ẓo</text></form>
<translation type="Free translation">
<form lang="en"><text>Come a little bit towards this side. (towards me)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne yareén akho diim bám</text></form>
<translation type="Free translation">
<form lang="en"><text>He had come here. at some point, in the past. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>khaṭreén</text></form>
<translation type="Free translation">
<form lang="en"><text>Somewhat towards the lower end</text></form>
</translation>
</example>
</sense>
</entry>
