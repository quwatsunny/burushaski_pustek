<translation type="Free translation">
<form lang="en"><text>The woman has wrapped her scarf around her neck. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>peṭek góṣa taali, holle ćhaġorum duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>Wrap you scarf around your neck, it is cold outside. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>wáṭ an yaṭe waśli etum se ṣár taali. </text></form>
<translation type="Free translation">
<form lang="en"><text>Wrap the grafted branch with a bark. </text></form>
</translation>
</example>
</sense>
</entry>
