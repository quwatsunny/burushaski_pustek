<gloss lang="ur-PK"><text>کسی چیز کا خشک ہوکر  سخت ہوجانا جیسے چمڑا </text></gloss>
</sense>
<sense id="d64cc3ab-f19c-48d6-b6f4-b016be951019" order="2">
<grammatical-info value="Adjective">
</grammatical-info>
