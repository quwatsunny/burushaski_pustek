<form lang="bsk"><text>tilisɛri</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>تِلیࣷ سیࣷری</text></form>
</field>
<sense id="58e85f17-c0a0-490d-98ce-73d397eda82e">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>long hanging bridge of twigs</text></gloss>
<gloss lang="ur-PK"><text>بید کی ٹہنیوں سے بنا پُل</text></gloss>
</sense>
</entry>
<entry dateCreated="2022-10-21T14:32:21Z" dateModified="2025-10-08T01:12:46Z" id="tilisum_f7cab5eb-8aeb-4f95-96fa-9ff7e69c33e5" guid="f7cab5eb-8aeb-4f95-96fa-9ff7e69c33e5">
<lexical-unit>
