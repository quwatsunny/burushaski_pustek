<sense id="4816b827-99c0-422b-bdf2-d0af6a20bb02" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>(of plowing oxen) teaming up for plowing.  A concept where an ox of one farmer is partnered with the ox of another farmer for plowing both farmers' fields. Such oxen are called /.gall,a haryo/</text></gloss>
<example>
<translation type="Free translation">
</translation>
</example>
</sense>
<sense id="b3e95040-25cd-452c-8c5a-6ee771766bf2" order="1">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>(of people) teaming up for a task</text></gloss>
<gloss lang="ur-PK"><text>کسی کام کےلیے  جُوڑ جانا۔  </text></gloss>
<example>
<form lang="bsk"><text>ses ġalla numa delʰk gic̣emen. </text></form>
<translation type="Free translation">
<form lang="en"><text>Having formed a team, people will put the manure in the field. </text></form>
</translation>
</example>
</sense>
</entry>
