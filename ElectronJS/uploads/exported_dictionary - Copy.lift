<entry dateCreated="2019-05-24T14:31:45Z" dateModified="2025-10-08T01:12:46Z" id="éa-_a4d3cb86-97ed-4896-a460-e691580c97a0" guid="a4d3cb86-97ed-4896-a460-e691580c97a0">
<lexical-unit>
<form lang="bsk"><text>eé-</text></form>
</lexical-unit>
<trait  name="morph-type" value="prefix"/>
<note>
<form lang="en"><text>In this type of causation, the causer directly or indirectly causes or helps in the action performed by the causee.  In a situation where the action is performed all by the causee, as an agent, the word  /d-waqal/ is added before the causative verb.   </text></form>
</note>
<relation type="Compare" ref="aá_75b12a71-f44a-4ee8-bed2-4544bb493275"/>
<relation type="Compare" ref="goó-_dffb160e-946a-42f3-ba6e-6abec90b3bba"/>
<relation type="Compare" ref="moó-_e7fe5243-b7dc-4b33-bcd2-ab6e48af205b"/>
<relation type="Compare" ref="meé_bc8508d4-c1d8-4708-a3cc-8a629691dfc0"/>
<relation type="Compare" ref="maá_9e96279d-3d13-4c44-bc35-e17e753ffcb0"/>
<relation type="Compare" ref="oó_a02a6bf8-66da-4272-be69-07d5e7cfe8d2"/>
<relation type="Compare" ref="d-waqall_b5f91854-eb6a-4a11-b7d1-75f195188ff4"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛɛ-</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اے</text></form>
</field>
<sense id="c497ca99-a831-493d-996f-6b2052d9858b">
<gloss lang="en"><text>Causative marker used with 3SG.hm.x </text></gloss>
<gloss lang="ur-PK"><text>سابقہ جو کاذیٹیو فعل کے لیے استعمال ہوتا ہے۔</text></gloss>
<example>
<form lang="bsk"><text>puṣ eébiśa</text></form>
<translation type="Free translation">
<form lang="en"><text>Help him take off the shirt. </text></form>
<form lang="ur-PK"><text>اُس کی قمیض اتارو یا اُتروادو</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>sithaar eéġar</text></form>
<translation type="Free translation">
<form lang="en"><text>make the <span lang="bsk">sithar (an instrument) play.</span></text></form>
<form lang="ur-PK"><text>ستار کو بجاو</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hir eéher. </text></form>
<translation type="Free translation">
<form lang="en"><text>Make the man cry.  </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hir deéwaqall mo gus moóher. </text></form>
<translation type="Free translation">
<form lang="en"><text>Have the man make the woman cry.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-24T15:00:49Z" dateModified="2025-10-08T01:12:46Z" id="éabisha1_f6e11410-e949-4c13-949e-2e872190eab6" guid="f6e11410-e949-4c13-949e-2e872190eab6">
