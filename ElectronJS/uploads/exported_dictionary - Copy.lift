<entry dateCreated="2025-12-19T00:21:06Z" dateModified="2025-12-19T17:24:35Z" id="bot_c08dbf66-9f61-4b53-bbb1-8ba2f7942af9" guid="c08dbf66-9f61-4b53-bbb1-8ba2f7942af9">
<lexical-unit>
<form lang="bsk"><text>bot</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The core word “bot” is a flexible interrogative/indefinite base. It becomes natural in speech only when inflected or paired with articles, because that’s what anchors its meaning in context.</text></form>
</note>
<relation type="Compare" ref="boté_32f8bc9e-8952-42b7-a10f-b8a5b9bbb63d"/>
<relation type="Compare" ref="botén_85dbd275-6624-47b7-866a-dc5fa828fcc4"/>
<trait name="do-not-publish-in" value="Idioms"/>
<sense id="b4a82e80-a797-489e-af60-95e59cfebebd">
<grammatical-info value="Pronoun">
</grammatical-info>
<gloss lang="en"><text>what something, who someone, why something</text></gloss>
<gloss lang="ur-PK"><text>کیا، کون، کیوں</text></gloss>
<example>
<form lang="bsk"><text>un bot en ba?</text></form>
<translation type="Free translation">
<form lang="en"><text>Who some person are you?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un bot en ba, goo gumuśi bot an bi?</text></form>
<translation type="Free translation">
<form lang="en"><text>Who some person are you, what something is in your hand?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un bota (bot + a) akhi bariṅ ećum ba?</text></form>
<translation type="Free translation">
<form lang="en"><text>For what (why) are you making such statements?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un bot an sena?</text></form>
<translation type="Free translation">
<form lang="en"><text>What something did you say?</text></form>
</translation>
</example>
</sense>
</entry>
