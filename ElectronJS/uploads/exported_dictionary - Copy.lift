</field>
<sense id="4811c6a2-eca5-4c91-8a41-7530ac56d882">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>shearing, cutting the wool off  (sheep or other animal)</text></gloss>
<gloss lang="ur-PK"><text>جانورں کے بال کاٹنا۔</text></gloss>
</sense>
</entry>
