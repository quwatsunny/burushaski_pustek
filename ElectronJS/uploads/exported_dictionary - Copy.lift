</example>
</sense>
</entry>
<entry dateCreated="2019-08-23T23:07:00Z" dateModified="2025-11-23T01:41:23Z" id="asuurum1_f6e37eba-cac2-4f26-8aca-32fd6424cc24" guid="f6e37eba-cac2-4f26-8aca-32fd6424cc24" order="1">
<lexical-unit>
<form lang="bsk"><text>asuurum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>

 -um is the ablative suffix, marking “from” or “out of.”
- Example: asuurum churum = “coming from nearby.” - asuur-a → “to near, toward proximity”
 -a is the directive/allative suffix, marking “to, toward.”  Example: asura galla = “went toward nearby.”
 - asuur talle → “around the nearness of something” - -talle  is a Postposition emphatic/extended locative marker, often lengthening the spatial sense.</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>asuːrum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اسُورُم </text></form>
</field>
<sense id="9a48758c-8e1d-4fb8-a195-19286b15cb31">
<grammatical-info value="Ablative (cum, um)">
</grammatical-info>
<gloss lang="en"><text>Ablative form of /asuur/, from a close range, from near</text></gloss>
<gloss lang="ur-PK"><text>نز دیک سے۔</text></gloss>
</sense>
</entry>
<entry dateCreated="2020-05-08T21:08:56Z" dateModified="2025-11-23T01:42:04Z" id="asuurum2_68cba266-7459-4d62-b306-fbfa7fd5f74f" guid="68cba266-7459-4d62-b306-fbfa7fd5f74f" order="2">
