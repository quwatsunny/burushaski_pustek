<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>losing 3SG.hm.x</text></gloss>
<gloss lang="ur-PK"><text>کسی چیز کو یا شخص کو کھو دینا۔ </text></gloss>
<example>
<form lang="bsk"><text>ja ne espalluyam ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I have lost him. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja aya belles espalluyam ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I have lost my sheep. </text></form>
</translation>
</example>
</sense>
