</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="yargá_59b91e6e-f1f3-4691-8943-d8c5005c7173"/>
<relation type="Compare" ref="gu3_49df2f16-582f-4958-85ab-c1b46e9396e3"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>yarguʈʂum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>یر گُڅُم</text></form>
</field>
<sense id="b65dbaeb-084a-423c-8499-f77185011990">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>chase down, run after 3PL.h.x</text></gloss>
<gloss lang="ur-PK"><text>پیچھا کرو ( ڈرا کر بھگانے یا  پکڑنے کی کوشش میں)</text></gloss>
<example>
<form lang="bsk"><text>qarʰqamuś guyargu</text></form>
<translation type="Free translation">
<form lang="en"><text>Chase or run after the chickens. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>urʰke cigiraa yargum bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The wolf is chasing the goats. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-01-31T05:33:49Z" dateModified="2025-10-28T14:29:32Z" id="yári_2222429b-d3bd-495b-91b2-dbe41e6e70a7" guid="2222429b-d3bd-495b-91b2-dbe41e6e70a7">
<lexical-unit>
<form lang="bsk"><text>yári</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text><span lang="bsk">Burushaski word yár, which means front, frontal or forward, is probably the root word for yári.</span></text></form>
</note>
<relation type="Compare" ref="ṣáxur_18e4f02c-e06f-446f-a2a4-5350d01fb6e1"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>yʌri</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>یریࣷ</text></form>
</field>
