<form lang="bsk"><text>bur tapari</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بُرتپاری</text></form>
</field>
<sense id="5cf931ef-608f-46d9-8d39-b114bb8a55a5">
<grammatical-info value="Noun Phrase">
</grammatical-info>
<gloss lang="en"><text>pinpoint accuracy, precision, extreme exactness.  It literally means split of a hair strand. </text></gloss>
<gloss lang="ur-PK"><text>انتہا درجے کی درستگی۔ </text></gloss>
<example>
<form lang="bsk"><text>un ajo chan sena. bur tapari éta. </text></form>
<translation type="Free translation">
<form lang="en"><text>You told the absolute truth.  You split the hair strand. </text></form>
</translation>
</example>
</sense>
</entry>
