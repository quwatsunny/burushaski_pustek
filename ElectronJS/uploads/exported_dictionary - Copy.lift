<example>
<form lang="bsk"><text>thiiś guman, xawu guṣim biyena.</text></form>
<translation type="Free translation">
<form lang="en"><text>Stay at one place, have been affected by  enterobius vermicularis.(Why are you keep moving)</text></form>
</translation>
</example>
</sense>
</entry>
