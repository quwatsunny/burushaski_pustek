<gloss lang="ur-PK"><text>نوک دار</text></gloss>
<example>
<form lang="bsk"><text>c̣ur -muśkiṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>The one with pointy nose. </text></form>
</translation>
</example>
