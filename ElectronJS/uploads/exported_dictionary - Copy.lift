<translation type="Free translation">
<form lang="en"><text>gather people and bring. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>hun dehemia gaṣc̣ et</text></form>
<translation type="Free translation">
<form lang="en"><text>collect wood and sell them</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>amboh rupyaya ḍ'ehemia gukhara ha andoyi.</text></form>
<translation type="Free translation">
<form lang="en"><text>Put together a lot of money and buy a house for yourself. </text></form>
</translation>
</example>
</sense>
</entry>
