</field>
<sense id="56eda822-39a5-4b08-b120-c30da5916bd3">
<grammatical-info value="Locative (ći, i)">
</grammatical-info>
<gloss lang="en"><text>in the pit</text></gloss>
<gloss lang="ur-PK"><text>(تِس) کے اندر</text></gloss>
<example>
