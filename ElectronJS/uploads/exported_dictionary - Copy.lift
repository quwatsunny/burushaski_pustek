</field>
<sense id="377a5404-a2fe-4b17-93db-d80a0f5d1fe8">
<gloss lang="en"><text>swiftly, snap-cut (especially used for cutting or deciding)</text></gloss>
<gloss lang="ur-PK"><text>ایک دم سے (کاتنے کےلیے استعمال ہوتا ہے)     </text></gloss>
<example>
<form lang="bsk"><text>śarʰpháṭ doro espás</text></form>
<translation type="Free translation">
<form lang="en"><text>Snap-cut the work (to settle)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ṭeṭe śarʰphat eskarʰc. </text></form>
<translation type="Free translation">
<form lang="en"><text>Snap cut the rope. </text></form>
</translation>
</example>
</sense>
</entry>
