<entry dateCreated="2024-05-04T03:14:45Z" dateModified="2025-10-30T14:24:04Z" id="n2_4ef72695-19d0-476c-9c6e-057db0113262" guid="4ef72695-19d0-476c-9c6e-057db0113262" order="1">
<lexical-unit>
<form lang="bsk"><text>n</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<trait name="do-not-publish-in" value="Idioms"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>n</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ن</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>+ verb</text></form>
</field>
<trait name="Possessors" value="O-Obligatorily Possessors"/>
<field type="PreVerb">
<form lang="bsk"><text>n-</text></form>
</field>
<sense id="1c1bf45f-aa7e-4fbd-b597-63fccc2db292">
<gloss lang="en"><text>converbal prefix, used with pronominal infixes, to signify an action completed, or due to be completed prior to another action by the same actor. </text></gloss>
<example>
<form lang="bsk"><text>ja too naa doro ećam. </text></form>
<translation type="Free translation">
<form lang="en"><text>After going there, I will work. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja un nukgudell gósqayam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I will beat you (first) and (then) kill you. </text></form>
</translation>
</example>
</sense>
</entry>
