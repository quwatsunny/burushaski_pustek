<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>this way, around here</text></gloss>
<gloss lang="ur-PK"><text>یہاں سے، یہاں پر </text></gloss>
<example>
<form lang="bsk"><text>Pholok akhii diim bám</text></form>
<translation type="Free translation">
