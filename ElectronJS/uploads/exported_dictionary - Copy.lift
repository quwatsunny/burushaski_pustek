<sense id="e2df8eda-a7b4-4e04-be28-999170f65efd" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>authority, power of authority, control, management</text></gloss>
<gloss lang="ur-PK"><text>ادھیکار، منجمنت، کنٹرول</text></gloss>
<example>
<form lang="bsk"><text>go jaa ayaṭe bo sáq apí. </text></form>
