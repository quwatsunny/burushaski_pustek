</example>
</sense>
</entry>
<entry dateCreated="2022-01-30T02:40:09Z" dateModified="2025-11-22T21:01:42Z" id="atohón_a0be10af-63dd-43d3-882f-556d16cce7c0" guid="a0be10af-63dd-43d3-882f-556d16cce7c0">
<lexical-unit>
<form lang="bsk"><text>atohón</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>- Devoiced form of adohon. - /a‑/ = negative prefix. -
- Alternation: /d/ ↔ /t/ in dohon → tohon. 
- Hence, atohón is a common surface form in usage. In a formal language, aidohon is used. </text></form>
</note>
<relation type="Compare" ref="aidohón_6f4bf737-0caf-4092-b3cc-5cc6a988337c"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>atohɔn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اتوࣷہوࣷن</text></form>
</field>
<sense id="80c18e4e-54bd-41f3-8fec-365490f6c1d0" order="0">
<gloss lang="en"><text>Do not hold.</text></gloss>
<gloss lang="ur-PK"><text>مت پکڑو،</text></gloss>
<example>
<form lang="bsk"><text>aren ce atohón. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not hold my hand. </text></form>
</translation>
</example>
</sense>
<sense id="450f8e56-b39c-4068-86ff-344a005fbf06" order="1">
<gloss lang="en"><text>Do not mess with, Do not tease</text></gloss>
<gloss lang="ur-PK"><text>مت چھیڑ و۔ </text></gloss>
<example>
<form lang="bsk"><text>ne halles ce atohón, herʰćimí. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not mess with the boy, (he) will cry. </text></form>
</translation>
</example>
</sense>
</entry>
