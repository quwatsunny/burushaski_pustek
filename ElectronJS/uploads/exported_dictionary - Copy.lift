<sense id="a147a398-33e6-41a5-9a2f-599b86d85773">
<grammatical-info value="Verb Phrases">
</grammatical-info>
<gloss lang="en"><text>getting to the sky, being very tall, growing tall</text></gloss>
<gloss lang="ur-PK"><text>لمبا ہونا،  اونچائی کی طرف بڑھتے جانا۔ </text></gloss>
<example>
<form lang="bsk"><text>Pholoke ne yé ayaśa duusum bai</text></form>
<translation type="Free translation">
<form lang="en"><text>That son of Pholok has grown up very tall. </text></form>
</translation>
</example>
</sense>
</entry>
