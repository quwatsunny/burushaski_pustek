<sense id="b13bc76c-1700-4c55-926e-6875ca7b8f12" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>penetration (into something), squish into</text></gloss>
<gloss lang="ur-PK"><text>کسی چیز کے اندر گُھساوࣷ</text></gloss>
<example>
