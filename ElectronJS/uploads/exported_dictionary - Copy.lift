<gloss lang="en"><text>enduring</text></gloss>
<gloss lang="ur-PK"><text>برداشت کرو</text></gloss>
<example>
<form lang="bsk"><text>c̣hama dareś et. </text></form>
<translation type="Free translation">
<form lang="en"><text>Endure the hunger. </text></form>
</translation>
</example>
