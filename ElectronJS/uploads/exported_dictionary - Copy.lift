<entry dateCreated="2019-09-17T21:29:14Z" dateModified="2025-11-06T22:20:22Z" id="ṭhuk_8d782d6c-bce3-4c06-bc68-c9dfe3f6bb2d" guid="8d782d6c-bce3-4c06-bc68-c9dfe3f6bb2d">
