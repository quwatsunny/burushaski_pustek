<sense id="94452d37-eb49-4c00-bc41-81869107b466">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>itching to start, absolutely ready, on the edge</text></gloss>
<gloss lang="ur-PK"><text>بالکل تیار۔</text></gloss>
<example>
<form lang="bsk"><text>khomo gus herʰća ćaqa ćaq bú. </text></form>
