</field>
<sense id="b153e3c3-a787-4f44-813a-6927ebc7b66a" order="0">
<gloss lang="en"><text>called, a short form of 'noxaten'</text></gloss>
<gloss lang="ur-PK"><text>کہہ کر</text></gloss>
<example>
<form lang="bsk"><text>Pholok no<span lang="en">x</span>a hir en  bám. </text></form>
<translation type="Free translation">
<form lang="en"><text>There was a man called Pholok</text></form>
</translation>
</example>
</sense>
<sense id="74f1cbcd-5977-4d02-959a-039c5bc459d1" order="1">
<gloss lang="en"><text>having said, after saying or telling</text></gloss>
<gloss lang="ur-PK"><text>کہہ کر</text></gloss>
<example>
<form lang="bsk"><text>tayi no<span lang="en">x</span>a (noxaten), iilja gali.</text></form>
<translation type="Free translation">
<form lang="en"><text>Having said that, he went back.</text></form>
</translation>
</example>
</sense>
<sense id="1bf94db4-53ae-427c-8e6d-d221aee45e48" order="2">
<gloss lang="en"><text>after saying (that or this)</text></gloss>
<gloss lang="ur-PK"><text>کہنے کے بعد</text></gloss>
<example>
<form lang="bsk"><text>ja nee ġa no<span lang="en">x</span>a daaya. </text></form>
<translation type="Free translation">
<form lang="en"><text>I returned after telling him</text></form>
</translation>
</example>
</sense>
</entry>
