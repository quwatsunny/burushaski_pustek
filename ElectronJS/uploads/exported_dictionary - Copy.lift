</field>
<sense id="15a816d8-6786-473e-b18a-028f3b019088">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>after making 2SG, after turning 2SG into, by making you, having you made</text></gloss>
<gloss lang="ur-PK"><text>بنا کر، بنانے کے بعد</text></gloss>
<example>
<form lang="bsk"><text>un gadero nokot, ot minyas bo ećam. </text></form>
<translation type="Free translation">
<form lang="en"><text>What am I going to do with the story, by making you go crazy. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-07-07T05:07:43Z" dateModified="2025-10-08T01:12:46Z" id="nomo-_e5a77b00-d833-486a-91ab-ab70db6baaa1" guid="e5a77b00-d833-486a-91ab-ab70db6baaa1">
<lexical-unit>
<form lang="bsk"><text>nomo-</text></form>
</lexical-unit>
<trait  name="morph-type" value="prefix"/>
<relation type="Compare" ref="ná-_cddd3c48-f0df-46b7-ada8-4807fd51abfb"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>nomo-</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>نموࣷ</text></form>
</field>
<sense id="5a4e4091-8eec-42d3-8fa8-d59b3d137ad3" order="0">
<grammatical-info value="V.">
<trait name="type" value="affix"/>
</grammatical-info>
<gloss lang="en"><text>verbal prefix used only with (3SG.hf). After having (something done)</text></gloss>
<gloss lang="ur-PK"><text>(عورت، مونث) کروانے کے بعد، دلوانے کے بعد</text></gloss>
<example>
<form lang="bsk"><text>goi moġa sabáq nomoosen híra uú. </text></form>
<translation type="Free translation">
<form lang="en"><text>Give your daughter hand to someone after having her get educated. </text></form>
</translation>
</example>
</sense>
<sense id="01825437-ed0a-4b81-adb8-666d39e3434d" order="1">
<grammatical-info value="V.">
<trait name="type" value="affix"/>
</grammatical-info>
<gloss lang="en"><text>by or in a certain manner (something is done or caused)</text></gloss>
<gloss lang="ur-PK"><text>(مونث، انسان) کرکے، بناکر</text></gloss>
<example>
<form lang="bsk"><text>mo gus nomooher muchuyen. </text></form>
<translation type="Free translation">
<form lang="en"><text>The woman was taken away while making her cry.  In this sense the crying was caused by someone or something. If the crying is not caused then the word /nuher/ will be used. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gús nuher gallú. </text></form>
<translation type="Free translation">
<form lang="en"><text>The woman went crying. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2025-06-24T23:28:39Z" dateModified="2025-10-08T01:12:46Z" id="nomoo_0e995b7f-ebf9-4e9a-8b11-87eb9f9eab25" guid="0e995b7f-ebf9-4e9a-8b11-87eb9f9eab25">
