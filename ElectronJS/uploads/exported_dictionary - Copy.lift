<translation type="Free translation">
<form lang="en"><text>This is some powerful person.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un akho izatiṅa huruṭ</text></form>
<translation type="Free translation">
<form lang="en"><text>You stay here with dignity. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo ġosanum muyekiṅa hire en bú. </text></form>
<translation type="Free translation">
<form lang="en"><text>She is a a woman with a long name. </text></form>
</translation>
</example>
</sense>
<sense id="1dfcc7f9-6482-423b-856b-9dd9c117b2bb" order="1">
<gloss lang="en"><text>with</text></gloss>
<gloss lang="ur-PK"><text>کے ساتھ</text></gloss>
<example>
<form lang="bsk"><text>neiṅa bariṅ net ne kaaṭ né</text></form>
<translation type="Free translation">
<form lang="en"><text>Go with him, after discussing (it) with him. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>jaaiṅa bariṅ et. </text></form>
<translation type="Free translation">
<form lang="en"><text>Speak with me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>weiṅa barig eṭ. </text></form>
<translation type="Free translation">
<form lang="en"><text>Speak with them. </text></form>
</translation>
</example>
</sense>
</entry>
