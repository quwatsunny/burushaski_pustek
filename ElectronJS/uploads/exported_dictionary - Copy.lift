<entry dateCreated="2020-04-30T21:52:36Z" dateModified="2025-09-10T00:04:15Z" id="mó_12d0fcef-f0ed-4dec-b425-0e02bcbfeb0f" guid="12d0fcef-f0ed-4dec-b425-0e02bcbfeb0f">
<lexical-unit>
<form lang="bsk"><text>mó</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>In Balti, mo means she, female.</text></form>
</note>
<relation type="Compare" ref="-sqan_c5b24e7b-70b0-4cc9-81cf-27573bdbdc20"/>
<relation type="Compare" ref="cé_e087a6f0-e376-4c94-ac4e-bbc9837e0403"/>
<relation type="Compare" ref="we_940d25ed-9da5-4688-ac89-236ae5745e2f"/>
<relation type="Compare" ref="sé3_4a442d31-e0bc-457f-8b36-57c2a26ec081"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>mɔ</text></form>
</field>
<sense id="cb00a801-46f2-4794-8fba-9a2974f33701" order="0">
<grammatical-info value="Pronoun">
</grammatical-info>
<gloss lang="en"><text>that lady, she</text></gloss>
<gloss lang="ur-PK"><text>وہ خاتون </text></gloss>
</sense>
<sense id="44664e46-29fe-445b-aa51-0cbc0527d48a" order="1">
<gloss lang="en"><text>Pronominal prefix for (hf, SG) It is also used as an infix in the d-form of the verbs such as /do-mo-ġaśi/ which means she found (it). Alternatively it is used as /mu/</text></gloss>
<example>
<form lang="bsk"><text>gusmo  momóqoṭ</text></form>
<translation type="Free translation">
<form lang="en"><text>The cheek of  the woman. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>gusmo muxat</text></form>
<translation type="Free translation">
<form lang="en"><text>The mouth of the woman.  </text></form>
</translation>
</example>
</sense>
<sense id="dc955d5c-c820-46e6-b9d2-caa27f4e7563" order="2">
<gloss lang="en"><text>used as Causative prefix for human female. </text></gloss>
<example>
<form lang="bsk"><text>mo gus móhuruṭ. </text></form>
<translation type="Free translation">
<form lang="en"><text>Make that woman sit. </text></form>
</translation>
</example>
</sense>
<sense id="c144fa4f-c011-401f-8d28-2accde9843d4" order="3">
<gloss lang="en"><text>Genitive case marker for (hf, SG.)</text></gloss>
<example>
<form lang="bsk"><text>gusmo gatu</text></form>
<translation type="Free translation">
<form lang="en"><text>The pants of the woman. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>Saimamo bar.</text></form>
<translation type="Free translation">
<form lang="en"><text>Saima's word.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-07T14:37:15Z" dateModified="2025-06-13T14:52:58Z" id="mo moġa_72de4c6b-945d-4e97-918c-cec2b42336bf" guid="72de4c6b-945d-4e97-918c-cec2b42336bf">
