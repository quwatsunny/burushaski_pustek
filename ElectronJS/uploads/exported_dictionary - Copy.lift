</field>
<sense id="04aae0f6-4b8d-4f97-afd4-efceb9d1f28b">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>A person who jumps in to get involved or do something, all the time, without the required  commitment or competence. pretentious</text></gloss>
<gloss lang="ur-PK"><text>نقلی شیر(تمثیلاً)</text></gloss>
<example>
<form lang="bsk"><text>ne pópot hir bai, ne ce baṣc̣ek ayet. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not trust him, he is a pretentious person. </text></form>
</translation>
</example>
</sense>
</entry>
