<entry dateCreated="2021-03-15T22:26:09Z" dateModified="2025-10-08T01:12:46Z" id="-darú_dbc02590-53f0-4787-8feb-0ec8c218a3b3" guid="dbc02590-53f0-4787-8feb-0ec8c218a3b3">
<lexical-unit>
<form lang="bsk"><text>-darú</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<relation type="Compare" ref="-sk-_a5f491e4-aff4-4ffd-9b25-c8838c1c8a09"/>
<relation type="Compare" ref="-śtarú_e8a24edf-b64f-4107-911c-523f489cc083"/>
<relation type="Compare" ref="-śku_de866746-5d28-4478-9399-77a01e3ff248"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-darʊ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دروࣷ</text></form>
</field>
<sense id="7166de18-5128-47f3-8eeb-ec3b953953f6">
<gloss lang="en"><text>plural suffix used with certain human roles, often ending with the consonant /n/</text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جوجمع  بنانے کے لیے  ایسے الفاظ کے ٓاخر میں آتا ہے جو انسانی رشتہ یا کردار کے حوالے سے ہو۔  </text></gloss>
<example>
<form lang="bsk"><text>saġon (saġon-daru)</text></form>
<translation type="Free translation">
<form lang="en"><text>nephew, niece (nephews, nieces)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ġeén, ġeénḍaru</text></form>
<translation type="Free translation">
<form lang="en"><text>thief, thieves</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>a<span lang="en">x</span>on, a<span lang="en">x</span>ondaru</text></form>
<translation type="Free translation">
<form lang="en"><text>a Shia religious role</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text><span lang="en">x</span>akin, <span lang="en">x</span>akindaru</text></form>
<translation type="Free translation">
<form lang="en"><text>daughter-in-law, daughters-in-law</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>rekendaru</text></form>
<translation type="Free translation">
<form lang="en"><text>brothers-in-law</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-14T14:13:21Z" dateModified="2025-10-08T01:12:46Z" id="darum_e482bef3-51a2-41e7-bde7-16ae6a148607" guid="e482bef3-51a2-41e7-bde7-16ae6a148607">
<lexical-unit>
<form lang="bsk"><text>darum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>→ Balti /darong/ means up to the time, up to now. </text></form>
</note>
<relation type="Compare" ref="aćhó_e2a6e4c2-f414-4968-840e-79a2ea8d5621"/>
<relation type="Compare" ref="dex_3e931d7b-2a6c-4f77-bead-92cda845e38e"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>darum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دَرُم</text></form>
</field>
<sense id="00d80ca6-3429-4a3b-8d3d-30ce30811e3d">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>as yet, until now, still</text></gloss>
<gloss lang="ur-PK"><text>تا حال، ابھی تک</text></gloss>
<example>
<form lang="bsk"><text>ne saaṭik dusúm bai, darum ka ḍis mayaġa aćho.</text></form>
<translation type="Free translation">
<form lang="en"><text>He has left yesterday but has not arrived yet.</text></form>
<form lang="ur-PK"><text>وہ کل نکلا ہے مگرابھی تک نہیں پہنچا ہے۔</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-03-24T04:39:52Z" dateModified="2025-10-08T01:12:46Z" id="darooskin_6c4299d4-d58d-406f-a1a8-66cd206784bf" guid="6c4299d4-d58d-406f-a1a8-66cd206784bf">
