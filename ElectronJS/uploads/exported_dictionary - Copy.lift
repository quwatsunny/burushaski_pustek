<entry dateCreated="2019-03-06T17:39:35Z" dateModified="2025-12-24T00:12:58Z" id="ćaap2_a7f50504-16c9-4813-a866-d31ef0682a87" guid="a7f50504-16c9-4813-a866-d31ef0682a87">
<lexical-unit>
<form lang="bsk"><text>caap</text></form>
</lexical-unit>
