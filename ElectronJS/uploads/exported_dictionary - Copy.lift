<entry dateCreated="2019-09-08T01:09:02Z" dateModified="2025-10-08T01:12:46Z" id="deépherkani1_9f0833bd-47ee-4e47-8334-60bd9a8fc701" guid="9f0833bd-47ee-4e47-8334-60bd9a8fc701">
<lexical-unit>
<form lang="bsk"><text>deépherkani</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>There is a difference between deepharkani and depherkani. The first one stresses on the stumbling as well as the fact that it was caused by something. The later just states the 3SG's stumbling.  </text></form>
</note>
<relation type="Compare" ref="depherkani_c5f00845-58c8-4387-9f8e-bee65712dff0"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>dɛɛpʰɛrkani</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دے پھیࣷرکنیࣷ </text></form>
</field>
<sense id="a94f38a9-b659-466d-bdec-9653d6d9f936">
<gloss lang="en"><text>(3SG,hm,x) got tripped </text></gloss>
<gloss lang="ur-PK"><text>اُسے ٹھوکر لگی</text></gloss>
<example>
<form lang="bsk"><text>ne hir dan ce deépherkan wali</text></form>
<translation type="Free translation">
<form lang="en"><text>Having tripped on stone, the man fell down. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>bap deépherkani. </text></form>
<translation type="Free translation">
<form lang="en"><text>The old man tripped. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-10-15T01:28:08Z" dateModified="2025-10-08T01:12:46Z" id="deépherkani2_97211f64-1cba-481b-8bf6-9a9ea1c48863" guid="97211f64-1cba-481b-8bf6-9a9ea1c48863">
