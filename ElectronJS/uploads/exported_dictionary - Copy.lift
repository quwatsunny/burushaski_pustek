<field type="IPA Burushaski">
<form lang="bsk"><text>akuhɛyʌm</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکُہیࣷیاࣷم</text></form>
</field>
<sense id="d4b47056-cab5-4a81-bfe0-7172fcfb0834">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>I will not recognize/know you</text></gloss>
<gloss lang="ur-PK"><text>میں آپ کو نہیں پہنچانوں گا۔ </text></gloss>
<example>
<form lang="bsk"><text>jan un akuheyam ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I do not recognize you. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>jimel daa guyeca ka akuheyam, ja till aalʰćam ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>If I see you tomorrow, I would not know you. I forget (things).</text></form>
</translation>
</example>
</sense>
</entry>
