<sense id="1cb7bf7c-e636-485e-8f12-c57b7c9e0c30">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>a lot of pus is called /darját/</text></gloss>
<gloss lang="ur-PK"><text>پہت زیادہ  پیپ</text></gloss>
<example>
<form lang="bsk"><text>baśa-baśa yurum ses cum darjat cherem duwá.</text></form>
<translation type="Free translation">
<form lang="en"><text>Sometimes, a lot of pus discharges from a dead person. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>darját buṭ mani ka te ġa siman. darʰt kam mayum duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>When it is less in quantity, they call it /darjat/. The dárʰt (puss) is less in quantity. </text></form>
</translation>
</example>
</sense>
</entry>
