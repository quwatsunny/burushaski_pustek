</field>
<sense id="79bac09c-0542-496f-96a3-224fb3402af4">
<gloss lang="en"><text>will, shall, suffix used with verb for future tense. </text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو فعل مستقبل کے لیے جہاں فائل اسم کی hf.SGکلاس ہو۔</text></gloss>
<example>
<form lang="bsk"><text>mo guse doro ećumu (et + ćumu)</text></form>
<translation type="Free translation">
<form lang="en"><text>That woman will do the work. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>goó nani goġa paqo ećumu. </text></form>
<translation type="Free translation">
<form lang="en"><text>Your mother will make food for you. </text></form>
</translation>
</example>
</sense>
</entry>
