<note>
<form lang="en"><text>Velarized/Pharyngealized l "Dark l" (YB)</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɫ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>لٚ</text></form>
</field>
<sense id="e2104e7e-9e80-406c-9d46-64d264b000c2">
<gloss lang="en"><text>Consonantal sound</text></gloss>
<gloss lang="ur-PK"><text>موٹا لام</text></gloss>
<example>
<form lang="bsk"><text>llóṭo</text></form>
<translation type="Free translation">
<form lang="en"><text>without hat/cap, bare head</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2025-08-30T15:57:14Z" dateModified="2025-11-12T00:35:45Z" id="lla_74922f19-4eae-455e-8c5a-07625a2d9416" guid="74922f19-4eae-455e-8c5a-07625a2d9416">
<lexical-unit>
<form lang="bsk"><text>lla</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="-ća_fbf6d6cf-f3d8-423f-93cc-88ed2f3a78c7"/>
<relation type="Compare" ref="-ġa_1ed28eb4-2cd7-46b1-9e75-a6936a7aff7e"/>
<relation type="Compare" ref="ca_71a6768c-c465-4f5f-9598-25394b2ae1fa"/>
<trait name="do-not-publish-in" value="Idioms"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɫa</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>لٚاࣷ</text></form>
</field>
<sense id="c5a7a376-54f3-4ebd-9e2d-e3eb4e2783d9">
<grammatical-info value="Dative (a, ġa)">
</grammatical-info>
<gloss lang="en"><text>Used as a Dative marker with some words such as /akho/ or /too/ which means here and there. </text></gloss>
<gloss lang="ur-PK"><text>کو (یہاں یا وہاں کے ساتھ لگتا ہے۔)</text></gloss>
<example>
<form lang="bsk"><text>ja  akholla (a + kho + lla) daaya.</text></form>
<translation type="Free translation">
<form lang="en"><text>I came (to) here. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un tolla (too + lla) gallá</text></form>
<translation type="Free translation">
<form lang="en"><text>You went (to) there. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-09-14T05:41:31Z" dateModified="2025-10-08T01:12:46Z" id="llaam_adc4e706-1bf0-470f-9e63-09d8c15b9a79" guid="adc4e706-1bf0-470f-9e63-09d8c15b9a79">
<lexical-unit>
<form lang="bsk"><text>llaam</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>In order to construct a verbal form, /et/ or /mani/ is used with /llaam/</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɫaːm</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>لٚام</text></form>
</field>
<sense id="68fb5ddb-1b85-4c4b-8b59-309bf3845543" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>halt or stoppage </text></gloss>
<gloss lang="ur-PK"><text>تھمنے کی یا رُکنے کی حالت</text></gloss>
<example>
<form lang="bsk"><text>diyaarʰćum llaam eti ka, mi cheran. </text></form>
<translation type="Free translation">
<form lang="en"><text>We will go when it stops raining. </text></form>
</translation>
</example>
</sense>
<sense id="dde6f9b3-6a6b-4680-8ba4-b2a0c103c0b2" order="1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>(of pain) relief, stoppage</text></gloss>
<gloss lang="ur-PK"><text>رُکاؤ، ٹھہراؤ</text></gloss>
<example>
<form lang="bsk"><text>llam mani. </text></form>
<translation type="Free translation">
<form lang="en"><text>It became /llam/. (It stopped)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>llam etí</text></form>
<translation type="Free translation">
<form lang="en"><text>It made it /llam/.(Something stopped it). </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>llaam eeti. </text></form>
<translation type="Free translation">
<form lang="en"><text>The relief or stoppage happened to 3SG.hm.x</text></form>
</translation>
</example>
</sense>
</entry>
