</field>
<sense id="173aafd5-d274-44c8-a6be-8f9d323e65b6" order="0">
<gloss lang="en"><text>suffix to form gerund or verbal nouns</text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو فعل کو اسم یا مصدر بنا تا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>girminćum musca duusi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The writing is done.</text></form>
</translation>
</example>
</sense>
<sense id="da54df34-f5ea-4427-896b-2ad805669472" order="1">
<gloss lang="en"><text>used with certain nouns as Ablative Case marker.</text></gloss>
<gloss lang="ur-PK"><text> لاحقہ  جو مفعول آلہ ہے</text></gloss>
<example>
<form lang="bsk"><text>nee xaćum (xat +ćum) duusum bar.</text></form>
<translation type="Free translation">
<form lang="en"><text>a word out of his mouth. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>tul bahaćum duusi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The snake came out of the hole. </text></form>
</translation>
</example>
<example>
</example>
</sense>
</entry>
