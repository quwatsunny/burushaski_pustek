<sense id="8499cd02-4dd3-4d89-9e28-95f9b2d1b315" order="0">
<gloss lang="en"><text>to kill</text></gloss>
<gloss lang="ur-PK"><text>مارنے کو</text></gloss>
<example>
<form lang="bsk"><text>ja ne esqaya awulam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I would not be able to kill him. </text></form>
</translation>
</example>
</sense>
<sense id="e2e4046a-5d70-40cc-800a-b36b8f9b96ac" order="1">
<gloss lang="en"><text>when killed, upon killing</text></gloss>
<gloss lang="ur-PK"><text>جب مارا،  مارنے کے بعد</text></gloss>
<example>
<form lang="bsk"><text>ne buzurg esqaya ho sese ajo omoós diya. </text></form>
<translation type="Free translation">
<form lang="en"><text>So the people got furious upon the killing of the saint. </text></form>
</translation>
</example>
</sense>
</entry>
