<entry dateCreated="2021-12-03T00:35:58Z" dateModified="2025-10-08T01:12:46Z" id="han1_731eb0d7-81e7-4b77-91b5-4b6f28fd02c5" guid="731eb0d7-81e7-4b77-91b5-4b6f28fd02c5">
<lexical-unit>
<form lang="bsk"><text>han</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>han</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ہَن</text></form>
</field>
<sense id="7e04af6e-92cc-48cb-882e-58093d6cf78c">
<gloss lang="en"><text>used as base for reciprocal pronoun that takes suffixation ma_, mi_, u_</text></gloss>
<example>
<form lang="bsk"><text>haġoraa uhán dellen.</text></form>
<translation type="Free translation">
<form lang="en"><text>The horses fought each other. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>sese uhán masqara eten.</text></form>
<translation type="Free translation">
<form lang="en"><text>People tricked each other. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mi mihán khoś eten.</text></form>
<translation type="Free translation">
<form lang="en"><text>We liked each other. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ma mahana bo seniṅ beé</text></form>
<translation type="Free translation">
<form lang="en"><text>You don't say anything to each other. </text></form>
</translation>
</example>
</sense>
</entry>
