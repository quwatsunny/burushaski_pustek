<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>call or invitation</text></gloss>
<gloss lang="ur-PK"><text>بُلاوا، دعوت</text></gloss>
<example>
<form lang="bsk"><text>guya tati ġa qau et. </text></form>
<translation type="Free translation">
<form lang="en"><text>Call your father. </text></form>
</translation>
</example>
</sense>
</entry>
