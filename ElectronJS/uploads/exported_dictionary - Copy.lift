<entry dateCreated="2019-05-27T16:24:33Z" dateModified="2025-11-12T16:10:05Z" id="aasqoli_5c05a9b6-8b66-420f-bfd2-a28dce4b1154" guid="5c05a9b6-8b66-420f-bfd2-a28dce4b1154">
<lexical-unit>
<form lang="bsk"><text>aasqoli</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>There is difference between /ásqoli/ and /aasqoli/.

 - Short /á/ = direct impact on the speaker - Long /aa/ = mediated impact, often through a possessed body part</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>aːsqoli</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>آسقوࣷلیࣷ</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>sqol</text></form>
</field>
<trait name="Possessors" value="O-Obligatorily Possessors"/>
<sense id="fa846c94-3c64-429a-a354-0854723716c2">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>(of a skin) tingled, burned up</text></gloss>
<gloss lang="ur-PK"><text> (مجھے ) جلن ہوا</text></gloss>
<example>
<form lang="bsk"><text>aren aasqoli</text></form>
<translation type="Free translation">
<form lang="en"><text>(it, something) tingled my hand</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus mo muren mosqoli. </text></form>
<translation type="Free translation">
<form lang="en"><text>It tingled the hand of that woman.  </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ma mareiṅ maasqoli. </text></form>
<translation type="Free translation">
<form lang="en"><text>(it) tingled your hands. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-27T16:25:14Z" dateModified="2025-11-12T16:13:51Z" id="aasqolʰćimi_b7fdfa40-be08-4bc9-bb51-7289894ab6cc" guid="b7fdfa40-be08-4bc9-bb51-7289894ab6cc">
