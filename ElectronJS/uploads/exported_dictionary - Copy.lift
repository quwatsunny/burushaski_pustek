<sense id="12dc3e10-60bc-45de-9245-d3876ded2605" order="0">
<grammatical-info value="Prohibitive">
</grammatical-info>
<gloss lang="en"><text>Do not do it. </text></gloss>
<gloss lang="ur-PK"><text>مت کرو۔ </text></gloss>
<example>
<form lang="bsk"><text>doro aiet</text></form>
<translation type="Free translation">
<form lang="en"><text>Do not do the work. </text></form>
</translation>
</example>
