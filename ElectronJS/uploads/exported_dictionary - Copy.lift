</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text> In Quotative speech, notice the Imperative verb <span lang="bsk">a</span>x<span lang="bsk">ațén</span> which means "Do not tell." </text></form>
</note>
<relation type="Compare" ref="axaten_dd0eab4e-32c1-4484-a3b5-39419d9d33bf"/>
