</sense>
</entry>
<entry dateCreated="2020-09-18T02:32:12Z" dateModified="2025-10-08T01:12:46Z" id="ḍyau_9ca1c9af-ceff-46f4-98d1-aa998a707754" guid="9ca1c9af-ceff-46f4-98d1-aa998a707754">
