<entry dateCreated="2019-09-08T03:38:36Z" dateModified="2025-10-08T01:12:46Z" id="dastá_9540eca4-b8ba-4c47-aa4a-88b0119c8112" guid="9540eca4-b8ba-4c47-aa4a-88b0119c8112">
<lexical-unit>
<form lang="bsk"><text>dastá</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>dastʌ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دستاۡ</text></form>
</field>
<sense id="667bdd04-ae22-4094-8f9f-14866b5d3d23" order="0">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>must</text></gloss>
<gloss lang="ur-PK"><text>ضرور</text></gloss>
<example>
<form lang="bsk"><text>teta goġa dasta ẓo senum bai.</text></form>
<translation type="Free translation">
<form lang="en"><text>Father has asked that you must come.</text></form>
</translation>
</example>
</sense>
<sense id="97f6eed8-1095-4deb-b774-276db8a29ef9" order="1">
<gloss lang="en"><text>for real, seriously</text></gloss>
<gloss lang="ur-PK"><text>حقیقتاً</text></gloss>
<example>
<form lang="bsk"><text>dasta daaya ka, paśano mayimi</text></form>
<translation type="Free translation">
<form lang="en"><text>If I come for real, it would be a disaster.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-10-09T22:23:53Z" dateModified="2025-10-08T01:12:46Z" id="dásta_9f630577-3c4a-4d2c-a11e-1657d3f62ad0" guid="9f630577-3c4a-4d2c-a11e-1657d3f62ad0">
<lexical-unit>
<form lang="bsk"><text>dásta</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text> -sta is bound stem which means stop or close.  ilʰći e-stai (3SG close PST 3SG eye).  Further, the Persian adjective /istada/ which means raised up seems to have its roots in this Burushaski word. </text></form>
</note>
<relation type="Compare" ref="désta1_b0c591c5-3568-4dd3-b033-83e23961c9ad"/>
<relation type="Compare" ref="estam1_34cf8737-ca1b-4eba-bbdb-675b6ba230a5"/>
<relation type="Compare" ref="dustam1_b31ffaef-72ad-47ee-b898-e2e16fb7f164"/>
<relation type="Compare" ref="dustai_9ca7b8ec-89e1-48d4-96c3-46a3c3c1b05a"/>
