<field type="IPA Burushaski">
<form lang="bsk"><text>-yʌn</text></form>
</field>
<sense id="c617cb16-c0c9-4672-8e73-58069321ad4c">
<gloss lang="en"><text>1PL will, a Suffix used to conjugate future form of certain imperatives, ending with the consonant /n/preceded by a vowel, where the action will be performed by 1PL.</text></gloss>
<gloss lang="ur-PK"><text>ہم کریں گے</text></gloss>
<example>
<form lang="bsk"><text>chán,  mi chayán</text></form>
<translation type="Free translation">
<form lang="en"><text>count,  we will count.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>dichán,mi dicháyán</text></form>
<translation type="Free translation">
<form lang="en"><text>straighten it,  we will straighten it. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un pharʰce dicikin, mi pharʰce dicikiyán</text></form>
<translation type="Free translation">
<form lang="en"><text>You hang the hat, we will hang the hat. </text></form>
</translation>
</example>
</sense>
</entry>
