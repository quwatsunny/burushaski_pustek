</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>In this context, 'ka' is primarily used in quotative speech.</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>ka</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>کہ</text></form>
</field>
<sense id="02a67662-4254-4dad-966e-cc3569b153cd">
<gloss lang="en"><text>That</text></gloss>
<gloss lang="ur-PK"><text>کہ</text></gloss>
<example>
<form lang="bsk"><text>nee seni ka, un akhuiṅ ayiẓo. </text></form>
<translation type="Free translation">
<form lang="en"><text>"Do not come", he said</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-13T00:18:51Z" dateModified="2025-10-08T01:12:46Z" id="ka1_c38946c6-397f-4885-a343-0ad52cfa5860" guid="c38946c6-397f-4885-a343-0ad52cfa5860">
