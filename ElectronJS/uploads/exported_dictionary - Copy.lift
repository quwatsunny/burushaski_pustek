<sense id="85a77e50-a00a-4e56-90f0-0a23caea9830">
<grammatical-info value="Idiom">
</grammatical-info>
<gloss lang="en"><text>Delegating tasks or giving orders to one another, rather than taking personal responsibility, often results in nothing getting done</text></gloss>
<gloss lang="ur-PK"><text>خود کرنے کی بجائے حکم دیتے رہنا۔ </text></gloss>
</sense>
</entry>
<entry dateCreated="2019-09-12T23:55:33Z" dateModified="2025-10-08T01:12:46Z" id="henzeér_708bfcdb-9e26-47fb-b33a-fc58e7272872" guid="708bfcdb-9e26-47fb-b33a-fc58e7272872">
<lexical-unit>
<form lang="bsk"><text>henzeér</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>hɛnzɛɛr</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ہیࣷنزیر</text></form>
</field>
<trait name="Review 1" value="202503051"/>
<sense id="99eedd31-2c58-4b32-bc7f-4bcae2dac283" order="0">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>one layer (bedsheets, clothes, socks etc)</text></gloss>
<gloss lang="ur-PK"><text>ایک  تہہ یا  جوڑا</text></gloss>
<example>
<form lang="bsk"><text>garumkuṣ duwa, henzeér guyaṭiki et.</text></form>
<translation type="Free translation">
<form lang="en"><text>It is hot, use one layer of upper bedding. </text></form>
</translation>
</example>
</sense>
<sense id="61ccc217-a21e-4ee9-a5b2-523816967d7b" order="1">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>all at once </text></gloss>
<gloss lang="ur-PK"><text>سب ایک ہی دفعہ</text></gloss>
<example>
<form lang="bsk"><text>paqo niṣi, henzeér khaṭ diyaśa neiṅ</text></form>
<translation type="Free translation">
<form lang="en"><text>(to a group of kids) After eating, get out all at once. </text></form>
</translation>
</example>
</sense>
<sense id="2a01dfbe-6b5b-4c3a-beb4-f0398c13212c" order="2">
<gloss lang="en"><text>single time, once</text></gloss>
<gloss lang="ur-PK"><text>ایک دفعہ</text></gloss>
<example>
<form lang="bsk"><text>gute henzeer go ġa siyam.</text></form>
<translation type="Free translation">
<form lang="en"><text>I will tell you this once </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-09-16T14:29:27Z" dateModified="2025-10-08T01:12:46Z" id="heqai_0861dc2e-7b54-4f00-afc0-0aec0e8ef1ec" guid="0861dc2e-7b54-4f00-afc0-0aec0e8ef1ec">
