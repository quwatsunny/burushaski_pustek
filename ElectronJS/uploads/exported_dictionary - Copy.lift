</field>
<sense id="1c36d46d-9bcb-4ca5-8957-5583ed67f02e">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>ample or sufficient, enough,  more or less of  what is required. </text></gloss>
<gloss lang="ur-PK"><text>کافی حد تک</text></gloss>
<example>
<form lang="bsk"><text><span lang="en">ja x</span>eli doro etam ba.</text></form>
<translation type="Free translation">
<form lang="en"><text>I have done sufficient work.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mii akhollum <span lang="en">x</span>eli ses holl diyaśamaan. </text></form>
<translation type="Free translation">
<form lang="en"><text>From our place (from here), enough people have gone abroad. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text><span lang="en">x</span>eli nupiraaq,  baq phat eṭi.</text></form>
<translation type="Free translation">
<form lang="en"><text>After sufficient digging, he abruptly abandoned.</text></form>
<form lang="ur-PK"><text>کا فی کھودائی کر نے کے بعد اُس نے اچانک چھوڑ دی۔ </text></form>
</translation>
</example>
</sense>
</entry>
