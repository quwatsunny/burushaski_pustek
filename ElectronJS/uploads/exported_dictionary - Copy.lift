</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چھر دےࣷ</text></form>
</field>
<field type="Plural Suffix">
<form lang="bsk"><text>iṅ</text></form>
</field>
<sense id="6c4437f8-f570-4b24-a0f4-6405fdff7067">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>(of horse) copulation, mating</text></gloss>
<gloss lang="ur-PK"><text>نر اور مادہ جانور خاص کر گھوڑے وغیرہ کا جنسی ملاپ</text></gloss>
<example>
<form lang="bsk"><text>se wall haġor behe haġor yaṭa ćharde gali</text></form>
<translation type="Free translation">
<form lang="en"><text>That male horse went on the female horse for copulation.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>haġor ćharde gali.</text></form>
<translation type="Free translation">
<form lang="en"><text>The horse went for copulation.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-02-04T23:29:27Z" dateModified="2026-01-02T17:33:29Z" id="ćharde ġa manyum_6a034ec0-4ec5-41ca-8006-3cddac397e1c" guid="6a034ec0-4ec5-41ca-8006-3cddac397e1c">
