<sense id="43d4949a-c6e4-4397-a054-d157dcbc5540">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>immediately, instantly, before one could take a seat.</text></gloss>
<gloss lang="ur-PK"><text>کھڑے کھڑے </text></gloss>
<example>
<form lang="bsk"><text>haalle ḍis amaya ya, kekaa ṭoroḍi yaṭe ćai án etu.</text></form>
<translation type="Free translation">
<form lang="en"><text>As soon as I arrived home, sister immediately made a tea for me. </text></form>
</translation>
</example>
</sense>
