<entry dateCreated="2021-04-27T19:25:50Z" dateModified="2025-11-12T21:57:50Z" id="aća_babe7a6c-cb91-470d-a0ae-472368f13854" guid="babe7a6c-cb91-470d-a0ae-472368f13854">
<lexical-unit>
<form lang="bsk"><text>áća</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>It is an Inflection form of the verb et (do or make it). The t of the et is assimilated to, -ća a suffix conveying the sense of 'upon making or doing'.</text></form>
</note>
<relation type="Compare" ref="guc̣_57703356-5f64-4f31-ba74-72e944131e5a"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>atʃa</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اچاࣷ</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>tća</text></form>
</field>
<trait name="Possessors" value="O-Obligatorily Possessors"/>
<sense id="48d20ab4-4895-464b-a9d3-32b70dfbcae7" order="0">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>When done or made 1SG</text></gloss>
<gloss lang="ur-PK"><text>(مجھے ) جب بنایا </text></gloss>
<example>
<form lang="bsk"><text>ja tati behell aća, ja xośan amána.</text></form>
<translation type="Free translation">
<form lang="en"><text>I became happy when my father blessed me. </text></form>
</translation>
</example>
</sense>
<sense id="a830684c-8db2-4aaa-ab7e-96264ee649e8" order="1">
<gloss lang="en"><text>to make or to do 1SG</text></gloss>
<gloss lang="ur-PK"><text>بنانے کی، کرنے کی (مجھے)</text></gloss>
<example>
<form lang="bsk"><text>un ja behell aća rai eta.</text></form>
<translation type="Free translation">
<form lang="en"><text>You intended to make me blessed.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un ja gadeéro aća rai etá.</text></form>
<translation type="Free translation">
<form lang="en"><text>You inclined to make me crazy.</text></form>
</translation>
</example>
</sense>
<sense id="b7735624-754d-4081-bd33-909bcde84776" order="2">
<gloss lang="en"><text>upon making or doing 1SG </text></gloss>
<gloss lang="ur-PK"><text> (مجھے) کرنے کے بعد، بنانے کے بعد </text></gloss>
<example>
<form lang="bsk"><text>ne ja  <span lang="en">x</span>óś aća, ja ne <span lang="en">x</span>oś éta. </text></form>
<translation type="Free translation">
<form lang="en"><text>I liked him when he liked me. </text></form>
</translation>
</example>
</sense>
</entry>
