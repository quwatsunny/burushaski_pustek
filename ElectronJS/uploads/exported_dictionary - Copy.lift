<relation type="Compare" ref="maá_9e96279d-3d13-4c44-bc35-e17e753ffcb0"/>
<relation type="Compare" ref="oó_a02a6bf8-66da-4272-be69-07d5e7cfe8d2"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>aʌ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>آ</text></form>
</field>
<sense id="a298b1ab-f059-4857-b8c1-6d5c094c0344">
<gloss lang="en"><text>Causative marker for 1SG. </text></gloss>
<example>
<form lang="bsk"><text>née ja dawaqall aágirmini. </text></form>
<translation type="Free translation">
<form lang="en"><text>He made me or help me write. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo guse ja aásmallú. </text></form>
<translation type="Free translation">
<form lang="en"><text>That lady made me scared. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-05-23T01:36:49Z" dateModified="2025-11-12T02:02:22Z" id="aab_16a431d0-0c5a-4d18-a0a9-46d95fc06fc9" guid="16a431d0-0c5a-4d18-a0a9-46d95fc06fc9">
