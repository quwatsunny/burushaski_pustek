<sense id="f48d2638-8323-4ad3-bd16-634f5c63f4bf" order="0">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>when concluded, when it was done</text></gloss>
<gloss lang="ur-PK"><text>جب ہوگیا</text></gloss>
<example>
<form lang="bsk"><text>doro khul mayaġa, ja daya.</text></form>
<translation type="Literal translation">
<form lang="en"><text>I came when the work ended.</text></form>
</translation>
</example>
</sense>
<sense id="a12008a6-1021-4979-a785-33b6737baf38" order="1">
<gloss lang="en"><text>to become</text></gloss>
<gloss lang="ur-PK"><text>ہونے کو</text></gloss>
<example>
<form lang="bsk"><text>ne hir gadeero mayaġa etum bai. </text></form>
<translation type="Free translation">
<form lang="en"><text>That man is about to become crazy. </text></form>
</translation>
</example>
</sense>
</entry>
