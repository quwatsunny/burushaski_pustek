<sense id="58054f4a-4765-490c-bcf4-02c53fb452aa" order="0">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>to become, what is due to become</text></gloss>
<gloss lang="ur-PK"><text>ہونے والا</text></gloss>
<example>
<form lang="bsk"><text>jimell mamu khúl maneaas duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>Tomorrow, the milk is (going) to finish. </text></form>
</translation>
</example>
</sense>
<sense id="98e6587f-139b-40ec-b173-21df4ddbe4d9" order="1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>possible, what can be done</text></gloss>
<gloss lang="ur-PK"><text>ممکن، ہو جو ہو سکتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>gute doro maneaas doro duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>This work/task is a possible(something that can be done) task. </text></form>
</translation>
</example>
</sense>
</entry>
