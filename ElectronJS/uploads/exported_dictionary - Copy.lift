<entry dateCreated="2021-08-30T00:24:48Z" dateModified="2025-10-08T01:12:46Z" id="nás1_2cad7ead-7aa0-473e-b9cc-201251d37a24" guid="2cad7ead-7aa0-473e-b9cc-201251d37a24">
<lexical-unit>
<form lang="bsk"><text>nás</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>Birds often abandon their chicks in the nest due to unknown survival or environmental risk that hey may perceive and this abandoning phenomenon is called 'nás'</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>nʌs</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>نس</text></form>
</field>
<sense id="9f16aafb-80ef-4094-b4da-f3584ad455be">
<gloss lang="en"><text>abdication, giving up, abandon </text></gloss>
<gloss lang="ur-PK"><text>ترک،  دستبرداری</text></gloss>
<example>
<form lang="bsk"><text>c̣hene iya ismo nás ótum bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The bird has abandoned its chicks. </text></form>
</translation>
</example>
</sense>
</entry>
