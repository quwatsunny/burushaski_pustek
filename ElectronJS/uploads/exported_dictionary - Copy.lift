<form lang="en"><text>Dance, the way you (always) dance. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne, ja lali, guśaaski, hek nuhu chell an duchú. </text></form>
<translation type="Free translation">
<form lang="en"><text>Go, son, run, the run that you are known for, and fetch me  (a glass of) water.</text></form>
</translation>
</example>
</sense>
</entry>
