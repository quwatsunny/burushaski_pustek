</field>
<sense id="6030ddc8-cc24-404e-80d1-fb135f8cba47" order="0">
<grammatical-info value="V.">
<trait name="type" value="affix"/>
</grammatical-info>
<gloss lang="en"><text>having (2SG) caused or made (doing something). </text></gloss>
<example>
<form lang="bsk"><text>ja nokosqan ḍaṅ goćam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I will bury you after having you killed. </text></form>
</translation>
</example>
</sense>
<sense id="f4ba2e3c-573a-4ddd-bf35-6e5e00457140" order="1">
<grammatical-info value="V.">
<trait name="type" value="affix"/>
</grammatical-info>
<gloss lang="en"><text>After making 2SG do something. </text></gloss>
<gloss lang="ur-PK"><text>(آپ سے ) کروانے کے بعد</text></gloss>
<example>
<form lang="bsk"><text>ja triṅ nokoser gosqayam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I will kill by making you eat yogurt. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-12-11T01:56:54Z" dateModified="2025-10-08T01:12:46Z" id="nokót_b35a6ff6-804a-43fa-b682-02109656ba2e" guid="b35a6ff6-804a-43fa-b682-02109656ba2e">
<lexical-unit>
