<entry dateCreated="2020-05-27T07:36:24Z" dateModified="2025-11-12T15:12:43Z" id="aameén_f93bc106-56e8-45ec-9691-5664094946a7" guid="f93bc106-56e8-45ec-9691-5664094946a7" order="2">
<lexical-unit>
<form lang="bsk"><text>ameén</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>

SEMANTIC NOTE:
- ameén implies indirect assistance—such as preparing, offering, or arranging the drink. 
- aamen, by contrast, implies direct physical help, such as bringing the drink to someone’s mouth. This subtle distinction reflects degrees of agency and proximity in the act of helping, and may vary by context or dialect.</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>aːmɛɛn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>آمیࣷن</text></form>
</field>
<field type="Plural Suffix">
<form lang="bsk"><text>iṅ</text></form>
</field>
<sense id="bf4e1204-55f9-46ca-8b38-73c1d795415b">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>Help me drink some (by arranging or providing the drink)</text></gloss>
<gloss lang="ur-PK"><text>کچھ پلاؤ </text></gloss>
<example>
<form lang="bsk"><text>ja ġa ćai an ameen ka ja cheraam. </text></form>
<translation type="Free translation">
<form lang="en"><text>Get me some team, I will go, after drinking it. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2024-11-27T03:12:36Z" dateModified="2025-11-16T15:56:52Z" id="ameet_2237745a-32bc-45b5-a5e5-f4d4eb11ae1e" guid="2237745a-32bc-45b5-a5e5-f4d4eb11ae1e">
