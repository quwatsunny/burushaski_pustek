<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>(of noun class hf) having come, after coming, by coming</text></gloss>
<gloss lang="ur-PK"><text>(خاتون کے لیے ) آکر، آنے کے بعد</text></gloss>
