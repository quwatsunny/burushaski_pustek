<entry dateCreated="2019-04-27T14:43:29Z" dateModified="2025-11-12T00:35:41Z" id="akholla_11c59245-27f5-4297-bb6d-1c551903c153" guid="11c59245-27f5-4297-bb6d-1c551903c153">
<lexical-unit>
<form lang="bsk"><text>akholla</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="khoo_0154950e-a2ce-44a8-b32b-efd2b050085b"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhoɫa</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکھوࣷڵہ</text></form>
</field>
<sense id="0d89a6d8-39e1-42d8-8376-999a2ee49f54">
<grammatical-info value="Dative (a, ġa)">
</grammatical-info>
<gloss lang="en"><text>to here, over here </text></gloss>
<gloss lang="ur-PK"><text>یہاں ، اس جانب</text></gloss>
<example>
<form lang="bsk"><text>ne akholla deéri. </text></form>
<translation type="Free translation">
<form lang="en"><text>Send him over here. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-26T04:33:22Z" dateModified="2025-11-15T02:46:10Z" id="akhollum_d2d45969-ff1f-41e0-b376-c7781cc01500" guid="d2d45969-ff1f-41e0-b376-c7781cc01500">
<lexical-unit>
<form lang="bsk"><text>akhollum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>
a-kho-lle-um (4 morphemes)

a → Proximal prefix  (apaći, akho, asarʰce etc)
kho → here (khos, khot )
lle → at  (holle, uulle )
um → Ablative suffix 
</text></form>
</note>
<relation type="Compare" ref="khollum_b6baf0b6-70a1-49ee-95a5-3cc36ba9fea6"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhoɫum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکھوࣷڵُم </text></form>
</field>
<sense id="bdc771fe-148a-4374-88dc-7d36fd3a44b6">
<grammatical-info value="Ablative (cum, um)">
</grammatical-info>
<gloss lang="en"><text>from here, from this place</text></gloss>
<gloss lang="ur-PK"><text>یہاں سے </text></gloss>
<example>
<form lang="bsk"><text>akhollum toólla</text></form>
<translation type="Free translation">
<form lang="en"><text>From here to there. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>gute doro akhollum yara mene aietum baan. </text></form>
<translation type="Free translation">
<form lang="en"><text>Nobody has done this ever before (before this point right now)</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-03-18T03:03:04Z" dateModified="2025-11-15T03:24:17Z" id="akhüing_1959ecb7-c977-441d-86c0-6efda9898d83" guid="1959ecb7-c977-441d-86c0-6efda9898d83">
<lexical-unit>
<form lang="bsk"><text>akhuiṅ</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>a → Proximal prefix, is sometimes omitted. It is common to hear native speakers using /khuiṅ/.- The a- prefix functions as a bound morpheme—a temporal deictic marker.</text></form>
</note>
<relation type="Compare" ref="maaṭo_dd8702de-565c-47b1-8674-76f15839e1df"/>
<relation type="Compare" ref="jimell_b0b201f9-616a-48d6-afbe-9f44a1a759a5"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhuiŋ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکُھئݩ</text></form>
</field>
<sense id="7259edbc-8df0-4b47-a88d-72548fff09d7">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>today</text></gloss>
<gloss lang="ur-PK"><text>آج</text></gloss>
<example>
<form lang="bsk"><text>akhuiṅ bo gúnz duwa?</text></form>
<translation type="Literal translation">
<form lang="en"><text>What is the day today?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>khuiṅ ja bo goski daaya. </text></form>
<translation type="Free translation">
<form lang="en"><text>How did I came to your memory today? (How come, you remembered me today)</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-26T04:41:57Z" dateModified="2025-11-16T02:28:24Z" id="akhuiṅ cum_53e61c39-4b99-4f73-a55b-195c56831756" guid="53e61c39-4b99-4f73-a55b-195c56831756">
<lexical-unit>
<form lang="bsk"><text>akhuiṅ cum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhuiŋ tsum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکُھئݩ ڎُم </text></form>
</field>
<sense id="5738a1ef-ff21-4995-8849-947d30d76811">
<grammatical-info value="Ablative (cum, um)">
</grammatical-info>
<gloss lang="en"><text>from today</text></gloss>
<gloss lang="ur-PK"><text>آج کے بعد، آج سے</text></gloss>
<example>
<form lang="bsk"><text>akhuiṅ cu iilja mi goġa bo siyan bee. </text></form>
<translation type="Free translation">
<form lang="en"><text>Today onward we will not say anything to you. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-08-26T16:29:02Z" dateModified="2025-11-16T02:29:46Z" id="akhurum_1745bfd2-26e3-42ab-8c0b-efe093586f80" guid="1745bfd2-26e3-42ab-8c0b-efe093586f80">
<lexical-unit>
<form lang="bsk"><text>akhurum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>This is a quantifier (proximal determiner)</text></form>
</note>
<relation type="Compare" ref="tawurum_238d0934-5af3-4227-ab69-85129a3d3be1"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhurum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکُھرُم</text></form>
</field>
<sense id="230cb847-16a1-4440-8e55-7a32c3fade5f">
<grammatical-info value="Determiner">
</grammatical-info>
<gloss lang="en"><text>this much, as much as this</text></gloss>
<gloss lang="ur-PK"><text>اس جتنا، اتنا</text></gloss>
<example>
<form lang="bsk"><text>akhurum goġa siyam. </text></form>
<translation type="Free translation">
<form lang="en"><text>This much I will tell you. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-30T05:05:10Z" dateModified="2025-11-16T02:30:34Z" id="akhurum án_5a564370-ac75-4c4b-8b6b-9c2f6f06ec50" guid="5a564370-ac75-4c4b-8b6b-9c2f6f06ec50">
<lexical-unit>
<form lang="bsk"><text>akhurum án</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="tawurum án_202cf3f4-77ba-4157-8b16-12e560781f0b"/>
<relation type="Compare" ref="beérum2_5cc47af7-3b86-45b6-9e02-99b47aafb858"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhurum ʌn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکُھرُ مَن</text></form>
</field>
<sense id="037dfd04-72c9-4953-a5c7-24f9e4e4771f">
<grammatical-info value="Determiner">
</grammatical-info>
<gloss lang="en"><text>so much, this much, these many</text></gloss>
<gloss lang="ur-PK"><text>اتنا کچھ، اتنے۔ </text></gloss>
<example>
<form lang="bsk"><text>akhurum an ses akho duum bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>These many people had come here. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-02-15T04:46:23Z" dateModified="2025-11-16T02:31:01Z" id="akhuruma_84760978-a2c2-467d-a680-5247d1d80a13" guid="84760978-a2c2-467d-a680-5247d1d80a13">
<lexical-unit>
<form lang="bsk"><text>akhuruma</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhuruma</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکُھرُماۡ</text></form>
</field>
<sense id="1c0c5b1a-aee8-4805-843a-5b24645f47d0" order="0">
<grammatical-info value="Determiner">
</grammatical-info>
<gloss lang="en"><text>by then, meanwhile, by this much said</text></gloss>
<gloss lang="ur-PK"><text>اتنے میں </text></gloss>
<example>
<form lang="bsk"><text>akhuruma, hir en dall duusi </text></form>
<translation type="Free translation">
<form lang="en"><text>By then, a man showed up. </text></form>
</translation>
</example>
</sense>
<sense id="68aaed9f-f815-4b3a-8785-e2364dc35322" order="1">
<gloss lang="en"><text>to (quantity) of this much</text></gloss>
<gloss lang="ur-PK"><text>اتنی (قیمت) میں</text></gloss>
<example>
<form lang="bsk"><text>guse akhuruma goġa gaṣc̣ ećam.</text></form>
<translation type="Free translation">
<form lang="en"><text>I will sell it for this much (of price)</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-07-13T03:09:27Z" dateModified="2025-11-16T02:37:29Z" id="akhurumes_750d5370-7ce6-4e1c-b8cd-a88f2eff3c6e" guid="750d5370-7ce6-4e1c-b8cd-a88f2eff3c6e">
<lexical-unit>
<form lang="bsk"><text>akhurumes</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhurumɛs</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکُھرُمیࣷس</text></form>
</field>
<sense id="9ebd72dc-6120-4d7d-9739-103c8603f89e">
