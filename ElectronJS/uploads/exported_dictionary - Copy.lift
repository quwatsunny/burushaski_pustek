<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>putting roof (on a construction)</text></gloss>
<gloss lang="ur-PK"><text>(چھت) ڈالنا </text></gloss>
<example>
<form lang="bsk"><text>jaa há deéxoṭallas duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>My house needs to be covered (with the roof)</text></form>
</translation>
</example>
</sense>
</entry>
