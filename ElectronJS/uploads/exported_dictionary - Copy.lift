<sense id="852e833b-a7e1-4b75-ab2e-a3b8c6b8e655" order="0">
<gloss lang="en"><text>noteworthy, mentionable</text></gloss>
<gloss lang="ur-PK"><text>قابل ذکر یا ضروری</text></gloss>
<example>
<form lang="bsk"><text><span lang="en">x</span>aas bo doro apim, ja un guyeśa daayam bam. . </text></form>
<translation type="Free translation">
<form lang="en"><text>I had come to see you, not for anything of mentionable.  </text></form>
</translation>
</example>
</sense>
<sense id="9cbdbf7c-a57e-4b26-abb8-237d88a9019c" order="1">
<gloss lang="en"><text>noteworthy, mentionable</text></gloss>
<gloss lang="ur-PK"><text>قابل ذکر بات، اچھی بات </text></gloss>
<example>
<form lang="bsk"><text>go <span lang="en">x</span>aasdoro khull etum bastuma. Ja aćhuo.</text></form>
<translation type="Free translation">
<form lang="en"><text>You have finished your work (it is a good thing),  I am yet to do. (which is not good)</text></form>
</translation>
</example>
</sense>
</entry>
