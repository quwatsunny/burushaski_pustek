</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-15T14:36:49Z" dateModified="2026-01-02T02:23:59Z" id="ćhaġorumi_77e44ae7-8f2e-454d-a240-cc3c88af2967" guid="77e44ae7-8f2e-454d-a240-cc3c88af2967">
