<entry dateCreated="2019-11-02T01:33:59Z" dateModified="2025-12-13T17:07:13Z" id="buiki_7d6c9780-530a-4bb1-b084-dad0d02ea9c9" guid="7d6c9780-530a-4bb1-b084-dad0d02ea9c9">
<lexical-unit>
<form lang="bsk"><text>buiki</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="boin_71a46b40-e5ca-4c07-b283-2ecc6e8ff02b"/>
<relation type="Compare" ref="diyeki_c49d0d84-938c-40f6-8e53-9b661002c2a4"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>buiki</text></form>
