<form lang="bsk"><text>koɫo</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>کولٚوࣷ</text></form>
</field>
<sense id="40158cc9-a987-48b3-a7f8-9f7566e48fd1">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>even, as well</text></gloss>
<gloss lang="ur-PK"><text>بھی </text></gloss>
<example>
<form lang="bsk"><text>ma sesiṅa bariṅ ećumaan kollo, jaa te ka api</text></form>
<translation type="Free translation">
<form lang="en"><text>You even talk with the people, I do not even have that. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un aidokoya kolla ka, ses ẓoaaśu baan. </text></form>
<translation type="Free translation">
<form lang="en"><text>Even if you do not come, people are going to come. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-17T18:12:04Z" dateModified="2025-10-08T01:12:46Z" id="kollo ka_a60a3961-6ee6-49a6-b3cc-b9406539500d" guid="a60a3961-6ee6-49a6-b3cc-b9406539500d">
<lexical-unit>
<form lang="bsk"><text>kollo ka</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
