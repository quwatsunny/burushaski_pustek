<entry dateCreated="2019-10-26T04:10:38Z" dateModified="2025-10-08T01:12:46Z" id="saan_11ad64b6-9aae-4b4b-99f7-3639d5ad3785" guid="11ad64b6-9aae-4b4b-99f7-3639d5ad3785">
<lexical-unit>
<form lang="bsk"><text>saan</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>BUR ← sa an ( a sun, some sunlight or sun)</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>saːn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>سان</text></form>
</field>
<sense id="9aba2593-a68e-4c60-b36e-4e33df9d3b91">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>a week ago or few days (ago)</text></gloss>
<gloss lang="ur-PK"><text>ایک ہفتہ یا کچھ دن پہلے</text></gloss>
<trait name ="semantic-domain-ddp4" value="8.4 Time"/>
</sense>
</entry>
<entry dateCreated="2019-10-26T04:11:11Z" dateModified="2025-10-08T01:12:46Z" id="saan-saan_8f207dcd-c97e-4d27-a68c-fa6df931a086" guid="8f207dcd-c97e-4d27-a68c-fa6df931a086">
<lexical-unit>
<form lang="bsk"><text>saan-saan</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>This term does not contain any morpheme directly associated with the concept of "day." Its etymological root lies in sá, which signifies "sun"—a symbolic representation of daylight rather than the temporal unit of a day itself.  BUR ← sá (sun)</text></form>
</note>
<relation type="_component-lexeme" ref="9aba2593-a68e-4c60-b36e-4e33df9d3b91" order="0">
<trait name="is-primary" value="true"/>
<trait  name="complex-form-type" value="Inflection"/>
</relation>
<field type="IPA Burushaski">
<form lang="bsk"><text>saːn-saːn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>سان سان</text></form>
</field>
<sense id="50a54dbc-8092-4a95-a7b2-a420a0ca56aa">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>few weeks ago</text></gloss>
<gloss lang="ur-PK"><text>کچھ ہفتے پہلے</text></gloss>
<example>
<form lang="bsk"><text>ja ne saan-saan hek an yecam bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I had seen him a few days ago. </text></form>
</translation>
</example>
<trait name ="semantic-domain-ddp4" value="8.4 Time"/>
</sense>
</entry>
