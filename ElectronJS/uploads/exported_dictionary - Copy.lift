<example>
<form lang="bsk"><text>brayu turyaṅ bicum. ceé turyaṅ galjayen. </text></form>
<translation type="Free translation">
<form lang="en"><text>The rams had horns, they broke the horns.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2025-12-22T15:24:28Z" dateModified="2025-12-22T15:27:17Z" id="ceé cum_fde4b5de-a63f-4500-ba9f-7af1e8167c86" guid="fde4b5de-a63f-4500-ba9f-7af1e8167c86">
