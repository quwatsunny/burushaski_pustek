<sense id="db57ef82-db31-4f87-987b-dfbaf3f4b671" order="0">
<grammatical-info value="Genitive (e)">
</grammatical-info>
<gloss lang="en"><text>of 3PL.x, of those</text></gloss>
<gloss lang="ur-PK"><text>اُن کا</text></gloss>
<example>
<form lang="bsk"><text>brayu turyaṅ bicum, ceé turyaṅ galjai. </text></form>
<translation type="Free translation">
<form lang="en"><text>The rams had horns, their horns broke. </text></form>
</translation>
</example>
