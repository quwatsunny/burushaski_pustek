</translation>
</example>
<trait name ="semantic-domain-ddp4" value="1.1 Sky"/>
</sense>
</entry>
<entry dateCreated="2019-03-31T15:45:42Z" dateModified="2025-11-23T01:02:28Z" id="ayash galhchüm_8005c036-7097-4b0e-bbe6-80913b6a9f81" guid="8005c036-7097-4b0e-bbe6-80913b6a9f81">
<lexical-unit>
<form lang="bsk"><text>ayaś galʰćum</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ayaʃ galʰtʃum</text></form>
</field>
