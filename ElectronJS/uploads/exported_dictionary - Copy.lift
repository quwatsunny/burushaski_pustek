<example>
<form lang="bsk"><text>un ja ayachár. </text></form>
<translation type="Free translation">
<form lang="en"><text>You walk me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja guren ce dohón goyachárʰćam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I will walk you (around), by holding your hand. </text></form>
</translation>
</example>
</sense>
</entry>
