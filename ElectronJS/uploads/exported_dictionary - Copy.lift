<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>خپ</text></form>
</field>
<field type="Plural Suffix">
<form lang="bsk"><text>iṅ</text></form>
</field>
<sense id="89081ff7-c3f8-4bd0-8e76-1c55a03b68e3">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>dry substance scrapped from the stem of a herbaceous plant. The substance is burned directly on human skin to manage some ailments or aches. </text></gloss>
</sense>
</entry>
<entry dateCreated="2020-07-20T19:12:02Z" dateModified="2025-10-23T21:10:21Z" id="xáp1_826fea78-9c47-48ff-8640-051f8971fa9f" guid="826fea78-9c47-48ff-8640-051f8971fa9f" order="2">
<lexical-unit>
