<entry dateCreated="2019-09-02T23:27:10Z" dateModified="2026-01-04T02:14:28Z" id="-um3_da013f3a-b2cc-4c9b-b66e-b0be64f59c8e" guid="da013f3a-b2cc-4c9b-b66e-b0be64f59c8e">
<lexical-unit>
<form lang="bsk"><text>-um</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<relation type="Compare" ref="-ćum_0022d583-ffc3-451f-ab44-8e9cb21d1db1"/>
<relation type="Compare" ref="ćharʰćum_01f543c1-5c4a-45b4-b28c-6b64b62dffd8"/>
<relation type="Compare" ref="dállum_fd0a5fd5-2dd8-4db6-9f6a-6396a0f85f74"/>
<relation type="Compare" ref="anüm_1a1b36ad-7886-4ec3-a4bc-a15bdb8ebc90"/>
<relation type="Compare" ref="datukium_7101ba07-4fca-4aa3-97c3-ea086c35e4d5"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-um</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اُم</text></form>
</field>
<sense id="38bab158-3757-40a4-acff-6be8bedf84f8">
<gloss lang="en"><text>Ablative (ABL) case marker, from ( an origin, point,  space or time)</text></gloss>
<gloss lang="ur-PK"><text>کسی جگہ سے ، کسی مقام سے۔ کسی نقطہ سے۔  </text></gloss>
<example>
<form lang="bsk"><text>Yásin (Yásin + um).</text></form>
<translation type="Free translation">
<form lang="en"><text>from Yasin</text></form>
<form lang="ur-PK"><text>یسیࣷن  سے</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>Pakistanum (Pakisṭan + um).</text></form>
<translation type="Free translation">
<form lang="en"><text>from Pakistan</text></form>
<form lang="ur-PK"><text>پاکستان سے</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>telle chakaasum (chakaas +um) duusi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The walnut came out from the husk </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text><span lang="en">dan amuśum (amuśi +um) khaṭ walí.</span></text></form>
<translation type="Free translation">
<form lang="en"><text>The stone dropped down from my palm. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>gu<span lang="en">x</span>aćum (gu-xat +um) dám aydusi. </text></form>
<translation type="Free translation">
<form lang="en"><text>No breath (no word) came out of  your mouth.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>yaarum (yare +um).</text></form>
<translation type="Free translation">
<form lang="en"><text>from the bottom</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>uulum (uule +um).</text></form>
<translation type="Free translation">
<form lang="en"><text>from inside </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>yaṭum </text></form>
<translation type="Free translation">
<form lang="en"><text>from above</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-04-18T22:27:35Z" dateModified="2025-10-21T21:34:23Z" id="umeén_8de78126-92e1-400b-825b-914895d3b8f1" guid="8de78126-92e1-400b-825b-914895d3b8f1">
<lexical-unit>
