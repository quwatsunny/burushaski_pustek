</field>
<sense id="b94657ba-b939-449f-adf3-af99d2fcaf9e">
<grammatical-info value="Determiner">
</grammatical-info>
<gloss lang="en"><text>a little bit</text></gloss>
<gloss lang="ur-PK"><text>تھوڑا سا۔ </text></gloss>
<example>
<form lang="bsk"><text>ćai kaaman kam et. </text></form>
<translation type="Free translation">
<form lang="en"><text>Decrease the amount of the tea a little bit. </text></form>
</translation>
</example>
</sense>
</entry>
