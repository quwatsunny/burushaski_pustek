<trait name="is-primary" value="true"/>
<trait  name="complex-form-type" value="Inflection"/>
</relation>
<field type="IPA Burushaski">
<form lang="bsk"><text>kaʈamur̥tʃum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>کٹمُرْچُم</text></form>
</field>
<sense id="d9d8b3de-1eda-4fd6-b7f0-f2e26b35bf65" order="0">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>kneading or trampling on</text></gloss>
<gloss lang="ur-PK"><text>ہا تھ سے یا پا وں سے مسل کر نرم کرنا، مالش کرنا</text></gloss>
<example>
<form lang="bsk"><text>bape báṭ kaṭamurʰćum bai.</text></form>
<translation type="Free translation">
<form lang="en"><text>The grandpa is kneading the hide.</text></form>
</translation>
</example>
</sense>
<sense id="f6ddce1a-84e5-4673-92bd-a37d3ee9e087" order="1">
<gloss lang="en"><text>knead or massage parts of body</text></gloss>
<gloss lang="ur-PK"><text>مالش کرنا یاجسم دبانا</text></gloss>
<example>
<form lang="bsk"><text>kapall aakaṭamur</text></form>
<translation type="Free translation">
<form lang="en"><text>knead my head or massage my head</text></form>
</translation>
</example>
</sense>
</entry>
