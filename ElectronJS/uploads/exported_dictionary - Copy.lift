<form lang="bsk"><text>daːɫ gumʌn (-mʌn)</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>داڵ گُمَن</text></form>
</field>
<sense id="95bf1c76-8fc3-4afd-b892-566b0f452166">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>get up</text></gloss>
<gloss lang="ur-PK"><text>اُٹھو</text></gloss>
<example>
<form lang="bsk"><text>daall gumán un jaa peṭek yaṭe huruṭum ba. </text></form>
