</field>
<sense id="28106433-48ce-4e32-ac18-52e95f791d19" order="0">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>elevated, raised or lifted up to a higher position</text></gloss>
<gloss lang="ur-PK"><text>بُلند حالت میں، کھڑے کھڑے حالت میں </text></gloss>
<example>
<form lang="bsk"><text>se bun yara ġeyu danjo nudell toroḍi desta. </text></form>
<translation type="Free translation">
<form lang="en"><text>Cause the boulder to rest at an elevated position by placing small rocks under it. </text></form>
</translation>
</example>
</sense>
