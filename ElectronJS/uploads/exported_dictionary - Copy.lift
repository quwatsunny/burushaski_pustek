<sense id="fe628b45-35a6-46f7-85e6-e3e8eb8828f0" order="0">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>make someone tricked into, make someone fool</text></gloss>
<gloss lang="ur-PK"><text>بے وقوف بناؤ، ماموں بناوࣷ</text></gloss>
<example>
<form lang="bsk"><text>un churam noxa, masqara áta. </text></form>
<translation type="Free translation">
<form lang="en"><text>You, having said that you will come, did not come. </text></form>
</translation>
</example>
</sense>
<sense id="beea01e8-df51-4e5a-a6ba-524b9abedc32" order="1">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>distract someone, divert someone's attention</text></gloss>
<gloss lang="ur-PK"><text>بھلانا پھسلانا، توجہ ہٹاکر دھوکہ دینا۔</text></gloss>
<example>
<form lang="bsk"><text>lali ġa tatayo án nuu, ne masqara et. </text></form>
<translation type="Free translation">
<form lang="en"><text>Give a toy to the baby and distract him. </text></form>
</translation>
</example>
</sense>
</entry>
