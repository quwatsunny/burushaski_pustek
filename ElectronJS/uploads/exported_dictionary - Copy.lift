<sense id="9bdbd5bf-031c-4d19-8aa3-6f4ea12ea4e8">
<grammatical-info value="Genitive (e)">
</grammatical-info>
<gloss lang="en"><text>my, mine، 1SG.GEN</text></gloss>
<gloss lang="ur-PK"><text>میرا</text></gloss>
<example>
