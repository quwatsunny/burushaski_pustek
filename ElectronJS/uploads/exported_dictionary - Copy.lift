</field>
<field type="IPA Burushaski">
<form lang="bsk"><text>tiɫ aːɫa</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>تِلٚ آلٚاࣷ</text></form>
</field>
<sense id="f5f0335d-6546-44f9-b2f8-7d586af208ca">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>1SG forgot</text></gloss>
<gloss lang="ur-PK"><text>میں بھول گیا</text></gloss>
<example>
<form lang="bsk"><text>ja goġa siya till aalla. </text></form>
<translation type="Free translation">
<form lang="en"><text>I forgot to tell you. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2021-02-22T00:19:52Z" dateModified="2025-11-09T14:05:19Z" id="till akomál_5207916d-5e79-4b02-b59b-f0702b0ee32e" guid="5207916d-5e79-4b02-b59b-f0702b0ee32e">
