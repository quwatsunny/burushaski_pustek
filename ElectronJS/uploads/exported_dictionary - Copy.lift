</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<relation type="Compare" ref="-ći_36977846-424e-40b8-abfb-c8d5148ef5f8"/>
<relation type="Compare" ref="bar2_05fc23ec-74d4-4a96-b102-814014e139f2"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>bar̥tʃi</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بَرْچیࣷ </text></form>
</field>
<sense id="714423eb-c1bb-4c3f-ac09-974501f3bd75">
<grammatical-info value="Locative (ći, i)">
</grammatical-info>
<gloss lang="en"><text>A metaphoric locative expression which means: in compliance with someone's pep-talk, advice, word etc.</text></gloss>
<gloss lang="ur-PK"><text>پیروی میں، نصیحت میں</text></gloss>
<example>
<form lang="bsk"><text>jaa aye ja barʰći bai. </text></form>
<translation type="Free translation">
<form lang="en"><text>My son is in compliance to my advice. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>guya tati barʰći guwan, yaġi akuman. </text></form>
<translation type="Free translation">
<form lang="en"><text>Be in your father's word, do not be unruly. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-05-01T02:11:01Z" dateModified="2025-12-03T02:39:13Z" id="barʰći et_9af22b68-6cd3-4fb8-b51d-8470d0f20587" guid="9af22b68-6cd3-4fb8-b51d-8470d0f20587">
