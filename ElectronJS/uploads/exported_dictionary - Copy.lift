<sense id="61c1906a-4ad3-42fe-860d-15e2eecfea74">
<grammatical-info value="copula verb">
</grammatical-info>
<gloss lang="en"><text>is not (of noun class x.y), a negative devoiced form of /bi/.</text></gloss>
<gloss lang="ur-PK"><text>نہیں ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>ja rai apí</text></form>
<translation type="Free translation">
<form lang="en"><text>I have no interest or opinion</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja apaći kheen apí. </text></form>
<translation type="Free translation">
<form lang="en"><text>I do not have time. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>halle daġom apí. </text></form>
<translation type="Free translation">
<form lang="en"><text>There is no flour at home. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>goo guyaći báll apí.</text></form>
<translation type="Free translation">
<form lang="en"><text>You do not have brain in your top (head). </text></form>
</translation>
</example>
</sense>
</entry>
