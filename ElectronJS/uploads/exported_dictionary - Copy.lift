<entry dateCreated="2023-01-12T23:16:29Z" dateModified="2025-12-19T16:11:12Z" id="boyiki_572a3298-f0e1-4587-a06c-7fb850275ad5" guid="572a3298-f0e1-4587-a06c-7fb850275ad5">
<lexical-unit>
<form lang="bsk"><text>boyiki</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="saiki_cae8af13-74c3-4700-a4fd-8c41744f3791"/>
<relation type="Compare" ref="boyo_318bae1f-c7e6-4c9f-8888-f34bd649cde3"/>
