<entry dateCreated="2019-04-04T16:12:25Z" dateModified="2025-12-22T03:49:10Z" id="chhan2_6ca8c520-d513-4e0d-8ebd-9ee1928b59c8" guid="6ca8c520-d513-4e0d-8ebd-9ee1928b59c8">
<lexical-unit>
<form lang="bsk"><text>chán</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>tshʌn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ڎَھن</text></form>
</field>
<sense id="e50302f0-80e8-4937-9295-06f31ecc48bb">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>true, right, real</text></gloss>
<gloss lang="ur-PK"><text>سچ، صحیع</text></gloss>
<example>
<form lang="bsk"><text>chán bar</text></form>
<translation type="Free translation">
<form lang="en"><text>true statement</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un chán bariṅ ećum ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>You are telling the truth. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>Damane chán gán yaṭe goguchariṣ.</text></form>
<translation type="Free translation">
<form lang="en"><text>May God walk you on the right path. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-04-16T17:50:14Z" dateModified="2025-12-22T03:51:55Z" id="chán2_43adddff-9ae9-4b2e-9ff6-e870dadf31c4" guid="43adddff-9ae9-4b2e-9ff6-e870dadf31c4">
<lexical-unit>
<form lang="bsk"><text>chán</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The term is used in Comparative Correlative construction, and is always preceded by action nouns.</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>tshʌn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ڎَھن</text></form>
</field>
<sense id="8b027144-9470-4467-8318-b36d178c565c">
<gloss lang="en"><text>the more, the ..er, </text></gloss>
<gloss lang="ur-PK"><text>فعل کی تقابلی نسب   میں استعمال ہوتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>ṣićum chán, ja c̣hám amayam ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>The more  I eat, the hungrier I get. </text></form>
</translation>
</example>
</sense>
