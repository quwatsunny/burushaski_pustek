<form lang="bsk"><text>tʃakɛʂ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چَکیࣷݜ</text></form>
</field>
<field type="Plural Suffix">
<form lang="bsk"><text>iṅ</text></form>
</field>
<sense id="ead73e08-44f6-4993-b241-767b28d2751e" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>coverage, extent to which something is provided or supplied, range, reach</text></gloss>
<gloss lang="ur-PK"><text>احاطہ،  پہنچ یا حدجہاں تک کوئئ چیز مہیا  کرنا مقصود ہو۔ </text></gloss>
<example>
<form lang="bsk"><text>guyuṅus gumuś ce ćakeṣ aieti </text></form>
<translation type="Free translation">
<form lang="en"><text>Your tongue did not reach your nose. </text></form>
</translation>
</example>
</sense>
<sense id="4b00ec8a-32d8-48dd-8628-9ff5423092c3" order="1">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>assign, set or fix </text></gloss>
<gloss lang="ur-PK"><text>مقرر کرنا</text></gloss>
<example>
<form lang="bsk"><text>thame alʰtac haryo jaġa ćakeṣ aati.</text></form>
<translation type="Free translation">
<form lang="en"><text>The king assigned two oxes to me. </text></form>
</translation>
</example>
</sense>
<sense id="4dfb035b-7a44-443e-85de-493aab728acc" order="2">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>to meet, satisfy or fulfill (need, deficiency etc)</text></gloss>
<gloss lang="ur-PK"><text>کمی پوری کرکےیا مہیا کر کے مطمین کرنا یا پورا کرنا۔ </text></gloss>
<example>
<form lang="bsk"><text>c̣hika gaṭunz net c̣akeṣ eća aimayimi. </text></form>
<translation type="Free translation">
<form lang="en"><text>It would not be possible to provide clothing to all. </text></form>
</translation>
</example>
</sense>
</entry>
