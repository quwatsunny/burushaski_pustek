<entry dateCreated="2021-06-29T23:38:07Z" dateModified="2025-10-08T01:12:46Z" id="ẓo-ẓo_3fe0856d-2eb7-4085-8f2d-95f0bc4da086" guid="3fe0856d-2eb7-4085-8f2d-95f0bc4da086">
<lexical-unit>
<form lang="bsk"><text>ẓo-ẓo</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʐo-ʐo</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ژوࣷ ژوࣷ</text></form>
</field>
<sense id="0de56a3b-11b7-4b27-af0a-3f400bb57323" order="0">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>coming, used as an Imperfective aspect (IMPV)</text></gloss>
<gloss lang="ur-PK"><text>آ رہا، رہی، رہے وغیرہ کے لیے استعمال ہوتا ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>Ja ne yeca, ne dalla ẓo ẓo bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I saw him, he was coming up. </text></form>
</translation>
</example>
</sense>
<sense id="8045d469-94ea-40fb-a300-7e4888dcd249" order="1">
<gloss lang="en"><text>used to come (HAB)</text></gloss>
<gloss lang="ur-PK"><text>آتا رہتا، رہتے ، رہتی وغیرہ</text></gloss>
<example>
<form lang="bsk"><text>yár mó akholla ẓo ẓo bum.</text></form>
<translation type="Free translation">
<form lang="en"><text>In the past, she used to come here. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>we yár ẓo ẓo bám, amutuk aichurum baan.</text></form>
<translation type="Free translation">
<form lang="en"><text>They used to come here, now they do not come. </text></form>
</translation>
</example>
</sense>
</entry>
