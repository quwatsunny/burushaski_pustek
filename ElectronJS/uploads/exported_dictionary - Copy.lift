<form lang="bsk"><text>ʈʂoqa</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>څوࣷقاࣷ</text></form>
</field>
<sense id="eed60cdb-a131-4bf9-b3c5-e8367b0da9e1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>fallen over and flattened,  knocked down</text></gloss>
<gloss lang="ur-PK"><text>پیٹھ کے بل گرا ہوا</text></gloss>
<example>
<form lang="bsk"><text>ja nuqas nuqas c̣oqa amaná. </text></form>
<translation type="Free translation">
<form lang="en"><text>Having laughed continuously, I fell over. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-07-19T06:08:42Z" dateModified="2025-12-27T02:56:15Z" id="c̣oreś_2ef81bdf-bcd8-4f0c-8ae6-50239da1ab4e" guid="2ef81bdf-bcd8-4f0c-8ae6-50239da1ab4e">
<lexical-unit>
<form lang="bsk"><text>c̣oreś</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʈʂorɛʃ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>څوریݜ</text></form>
</field>
<sense id="689cfe20-4c96-412a-b839-569ea0bfbcf5">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>cackling of hen (especially before laying eggs), laying cackle </text></gloss>
<gloss lang="ur-PK"><text>انڈے دینے سے پہلے مرغی کی کُڑ کُڑ، کُڑکُڑاہٹ</text></gloss>
<example>
<form lang="bsk"><text>qarʰqamuśe c̣oreś ećum bi, ṭiṅan waśća rai etum bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The hen is singing egg-song, it wants to lay an egg. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-06-08T02:23:41Z" dateModified="2025-12-27T03:05:17Z" id="c̣órʰc̣or_a377bd32-1137-4354-b91c-4ef73b98733a" guid="a377bd32-1137-4354-b91c-4ef73b98733a">
