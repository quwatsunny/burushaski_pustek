</field>
<sense id="2f5d2c91-ce8a-4310-a46f-c8c3ad1468ae">
<gloss lang="en"><text>bereavement, grief at death</text></gloss>
<gloss lang="ur-PK"><text>موت یا موت کا سوگ</text></gloss>
<example>
<form lang="bsk"><text>mii guṭe deh ulle <span lang="en">xaphagi an</span> duwa, tolla duġareśa neas duwa.</text></form>
<translation type="Free translation">
<form lang="en"><text>There’s been a death nearby; we are to go for condolences.</text></form>
</translation>
</example>
</sense>
</entry>
