<entry dateCreated="2019-03-18T02:54:06Z" dateModified="2025-08-30T19:34:46Z" id="ťo_7fd4ec11-28ae-40e7-b847-1b1c4fd273de" guid="7fd4ec11-28ae-40e7-b847-1b1c4fd273de">
<lexical-unit>
<form lang="bsk"><text>too</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>toː</text></form>
</field>
<sense id="f9040695-c505-42a5-bf43-71c4a200e253" order="0">
<gloss lang="en"><text>there</text></gloss>
<gloss lang="ur-PK"><text>وہاں</text></gloss>
<example>
<form lang="bsk"><text>too dis nukuwá jaġa phuun et. </text></form>
<translation type="Free translation">
<form lang="en"><text>After reaching there, call me.(Call me once you reach there)</text></form>
</translation>
</example>
</sense>
<sense id="f50e2b7b-331e-4171-bae0-7d31401b4a47" order="1">
<gloss lang="en"><text>In a genitive case, it denotes the residence or place of the stated Possessor.  </text></gloss>
<example>
<form lang="bsk"><text>ja née too gar án'a neyam bám. </text></form>
<translation type="Free translation">
<form lang="en"><text>I had gone to a wedding at his place. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mī too hen hir en bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>There was a man at our place (in our area).</text></form>
</translation>
</example>
</sense>
</entry>
