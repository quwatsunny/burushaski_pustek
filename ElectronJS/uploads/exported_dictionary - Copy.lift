<entry dateCreated="2019-04-17T00:18:22Z" dateModified="2025-12-03T17:03:43Z" id="Baṭakuśi_95af65ac-6362-42ec-a5d6-ccc941a9f433" guid="95af65ac-6362-42ec-a5d6-ccc941a9f433">
<lexical-unit>
