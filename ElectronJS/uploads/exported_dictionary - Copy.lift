</field>
<sense id="f174ee24-ab28-426f-86f6-925e7fd2e8cf">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>gash, hew mark, cut, mark or cut with a strike </text></gloss>
