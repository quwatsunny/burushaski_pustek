</field>
<sense id="17299de8-10b8-4642-811f-7cd01e04135a">
<grammatical-info value="copula verb">
</grammatical-info>
<gloss lang="en"><text>are not, am not</text></gloss>
<gloss lang="ur-PK"><text>میں نہیں ہوں، تم نہیں ہو</text></gloss>
<example>
<form lang="bsk"><text>ja gucum xabar apa. </text></form>
<translation type="Free translation">
<form lang="en"><text>I am not informed about you. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un śum hir apa. </text></form>
<translation type="Free translation">
<form lang="en"><text>You are not a bad man. </text></form>
</translation>
</example>
</sense>
</entry>
