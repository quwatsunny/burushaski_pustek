</field>
<sense id="c041339b-3021-439a-a3ce-bf8160f8ce17">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>flattened by an impact, crushed</text></gloss>
<gloss lang="ur-PK"><text>کچل کر مسلا ہوا</text></gloss>
<example>
<form lang="bsk"><text>arabaa ġorʰqon nidell ćaqast eti</text></form>
<translation type="Free translation">
<form lang="en"><text>The jeep hit the frog and flattened it. </text></form>
</translation>
</example>
</sense>
</entry>
