</field>
<sense id="bfdad17f-6894-48eb-adcf-ace44895b8c7" order="0">
<grammatical-info value="Interrogative pro-form">
</grammatical-info>
<gloss lang="en"><text>of what</text></gloss>
<gloss lang="ur-PK"><text>کس چیز کا</text></gloss>
<example>
<form lang="bsk"><text>guse phinjo bote bi?</text></form>
<translation type="Free translation">
<form lang="en"><text>This polo stick is (made) of what?</text></form>
</translation>
</example>
</sense>
<sense id="b1bcc8d2-0187-404e-ad64-b19d4293f76b" order="1">
<grammatical-info value="Ergative">
</grammatical-info>
<gloss lang="en"><text>by something</text></gloss>
<gloss lang="ur-PK"><text>کوئی یا کچھ</text></gloss>
<example>
<form lang="bsk"><text>un bote guṣic̣imi. </text></form>
<translation type="Free translation">
<form lang="en"><text>You will be eaten by something. </text></form>
</translation>
</example>
</sense>
</entry>
