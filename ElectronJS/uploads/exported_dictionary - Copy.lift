<gloss lang="ur-PK"><text>آؤ  ( ایک سے زیادہ لوگوں کو مخاطب کرتے ہوئے۔ )</text></gloss>
<example>
<form lang="bsk"><text>ẓoiṅ, cheran. </text></form>
<translation type="Free translation">
<form lang="en"><text>Come (guys), let's go.</text></form>
</translation>
</example>
</sense>
</entry>
