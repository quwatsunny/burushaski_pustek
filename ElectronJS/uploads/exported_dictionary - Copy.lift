<translation type="Free translation">
<form lang="en"><text>In the dark, the cat's eyes became glowy.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-06-23T21:46:38Z" dateModified="2025-10-08T01:12:46Z" id="ljiwar_77c2a0be-6d68-4a96-920b-46f8813edd26" guid="77c2a0be-6d68-4a96-920b-46f8813edd26">
<lexical-unit>
<form lang="bsk"><text>ljiwar</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>In usage, it takes adverbial suffixes and pronominal prefixes. This bound word has been borrowed by various Indic languages, including Urdu, where it appears in expressions like qurb and jiwar, meaning 'near' and 'around.'</text></form>
</note>
<relation type="Compare" ref="ware_e617dff0-dac6-4d3f-8f2c-d7c58593b0e1"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>lʒiwar</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اِلجوار</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>ljiware</text></form>
</field>
<trait name="Possessors" value="U-Obligatorily Possessors"/>
<sense id="8ca3b732-9545-447f-86be-b1c89c5c48c1">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>around</text></gloss>
<gloss lang="ur-PK"><text>اطراف میں،  اردگرد</text></gloss>
<example>
<form lang="bsk"><text>mo wawe muljiware báll net phát etum bu. </text></form>
<translation type="Free translation">
<form lang="en"><text>The old lady has built a wall around her and left it. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-11-16T03:36:57Z" dateModified="2025-10-08T01:12:46Z" id="ll_a86cdc48-5a47-4f3f-8648-02f224086720" guid="a86cdc48-5a47-4f3f-8648-02f224086720">
