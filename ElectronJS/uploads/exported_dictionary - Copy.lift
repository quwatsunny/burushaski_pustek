<entry dateCreated="2019-12-24T14:22:49Z" dateModified="2025-12-01T05:01:34Z" id="balluc̣um_d3e4df68-b668-4388-b1cd-0b46728bb3fa" guid="d3e4df68-b668-4388-b1cd-0b46728bb3fa">
<lexical-unit>
<form lang="bsk"><text>balluc̣um</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>This verb is used only in Passive voice. For active voice, the word is espalluc̣um.  An addition of  /es/ and change of /b/ to /p/ is observed. </text></form>
</note>
<relation type="Compare" ref="espalluc̣um_da4f36a6-7ad9-45f8-897f-af5131b317dd"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>baɫuʈʂum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بلُوڅُم</text></form>
</field>
<sense id="98be793b-308b-45d5-a191-bcb411db8bde" order="0">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>(of noun class-y) getting lost, getting misplaced</text></gloss>
<gloss lang="ur-PK"><text>گُم ہوجانا</text></gloss>
<example>
<form lang="bsk"><text>ja puṣ ballui</text></form>
<translation type="Free translation">
<form lang="en"><text> My  shirt got lost. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja aya púṣ espalluya. </text></form>
<translation type="Free translation">
<form lang="en"><text>I lost my shirt. </text></form>
</translation>
</example>
</sense>
<sense id="02adbfe2-f251-4335-941a-731766eefe41" order="1">
<gloss lang="en"><text>(of work) not going as planned, getting ruined</text></gloss>
<gloss lang="ur-PK"><text>کام  خراب ہونا</text></gloss>
<example>
</example>
<example>
<form lang="bsk"><text>ja doro ballui</text></form>
<translation type="Free translation">
<form lang="en"><text>My work got ruined</text></form>
</translation>
</example>
</sense>
</entry>
