<entry dateCreated="2021-11-30T15:42:38Z" dateModified="2025-12-03T23:17:16Z" id="be1_174c1578-5ba9-428a-8578-a4acccb30c1f" guid="174c1578-5ba9-428a-8578-a4acccb30c1f">
<lexical-unit>
<form lang="bsk"><text>be</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="bećharʰći_986e4050-d033-4f56-9b4b-3252bb351fcc"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>bɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بےࣷ</text></form>
</field>
<sense id="51c18772-b049-4d33-b418-7b31df479dd6">
<gloss lang="en"><text>negative prefix, without,  -less.  The Prefix often alternatively pronounced as wé as in bexál and wexal</text></gloss>
<gloss lang="ur-PK"><text>سے عاری، کے بغیر</text></gloss>
<example>
<form lang="bsk"><text>beġáś guchar </text></form>
<translation type="Free translation">
<form lang="en"><text>Walk without any worry. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>bexal jú an.</text></form>
<translation type="Free translation">
<form lang="en"><text>A tasteless apricot. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-09-05T18:15:55Z" dateModified="2025-12-16T02:00:19Z" id="beheyam_a5ce1108-ec1d-4e96-be31-e6c8ce071514" guid="a5ce1108-ec1d-4e96-be31-e6c8ce071514">
<lexical-unit>
<form lang="bsk"><text>be heyam</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>It is a combination of <span lang="bsk">bé (no) hém (knowledge), ýam (FUT suffix)</span></text></form>
</note>
<relation type="Compare" ref="-yam_076a7e86-d4c7-4b20-8202-3fbf59bc94cd"/>
