<form lang="bsk"><text>gopaći han bar an desác̣am, mena geén ayet.</text></form>
<translation type="Free translation">
<form lang="en"><text>I will mention a matter to (near) you, please do not disclose it to anyone. </text></form>
</translation>
</example>
</sense>
</entry>
