</relation>
<trait name="do-not-publish-in" value="Idioms"/>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ایࣷت ایࣷت</text></form>
</field>
<sense id="668a3e39-3669-42ec-8a25-7f3442fdc180">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>Progressive form of /et/, only used in the context of the past</text></gloss>
<example>
<form lang="bsk"><text>ja doro et et bam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I was doing the work. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo guse paqo et et bum. </text></form>
<translation type="Free translation">
<form lang="en"><text>That woman was making bread. </text></form>
</translation>
</example>
</sense>
</entry>
