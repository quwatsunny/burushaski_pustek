</field>
<sense id="950ce1bd-57d9-4162-8d5a-4240f441bac6" order="0">
<gloss lang="en"><text>overflow of boiling fluid, surge of boiling liquids </text></gloss>
<gloss lang="ur-PK"><text>جوشان، اُمنڈنا، اُبلتے پانی کی سطع کا تیزی سے بلند ہونا۔ </text></gloss>
</sense>
<sense id="99855a90-e502-43c0-8b95-2199569a8957" order="1">
<gloss lang="en"><text>surge of anger, oozing emotions, boiling of blood</text></gloss>
<gloss lang="ur-PK"><text>غصہ یا جذبات کا اُمنڈنا، خون کھولنا۔  </text></gloss>
<example>
<form lang="bsk"><text>phaiṅ etaśu ġa ja juuṣk aaćum duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>To the ones who lie, it boils me (my blood). </text></form>
</translation>
</example>
</sense>
</entry>
