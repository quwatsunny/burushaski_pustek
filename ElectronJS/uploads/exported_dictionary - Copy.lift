</field>
<trait name="Possessors" value="DePrifix -e,o"/>
<sense id="143068f0-907b-4956-b0d5-247073e1a141">
<gloss lang="en"><text>pronominal prefix for 1SG.h, used with several of the Burushaski d-prefix verbs. </text></gloss>
<example>
<form lang="bsk"><text>ja hún daġaśi. </text></form>
<translation type="Free translation">
<form lang="en"><text>I found wood. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hire ja daġaresí. </text></form>
<translation type="Free translation">
<form lang="en"><text>That man asked me. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2024-05-01T14:50:59Z" dateModified="2025-10-08T01:12:46Z" id="daa2_ca939672-63dc-4965-b413-06cc8b5b8bd6" guid="ca939672-63dc-4965-b413-06cc8b5b8bd6">
<lexical-unit>
<form lang="bsk"><text>daa</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="demee_4ccb60bd-d546-4ab5-a7e5-79bc72bc5771"/>
<trait name="do-not-publish-in" value="Idioms"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>daː</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دا</text></form>
</field>
<sense id="d158d2f9-6c7d-4dbf-90d9-9a02c19c4016">
<gloss lang="en"><text>1SG.h having come, after 1SG.h came</text></gloss>
<gloss lang="ur-PK"><text>آکر، آنے کے بعد</text></gloss>
<example>
<form lang="bsk"><text>ja akho daa alʰto den mani. </text></form>
<translation type="Free translation">
<form lang="en"><text>It has been two years, after (since) I came here. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-03-18T15:23:05Z" dateModified="2025-10-08T01:12:46Z" id="dda_b61da8c7-2fa2-48e3-88ca-a3448acfb13d" guid="b61da8c7-2fa2-48e3-88ca-a3448acfb13d">
<lexical-unit>
<form lang="bsk"><text>daa</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="noġdar_557e6dbc-0934-4aaf-a10a-ed5f89a1c23b"/>
<relation type="Compare" ref="ka1_c38946c6-397f-4885-a343-0ad52cfa5860"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>daː</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>دا</text></form>
</field>
<sense id="ea320399-dbdc-452c-be27-f821c3c63bc9" order="0">
<grammatical-info value="Conjunction">
</grammatical-info>
<gloss lang="en"><text>once again</text></gloss>
<gloss lang="ur-PK"><text>دوبارہ </text></gloss>
<example>
<form lang="bsk"><text>hek goġa sená, daa thum bo siyam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I told you once, what else should I tell you again. </text></form>
</translation>
</example>
</sense>
<sense id="cdf6e56d-6b08-4d93-b973-496e6986c900" order="1">
<gloss lang="en"><text>and then (with conditional statement)</text></gloss>
<gloss lang="ur-PK"><text>پھر</text></gloss>
<example>
<form lang="bsk"><text>un iilja ẓo ka, da ja cheram</text></form>
<translation>
<form lang="en"><text>You come back, and then I will go.</text></form>
</translation>
</example>
</sense>
<sense id="c913a69f-417e-4a88-a05f-04b5742afe52" order="2">
<grammatical-info value="Conjunction">
</grammatical-info>
<gloss lang="en"><text>used at the end  of an exclamatory expression</text></gloss>
<gloss lang="ur-PK"><text>فجائیہ جملہ</text></gloss>
<example>
<form lang="bsk"><text>un ajo doro eta da. </text></form>
<translation type="Free translation">
<form lang="en"><text>You did a wonderful job!</text></form>
</translation>
</example>
</sense>
<sense id="913b26c9-8317-41f0-a62e-7e2080f7d6a0" order="3">
<grammatical-info value="Conjunction">
</grammatical-info>
<gloss lang="en"><text>and</text></gloss>
<gloss lang="ur-PK"><text>اور</text></gloss>
<example>
<form lang="bsk"><text>Pholok, ne yé, Abiro, da we qaam</text></form>
<translation type="Free translation">
<form lang="en"><text>Pholok, his son, Abiro, and their extended family.</text></form>
</translation>
</example>
</sense>
</entry>
