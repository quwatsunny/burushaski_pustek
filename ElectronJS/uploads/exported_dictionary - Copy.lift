<entry dateCreated="2019-05-20T16:22:53Z" dateModified="2025-12-18T01:24:11Z" id="bota siya_cb30a1f7-7d38-4047-b57d-bfc8fbe05498" guid="cb30a1f7-7d38-4047-b57d-bfc8fbe05498">
<lexical-unit>
<form lang="bsk"><text>bota siya</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<note>
<form lang="en"><text>

- Functions like a discourse marker rather than a verb or noun.
 - Adds emphasis and clarity to spoken reasoning.</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>bota siya</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بوتاࣷ سیاࣷ </text></form>
</field>
<sense id="80a210e8-6767-489c-8ee5-f127f6c52e9d">
<gloss lang="en"><text>why if (you) ask, because,  It is used after a statement and before an explanation or reasoning.</text></gloss>
<gloss lang="ur-PK"><text>پوچھو کیوں</text></gloss>
<example>
<form lang="bsk"><text>amuṭuk ya khaṭa ẓo, boota siya, iilji araba aydokoġaśćimi. </text></form>
<translation type="Free translation">
<form lang="en"><text>Come right now itself, why, because later you will not find a vehicle.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-12-07T04:18:17Z" dateModified="2025-12-19T17:27:51Z" id="boté_32f8bc9e-8952-42b7-a10f-b8a5b9bbb63d" guid="32f8bc9e-8952-42b7-a10f-b8a5b9bbb63d">
<lexical-unit>
