<form lang="bsk"><text>ɔhuruʈ</text></form>
</field>
<sense id="41860a76-5733-4886-a76b-752f3004be35" order="0">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>make them sit</text></gloss>
<gloss lang="ur-PK"><text>اُن کو بیٹھا دو</text></gloss>
<example>
<form lang="bsk"><text>ses śón yaṭe óhuruṭ</text></form>
<translation type="Free translation">
<form lang="en"><text>Make the people sit on the cot. </text></form>
</translation>
</example>
</sense>
<sense id="f9c090b5-53c5-4f4c-af86-9b303f82ea2e" order="1">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>causing to settle. </text></gloss>
<gloss lang="ur-PK"><text>رکھنا، یا بسانا۔ </text></gloss>
<example>
<form lang="bsk"><text>moo muya nani-taṭi Islamabaḍ nuchu ohuruṭu. </text></form>
<translation type="Free translation">
<form lang="en"><text>She took her parents to Islamabad and make them settle there. </text></form>
</translation>
</example>
</sense>
</entry>
