<entry dateCreated="2019-05-08T02:31:04Z" dateModified="2025-10-08T01:12:46Z" id="phurukús_fa1669e9-9fe6-4764-ab96-4ea36b465285" guid="fa1669e9-9fe6-4764-ab96-4ea36b465285">
