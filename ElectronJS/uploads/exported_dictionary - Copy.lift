<entry dateCreated="2019-10-23T02:45:53Z" dateModified="2025-12-25T17:23:30Z" id="c̣aṭpaṭ_6ea80d9b-4a9b-4961-b2ef-f64894a660bf" guid="6ea80d9b-4a9b-4961-b2ef-f64894a660bf">
