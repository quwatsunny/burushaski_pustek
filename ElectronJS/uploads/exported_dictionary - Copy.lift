<entry dateCreated="2020-11-01T19:12:14Z" dateModified="2025-12-01T15:23:21Z" id="báṅ_d06cfa93-4fa4-4f94-8c16-82a66d6c1834" guid="d06cfa93-4fa4-4f94-8c16-82a66d6c1834">
<lexical-unit>
<form lang="bsk"><text>báṅ</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="bán-bán ġayum_62c026c2-0da4-454d-9d2d-b6b47c550abe"/>
<relation type="Compare" ref="baṅbárʰce_8a479fce-1d11-4ae2-a4f2-268c80a2085d"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>bʌŋ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بنٚ</text></form>
</field>
<sense id="131f7812-c9c9-42f2-beb0-baf79485c059">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>wide open, full open</text></gloss>
<gloss lang="ur-PK"><text>پورا کُھلا،  بالکل کُھلا </text></gloss>
<example>
<form lang="bsk"><text>asqor án baṅ duxari. </text></form>
<translation type="Free translation">
<form lang="en"><text>A flower bloomed wide open. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hire hiṅ báṅ isqaa phát eti. </text></form>
<translation type="Free translation">
<form lang="en"><text>The man left the door wide open. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-07-26T04:40:16Z" dateModified="2025-12-01T15:30:57Z" id="baṅbárʰce_8a479fce-1d11-4ae2-a4f2-268c80a2085d" guid="8a479fce-1d11-4ae2-a4f2-268c80a2085d">
<lexical-unit>
<form lang="bsk"><text>baṅ bárʰce</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The literal meaning is: a wide open pelt or hide. A hide is usually trampled extensively for tanning purpose. The metaphor conveys not just fatigue but a sense of being flattened, worn down, and stripped of resilience.</text></form>
</note>
<relation type="Compare" ref="barʰcé_17b8f932-424f-42ac-8f1a-600df8de5e45"/>
<relation type="Compare" ref="báṅ_d06cfa93-4fa4-4f94-8c16-82a66d6c1834"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>baŋbʌr̥tsɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بنٚ برْڎے</text></form>
</field>
<sense id="6a2b8c46-dd12-4764-845a-d48a898c2890">
<grammatical-info value="Adjectival Phrase">
</grammatical-info>
<gloss lang="en"><text>extremely tired, exhausted, like a trampled hide</text></gloss>
<gloss lang="ur-PK"><text>بہت ہی زیادہ تھکا ہوا</text></gloss>
</sense>
</entry>
