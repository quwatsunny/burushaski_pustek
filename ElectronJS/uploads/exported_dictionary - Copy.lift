<entry dateCreated="2021-03-13T20:59:36Z" dateModified="2025-10-08T01:12:46Z" id="sá2_4feed46e-ee7e-497a-895b-518a21c17ced" guid="4feed46e-ee7e-497a-895b-518a21c17ced">
<lexical-unit>
<form lang="bsk"><text>sá</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>BUR → Balti, sá means the earth. </text></form>
</note>
<relation type="Compare" ref="saiki_cae8af13-74c3-4700-a4fd-8c41744f3791"/>
<relation type="Compare" ref="sáhan_46b64341-72db-44dd-a110-49af10d2703a"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>sʌ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>سہ</text></form>
</field>
<sense id="5b7a7de3-92f2-4186-bc3a-380c0430af94" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>sun</text></gloss>
<gloss lang="ur-PK"><text>سورج</text></gloss>
<example>
<form lang="bsk"><text>sá chór duusi.</text></form>
<translation type="Free translation">
<form lang="en"><text>The sun came out early. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>sá bawućume kheen maní. </text></form>
<translation type="Free translation">
<form lang="en"><text>It became the time of the sun set. </text></form>
</translation>
<translation>
<form lang="en"><text>It is the time for the sunset now. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>sá ṣaau mani. </text></form>
<translation type="Free translation">
<form lang="en"><text>The sun started slipping away. </text></form>
</translation>
</example>
</sense>
<sense id="d050fa5f-bef9-467f-b426-2ba67871498a" order="1">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>sunlight, ray of the sun</text></gloss>
<gloss lang="ur-PK"><text>دھوپ، سورج کی روشنی</text></gloss>
<example>
<form lang="bsk"><text>goo guyaṭa sá wali. </text></form>
<translation type="Free translation">
<form lang="en"><text>The sunlight fell on you. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>te ballbánum kye loqiṅ diyaśa. sá khita phat et. </text></form>
<translation type="Free translation">
<form lang="en"><text>Take out the rags from the wall-opening, let the sunlight come in. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>saa ce ai huruṭ. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not sit in the sunlight </text></form>
</translation>
</example>
<trait name ="semantic-domain-ddp4" value="1.1 Sky"/>
</sense>
</entry>
<entry dateCreated="2019-04-15T16:08:45Z" dateModified="2025-10-08T01:12:46Z" id="sá bawu.c̣um_3d30a1dc-051c-4e75-a8ae-71f002476e0b" guid="3d30a1dc-051c-4e75-a8ae-71f002476e0b">
