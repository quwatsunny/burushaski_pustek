<entry dateCreated="2019-11-03T01:59:01Z" dateModified="2025-10-27T16:00:22Z" id="yáh_8b122800-4700-459f-b01b-aa0d1c9df941" guid="8b122800-4700-459f-b01b-aa0d1c9df941">
<lexical-unit>
<form lang="bsk"><text>yáh</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="be2_302cf8fc-48b8-4c5a-95da-bc099dd98532"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>yʌh</text></form>
