<form lang="bsk"><text>tʃaq</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چَق</text></form>
</field>
<sense id="3a22cc38-70a1-4bf2-8581-f0c54eeea13b">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>ready, poised</text></gloss>
<gloss lang="ur-PK"><text>تیار، تلا ہوا</text></gloss>
<example>
<form lang="bsk"><text>ne dohoya ćaq bai</text></form>
<translation type="Free translation">
<form lang="en"><text>He is ready to fight.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>khene herʰća ćáq bai.</text></form>
<translation type="Free translation">
<form lang="en"><text>This person over here is poised to cry. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-11-05T02:33:11Z" dateModified="2025-12-30T04:23:23Z" id="ćáq_93fe23e3-0aef-49b9-be51-b12c00c51b22" guid="93fe23e3-0aef-49b9-be51-b12c00c51b22">
<lexical-unit>
<form lang="bsk"><text>ćáq</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>tʃʌq</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چَق</text></form>
</field>
<sense id="5eea82ab-64e5-4411-a278-2f201474421f" order="0">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>faced or turned towards (something)</text></gloss>
<gloss lang="ur-PK"><text>رُخ بجانب، کی طرف ، کی جانب</text></gloss>
<example>
<form lang="bsk"><text>ćainake ṣur khaṭa ćaq bi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The spout of the teapot is turned downward. </text></form>
</translation>
</example>
</sense>
<sense id="8d04ef92-880f-41e6-b023-5875bcc828c1" order="1">
<gloss lang="en"><text>aimed at, pointed at</text></gloss>
<gloss lang="ur-PK"><text>نشانہ  بندھا ہوا</text></gloss>
<example>
<form lang="bsk"><text>neé thuwek jaġa ćaq eti</text></form>
<translation type="Free translation">
<form lang="en"><text>He pointed the gun at me.</text></form>
</translation>
</example>
</sense>
<sense id="c3ce937f-456f-4261-9a7e-bfb28e401fa7" order="2">
<gloss lang="en"><text>turning something towards</text></gloss>
<gloss lang="ur-PK"><text>رخ بجناب کرنا</text></gloss>
<example>
<form lang="bsk"><text>chell khaṭa ćaq et</text></form>
<translation type="Free translation">
<form lang="en"><text>Turn the flow of water downward۔</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-10T14:18:28Z" dateModified="2025-12-30T04:24:58Z" id="ćaq ećum_7fb7ca3a-0d72-4705-ba5f-1f3b647aeb66" guid="7fb7ca3a-0d72-4705-ba5f-1f3b647aeb66">
<lexical-unit>
<form lang="bsk"><text>ćaq ećum</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>tʃaq ɛtʃum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>چَق ایࣷچُم </text></form>
</field>
<sense id="70cfb7bf-7fa4-476c-b816-01b8cdc270b2" order="0">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>(of a target) to aim at</text></gloss>
<gloss lang="ur-PK"><text>نشانا باندحنا۔</text></gloss>
<example>
<form lang="bsk"><text>ne thuwak ayakalla ćaq eti</text></form>
<translation type="Free translation">
<form lang="en"><text>He aimed the gun towards me. </text></form>
</translation>
</example>
</sense>
<sense id="d0cd0204-fbdc-40dc-9468-dddacb544e34" order="1">
<gloss lang="en"><text>turning the face of something towards</text></gloss>
<gloss lang="ur-PK"><text>رُخ کسی چیز کی طرف کردینا</text></gloss>
<example>
<form lang="bsk"><text>sé dan khita ćaq net oós</text></form>
<translation type="Free translation">
<form lang="en"><text>Place the stone with its face turned towards this side.</text></form>
</translation>
</example>
</sense>
<sense id="7434fd7c-fa04-47a4-a096-b3e639437665" order="2">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>guiding the flow (of water)</text></gloss>
<gloss lang="ur-PK"><text>پانی کے بہاؤ کو راستہ دیکھانا</text></gloss>
<example>
<form lang="bsk"><text>ćhell malla ćaq et</text></form>
<translation type="Free translation">
<form lang="en"><text>Guide the flow of water to the crop field</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-10T14:23:26Z" dateModified="2025-12-30T04:57:20Z" id="ćaqa-ćaq_3cb91864-834a-43ef-ac11-983478d370bb" guid="3cb91864-834a-43ef-ac11-983478d370bb">
