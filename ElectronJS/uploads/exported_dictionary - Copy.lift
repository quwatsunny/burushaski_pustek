<form lang="en"><text>Three pair of dresses. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>alʰtokum ses akho duuya. </text></form>
<translation type="Free translation">
<form lang="en"><text>Two group of people came here. </text></form>
</translation>
</example>
</sense>
</entry>
