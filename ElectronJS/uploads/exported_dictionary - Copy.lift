<sense id="e0097602-3180-4603-858a-317641ed0916" order="0">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>light</text></gloss>
<gloss lang="ur-PK"><text>روشنیࣷ</text></gloss>
<example>
<form lang="bsk"><text>haalle garí duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>There is light in the house. </text></form>
</translation>
</example>
</sense>
<sense id="37683053-e8e0-450f-8f60-56d31a34cb73" order="1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>bright, light</text></gloss>
<gloss lang="ur-PK"><text>اُجالا،  روشندار</text></gloss>
<example>
<form lang="bsk"><text>alʰćimo gari biyen. </text></form>
<translation type="Free translation">
<form lang="en"><text>My eyes are bright. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>śuwa garí ha'an duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>It is a good bright house. </text></form>
</translation>
</example>
<trait name ="semantic-domain-ddp4" value="1.1 Sky"/>
</sense>
</entry>
<entry dateCreated="2024-12-17T15:26:13Z" dateModified="2025-10-08T01:12:46Z" id="garii ġa ṣim_1ed7b6d7-1fb0-485b-8f27-5808d7afce64" guid="1ed7b6d7-1fb0-485b-8f27-5808d7afce64">
