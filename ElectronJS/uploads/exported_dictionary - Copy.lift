<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>an alcove in the traditional Burusho house where a platform bed is fixed. </text></gloss>
</sense>
<sense id="3d5b4382-3dcb-45d7-bd61-cae9acd893c6" order="2">
