<relation type="Compare" ref="máćukus_3d5500a7-d37e-4004-905e-14bbcdcd3d3c"/>
<relation type="Compare" ref="datukus_44459f0a-94ab-4d4e-a8ea-c74d9a029667"/>
<trait name="do-not-publish-in" value="Idioms"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-kus</text></form>
</field>
<sense id="e8017cf0-5837-4e1b-9c89-b9d7b6e5d54d">
<gloss lang="en"><text>a suffix used with some words to denote a part in a set, array or number.  </text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو بعض الفاظ کے ساتھ حصے کے لیے استعمال ہوتا ہے۔ </text></gloss>
</sense>
</entry>
<entry dateCreated="2021-03-27T01:39:36Z" dateModified="2025-09-20T17:41:20Z" id="-kuśi_304afdeb-2953-4598-9c73-3891a50ad383" guid="304afdeb-2953-4598-9c73-3891a50ad383">
<lexical-unit>
<form lang="bsk"><text>-kuśi</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-kuʃi</text></form>
</field>
<sense id="71fe8c2f-c213-46dc-93b7-5e2bae31d8f3" order="0">
<gloss lang="en"><text>suffix signifying abundance of something in a particular location. </text></gloss>
<gloss lang="ur-PK"><text>لاحقہ جو کسی مقام پر کسی چیز کی کثرت کو ظاہر کرتا  ہے۔    </text></gloss>
<example>
<form lang="bsk"><text>ja Gyekuśi ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I am Gyekuśi, a place known for abundance of snow.  </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>Baṭaṅkuśi,akhoći ses apaan. </text></form>
<translation type="Free translation">
<form lang="en"><text>There are no people in Baṭakuśi,a place known for abandoned dilapidated houses.</text></form>
</translation>
</example>
</sense>
<sense id="52f0d8e8-6489-476a-9093-c33fd77556b3" order="1">
<gloss lang="en"><text>at a stage or period characterized by a state</text></gloss>
<gloss lang="ur-PK"><text>وقت یا مقام  جہاں کسی حالت کا  اظہار ہو۔ </text></gloss>
<example>
<form lang="bsk"><text>ja phuk-kuśi buṭ bariṅ ecám cek.</text></form>
<translation type="Free translation">
<form lang="en"><text>I used to talk a lot in my childhood.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>nani tati baṭakuśium dukusen. </text></form>
<translation type="Free translation">
<form lang="en"><text>Your parents got you out of destitute.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-11-01T00:19:54Z" dateModified="2025-10-08T01:12:46Z" id="kuṣ _81f4a1f8-6aa4-49ee-ae2d-7c35f2ccffae" guid="81f4a1f8-6aa4-49ee-ae2d-7c35f2ccffae">
<lexical-unit>
<form lang="bsk"><text>kuṣ</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<relation type="Compare" ref="dóh ećum_8ccd76cf-6c9f-47f0-a1ae-1683d7950faf"/>
<relation type="Compare" ref="tet_5c23c4be-9d5b-4113-9d7b-4a6dfcd48b52"/>
<relation type="Compare" ref="doh_1ed67c52-138a-4a6b-a2ee-738aa771d0a7"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>kuʂ </text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>کُݜ</text></form>
</field>
<sense id="45efae4d-cdf5-4600-920e-8772e68edbde">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>Ordering or urging a dog to chase down (something)</text></gloss>
<gloss lang="ur-PK"><text>کُتے کو سُسکارنا، کُتے کو پیچھا کرنے کے لیے حکم دینا۔   </text></gloss>
<example>
<form lang="bsk"><text>huk kuṣ eta ka, buś yar wáśćimi. . </text></form>
<translation type="Free translation">
<form lang="en"><text>If you urge the dog (to chase down), it will chase down the cat. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-18T11:55:59Z" dateModified="2025-09-10T00:40:55Z" id="-kuṣ_13fdccfd-bab3-4bea-9fa3-fd7dfc4ae227" guid="13fdccfd-bab3-4bea-9fa3-fd7dfc4ae227">
<lexical-unit>
<form lang="bsk"><text>-kuṣ</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-kuʂ</text></form>
</field>
<sense id="3fbfe180-1ec3-4734-b659-d8739f6f84f9">
<gloss lang="en"><text>suffix that turns adjectives into abstract nouns to hold quality, greatness or state. fullness. It is an equivalent of -ness in English.</text></gloss>
<example>
<form lang="bsk"><text>anaharkuṣe asayum duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>Starvation kills me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja ka goo gullkuṣ dumaní.</text></form>
<translation type="Free translation">
<form lang="en"><text>Relationship developed between me and you. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>garumkuṣ ane asqanum duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>Some heat has killed me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>gus muiṅgi guya hirkuṣ deephoġor bee.</text></form>
<translation type="Free translation">
<form lang="en"><text>Do not brag about your manliness in front of a woman. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>aweere uwakuṣe gandi guya mulʰtan ka ućhi. </text></form>
<translation type="Free translation">
<form lang="en"><text>For a global virtue, give even your blood (if that what it takes). </text></form>
</translation>
</example>
</sense>
</entry>
