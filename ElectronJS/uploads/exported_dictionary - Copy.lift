</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>This verb is used only in Active Voice, the Ergative form of  the verb is balluc̣um. </text></form>
</note>
<relation type="Compare" ref="balluc̣um_d3e4df68-b668-4388-b1cd-0b46728bb3fa"/>
