<entry dateCreated="2020-04-24T07:04:40Z" dateModified="2025-10-08T01:12:46Z" id="śamá_ee3f4808-6a01-4c6a-86b3-6e28ec84d714" guid="ee3f4808-6a01-4c6a-86b3-6e28ec84d714">
<lexical-unit>
<form lang="bsk"><text>śamá</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>It is possible that the original Burushaski word for tea, once may have been /śama/</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʃamʌ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>شماࣷ</text></form>
</field>
<sense id="6b0ca647-8a87-4038-938c-bd0ab040975f">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>tea dregs, remnants of tea</text></gloss>
<gloss lang="ur-PK"><text>چائے کی پتی جو پکنے کے بعد پیند ے میں رہ جاتی ہے۔ </text></gloss>
<example>
<form lang="bsk"><text>ćai khul maní, yare ćan śama duwaasi. </text></form>
<translation type="Free translation">
<form lang="en"><text>The tea is finished, only the tea dregs remain in the bottom. </text></form>
</translation>
</example>
</sense>
</entry>
