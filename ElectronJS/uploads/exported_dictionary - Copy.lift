</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-10T14:16:05Z" dateModified="2025-12-30T04:22:28Z" id="ćaq_4cec5a1d-da2a-4e65-81e2-ccf8944d5314" guid="4cec5a1d-da2a-4e65-81e2-ccf8944d5314">
