</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بڵ شیࣷچُم</text></form>
</field>
<sense id="c1c2cc54-f6f3-4d61-9c18-cd4d9a1a192f">
<grammatical-info value="Verb/Verbal Noun">
</grammatical-info>
<gloss lang="en"><text>annoying someone endlessly with chatter or nagging</text></gloss>
<gloss lang="ur-PK"><text>دماغ چاٹنا، دماغ کھانا</text></gloss>
<example>
<form lang="bsk"><text>un ġare ġare jaa báll śeyá. </text></form>
<translation type="Free translation">
<form lang="en"><text>You have eaten up my brain, by jabbering endlessly. </text></form>
</translation>
</example>
</sense>
</entry>
