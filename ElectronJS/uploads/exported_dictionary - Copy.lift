<entry dateCreated="2019-04-06T04:34:23Z" dateModified="2025-10-08T01:12:46Z" id="güwan_64f71934-e3c0-45d7-8869-9dee5661e0be" guid="64f71934-e3c0-45d7-8869-9dee5661e0be">
