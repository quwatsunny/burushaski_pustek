<form lang="bsk"><text>aiɛtas</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ائیࣷ ایࣷتاس</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>tas</text></form>
</field>
<trait name="Possessors" value="O-Obligatorily Possessors"/>
<sense id="138275ed-f470-40c0-8aff-58d052da37ff" order="0">
<gloss lang="en"><text>what is not to be done</text></gloss>
<gloss lang="ur-PK"><text>نہ ہونے یا کرنے کی (بات)</text></gloss>
<example>
<form lang="bsk"><text>aietas doro, aiećum báṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>What is not to be done, should't be done.</text></form>
</translation>
</example>
</sense>
<sense id="0eff57a0-00b5-41dd-abbd-5b8c46ae9079" order="1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>the one who does not do, non-doer</text></gloss>
<gloss lang="ur-PK"><text>نہ کرنے والا یا والی</text></gloss>
<example>
<form lang="bsk"><text>ja pahiṅ aietas hir en ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I am a man who does not tell lies. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-10-05T02:59:06Z" dateModified="2025-11-13T02:41:43Z" id="aietas2_197e1625-8cd0-424e-bb64-f9225ec11f00" guid="197e1625-8cd0-424e-bb64-f9225ec11f00" order="2">
