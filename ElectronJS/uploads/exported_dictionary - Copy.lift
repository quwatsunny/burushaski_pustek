</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-09-05T18:07:21Z" dateModified="2025-12-14T04:55:28Z" id="beésa_d205a1db-b02c-4bdb-85c6-3ca3f4a4bf20" guid="d205a1db-b02c-4bdb-85c6-3ca3f4a4bf20">
