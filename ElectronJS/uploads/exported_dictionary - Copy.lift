<form lang="bsk"><text>xatarxa</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>خترخا</text></form>
</field>
<sense id="5c8cbde0-2d9c-4e50-8a46-2d1172c0ff0d">
<gloss lang="en"><text>choice, being in position where one has option to choose</text></gloss>
<gloss lang="ur-PK"><text>انتخاب  کرنے کی پوزیشن میں ہونا</text></gloss>
<example>
<form lang="bsk"><text>alʰtan guśaiṅgia haraṅ xatarxa goćam, amen xoś moćom ba ka. </text></form>
<translation type="Free translation">
<form lang="en"><text>I will put in a position of choosing between two girls, whichever you like (in marriage).</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-10-15T18:48:00Z" dateModified="2025-10-26T00:49:54Z" id="xatarkha oćum_f650c6b9-dfee-45e4-b534-2f2844a6a67c" guid="f650c6b9-dfee-45e4-b534-2f2844a6a67c">
