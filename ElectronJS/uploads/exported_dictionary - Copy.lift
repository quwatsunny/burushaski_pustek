</field>
<sense id="860377fa-817c-4ae1-8bb8-6c6f98bfbc1d">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>good deed, goodness, benevolence </text></gloss>
<gloss lang="ur-PK"><text>اچھائی، نیکی ، احسان</text></gloss>
<example>
<form lang="bsk"><text>ne jaġa buṭ śuwakuṣ etum bai. </text></form>
<translation type="Free translation">
<form lang="en"><text>He has done a lot of favors to me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>goo etum ṣuwakuṣ baśa ka till ayaalʰćum. </text></form>
<translation type="Free translation">
<form lang="en"><text>I will never forget your virtue (whatever good you have done to me). </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-11-16T03:24:25Z" dateModified="2025-10-08T01:12:46Z" id="ṣ_864bed07-0e73-4d9a-aa6d-b7595bd296b2" guid="864bed07-0e73-4d9a-aa6d-b7595bd296b2">
<lexical-unit>
<form lang="bsk"><text>ṣ</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>Voiceless Retroflex Fricative</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʂ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ݜ</text></form>
</field>
<sense id="3b7ee225-5611-4d4f-938b-db96906bb698">
<gloss lang="en"><text>Consonantal Burushaski Letter, as in ṣapik (bread)</text></gloss>
<gloss lang="ur-PK"><text>ݜ</text></gloss>
</sense>
</entry>
<entry dateCreated="2022-10-03T16:05:05Z" dateModified="2025-11-30T15:51:17Z" id="-ṣ_4900ae8d-d983-4653-9784-f91307771756" guid="4900ae8d-d983-4653-9784-f91307771756">
<lexical-unit>
<form lang="bsk"><text>-ṣ</text></form>
</lexical-unit>
<trait  name="morph-type" value="suffix"/>
<note>
<form lang="en"><text>If a massage or order is given through someone else, and the addressee  is not present, this suffix is excessively used. Example: /aćhi/means give it to me while aćhiṣ means: should give me or tell him to give me. </text></form>
</note>
<relation type="Compare" ref="baliṣ2_d1541d3b-9cde-4fb6-a1ac-39f75fd006ec"/>
<relation type="Compare" ref="búṣ_bc2bbbb9-a7b0-4b23-abdf-09af8f7af41b"/>
<relation type="Compare" ref="bariṣ1_8b57050d-ce7f-4796-b2c2-4d3734696937"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>-ʂ</text></form>
</field>
<sense id="ead8adbd-267b-4606-a338-8fff596ac637">
<gloss lang="en"><text>Suffix used with verbs (mostly indirect)  to give a sense of approval or intention. It can be used for should, let, may or ought to.</text></gloss>
<example>
<form lang="bsk"><text>ne hire mo gus muchúṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>The man ought to take (merry) the woman. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hire ja ġa seniṣ</text></form>
<translation type="Free translation">
<form lang="en"><text>The man should  tell me. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mu guse ne hir chús, ja men amayam ba, amusarʰćam. </text></form>
<translation type="Free translation">
<form lang="en"><text>The man may merry the woman, who am I to stop her. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>se húk ane bi ka, biṣ. </text></form>
<translation type="Free translation">
<form lang="en"><text>Let the dog bi, wherever it is. </text></form>
</translation>
</example>
</sense>
</entry>
