<entry dateCreated="2019-05-25T15:33:35Z" dateModified="2025-10-08T01:12:46Z" id="manéãs_e7adc619-9f85-4166-af41-fac9c431710b" guid="e7adc619-9f85-4166-af41-fac9c431710b">
<lexical-unit>
