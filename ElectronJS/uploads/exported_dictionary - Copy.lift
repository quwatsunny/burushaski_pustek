<entry dateCreated="2023-01-27T03:44:13Z" dateModified="2025-10-08T01:12:46Z" id="e3_81c2947b-78ff-4724-adf6-4a5b8bc9e8be" guid="81c2947b-78ff-4724-adf6-4a5b8bc9e8be">
<lexical-unit>
<form lang="bsk"><text>e</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اےࣷ</text></form>
</field>
<sense id="fe504628-14bb-43ff-8d3f-c3a633520e2c">
<gloss lang="en"><text>The vowel letter E</text></gloss>
</sense>
</entry>
<entry dateCreated="2019-04-15T17:57:02Z" dateModified="2025-10-08T01:12:46Z" id="e2_7a0f8ca7-38b0-44ee-aec2-cbe6778709c2" guid="7a0f8ca7-38b0-44ee-aec2-cbe6778709c2">
<lexical-unit>
<form lang="bsk"><text>e</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>This case marker is used with most nouns and pronouns except the noun class hf which takes the suffix /mo/.  Additionally, all words ending in vowels will lengthen the vowels to mark the Genitive case.  See all examples above. </text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اےࣷ</text></form>
</field>
<sense id="e0b23c73-c919-4a0e-b782-2b18fc4c69cd">
<gloss lang="en"><text>Genitive case marker, of</text></gloss>
<gloss lang="ur-PK"><text>مضاف الیہ، ملکیتی ربط کے لیے۔ </text></gloss>
<example>
<form lang="bsk"><text>hallanze gari  </text></form>
<translation type="Free translation">
<form lang="en"><text>the light of the moon or moonlight.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>huke há</text></form>
<translation type="Free translation">
<form lang="en"><text>dog's house</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>huke ẓakune báll śey.</text></form>
<translation type="Free translation">
<form lang="en"><text>The dog ate the donkey's brain. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>jaa huke ġarí.</text></form>
<translation type="Free translation">
<form lang="en"><text>My dog barked.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>haġora-a  jaġaiṅ</text></form>
<translation type="Free translation">
<form lang="en"><text>Places of the horses. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>Boyo-mo śaniṅ. </text></form>
<translation type="Free translation">
<form lang="en"><text>The gardens of the boyo. (female mythical being). </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2024-07-12T23:43:47Z" dateModified="2025-10-08T01:12:46Z" id="e4_3c82f415-f7c8-47b3-9bc6-d4c502cbb717" guid="3c82f415-f7c8-47b3-9bc6-d4c502cbb717">
<lexical-unit>
<form lang="bsk"><text>e</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="_component-lexeme" ref="d7bbd213-629b-4dae-921e-cc42b97358cc" order="0">
<trait name="is-primary" value="true"/>
<trait  name="complex-form-type" value="Inflection"/>
</relation>
<trait name="do-not-publish-in" value="Idioms"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ےࣷ</text></form>
</field>
<sense id="0d64d7cb-b578-4bdc-9376-08b8aea0338d">
<grammatical-info value="Locative (ći, i)">
</grammatical-info>
<gloss lang="en"><text>Locative case marker with the meaning of 'at', 'on' and sometimes for 'in'</text></gloss>
<gloss lang="ur-PK"><text>پر، میں</text></gloss>
<example>
<form lang="bsk"><text>ne yaṭe ġasé bee. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not laugh at him. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus mo ġoyaṅ yare (yar +e) ḍis maní. </text></form>
<translation type="Free translation">
<form lang="en"><text>That woman's hair reached down at the ground. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2021-04-24T23:03:54Z" dateModified="2025-10-08T01:12:46Z" id="e1_11cf6301-3276-48fb-80d3-9e98508c03d2" guid="11cf6301-3276-48fb-80d3-9e98508c03d2">
<lexical-unit>
<form lang="bsk"><text>e</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>In Yasin Burushaski, Personal Pronouns ja, ma, un are unmarked while the pronouns we, khuwe, mo are marked by simply lengthening the ending vowels. For  Ergativity purpose, all words ending in vowels, will lengthen the vowels, See example of /haġora-a/ above. </text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text> اےࣷ</text></form>
</field>
<sense id="86f0b937-aaab-4b30-b1f1-54de42d0a21d">
<gloss lang="en"><text>Ergative case marker, by</text></gloss>
<gloss lang="ur-PK"><text>نے </text></gloss>
<example>
<form lang="bsk"><text>ne hire haġor delʰtumani.</text></form>
<translation type="Free translation">
<form lang="en"><text>The man returned the horse. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>haġor dulʰtumani.</text></form>
<translation type="Free translation">
<form lang="en"><text>The horse returned. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>jaġa ne hire seni. </text></form>
<translation type="Free translation">
<form lang="en"><text>To me that man said. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>haġoraa maliṅ śeyen. </text></form>
<translation type="Free translation">
<form lang="en"><text>The horses ate the (crop) fields. </text></form>
</translation>
</example>
</sense>
</entry>
