<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>with you, in your possession</text></gloss>
<gloss lang="ur-PK"><text>پاس، ہاں</text></gloss>
<example>
<form lang="bsk"><text>gopaćí bo bar an duwa ka sen.</text></form>
<translation type="Free translation">
<form lang="en"><text>If you have a word (anything),say it. </text></form>
</translation>
</example>
</sense>
</entry>
