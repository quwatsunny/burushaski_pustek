<field type="IPA Burushaski">
<form lang="bsk"><text>akhilʰts</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکھِلڎ</text></form>
</field>
<sense id="40fd078e-c859-4d33-a661-28d77a231ea4">
<grammatical-info value="Determiner">
</grammatical-info>
<gloss lang="en"><text>this sort of </text></gloss>
<gloss lang="ur-PK"><text>ایسی/ایسا</text></gloss>
<example>
<form lang="bsk"><text>akhílʰc doro án yara baśa aimanum duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>This sort of event has never happened before.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-16T14:23:41Z" dateModified="2025-11-15T02:32:28Z" id="akhilʰću_9935b561-22c1-486c-b5da-ccc42b6475a0" guid="9935b561-22c1-486c-b5da-ccc42b6475a0">
