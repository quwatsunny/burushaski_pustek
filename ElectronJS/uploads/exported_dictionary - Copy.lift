<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="ćhaambo dećum_1fa2f0bd-a2b8-400b-b118-3ea40ae8e991"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>khuːski</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>کھوسکیࣷ</text></form>
</field>
<sense id="92c4c1a7-c594-4f2f-93aa-332f2f7324fa" order="0">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>In the game of ćhambe (tip-cat), a trick where the player stands on one leg, the other leg lifted over the stick of tip-cat, and hits the billet of wood.  This way of playing is called khuuski. </text></gloss>
</sense>
<sense id="31ef149a-6c0f-41ee-a33e-427ac0d126f1" order="1">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>By way of one's ass</text></gloss>
<gloss lang="ur-PK"><text>گانڈ کے ذریعے</text></gloss>
</sense>
</entry>
<entry dateCreated="2019-04-27T07:49:19Z" dateModified="2025-10-08T01:12:46Z" id="khuuśi me duusum_1d323534-9b78-4a33-bc92-3af8ae2ec34b" guid="1d323534-9b78-4a33-bc92-3af8ae2ec34b">
