<example>
<form lang="bsk"><text>chor hek an gusen buastumu, mo guse minyahaṅ etastumú. </text></form>
<translation type="Free translation">
<form lang="en"><text>Once upon a time, there happened to be a woman. That woman used to tell stories. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>le khin akhi śuwa gus en buastumu. </text></form>
<translation type="Free translation">
<form lang="en"><text>Hey, this over here, happen to be such a good woman. </text></form>
</translation>
</example>
</sense>
</entry>
