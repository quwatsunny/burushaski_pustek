<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>(of a fabric) velvet</text></gloss>
<gloss lang="ur-PK"><text>مخمل</text></gloss>
<example>
<form lang="bsk"><text>baxmalimiṅ bo ećum ba?</text></form>
<translation type="Free translation">
<form lang="en"><text>What are you going to do with the velvets. </text></form>
</translation>
</example>
<example>
