<lexical-unit>
<form lang="bsk"><text>brane śaṭomo ce baṣc̣ek</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<note>
<form lang="en"><text>The idiom is associated with a fox that once followed a ram all the way to its owner's home, expecting the ram's big hanging testicles to fall for the fox to eat. The fox was destined to be met by the owner of the ram. </text></form>
</note>
<relation type="_component-lexeme" ref="bran_18cea467-58f2-4191-9792-f5f55d06be69" order="0">
<trait name="is-primary" value="true"/>
<trait  name="complex-form-type" value="Idiom"/>
</relation>
<relation type="_component-lexeme" ref="śaṭomo_20638f14-4afc-4716-a512-ee4d8f3ca5b0" order="1">
<trait  name="complex-form-type" value="Idiom"/>
</relation>
<relation type="_component-lexeme" ref="baṣc̣ek1_9db0b71f-8655-449f-a9cc-0b3eb177a22b" order="2">
<trait  name="complex-form-type" value="Idiom"/>
</relation>
<field type="IPA Burushaski">
<form lang="bsk"><text>branɛ ʃaʈomo tsɛ baʂʈʂɛk</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>برَنےࣷ  شٹوࣷ موࣷ ڎے بݜڅیࣷک </text></form>
</field>
<trait name="Review 1" value="202512191"/>
<sense id="29daa42e-cfb1-45fa-8f51-1cd318f08495">
<grammatical-info value="Idiom">
</grammatical-info>
<gloss lang="en"><text>false or unrealistic expectation</text></gloss>
<gloss lang="ur-PK"><text>توقع جو حقیقت پسندانا نہ ہو۔  </text></gloss>
</sense>
</entry>
