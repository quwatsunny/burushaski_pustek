<entry dateCreated="2020-05-11T22:05:15Z" dateModified="2025-11-02T23:19:22Z" id="talġo_c20e1a97-e249-4421-ac88-2f3565723794" guid="c20e1a97-e249-4421-ac88-2f3565723794">
<lexical-unit>
<form lang="bsk"><text>tallġo</text></form>
</lexical-unit>
