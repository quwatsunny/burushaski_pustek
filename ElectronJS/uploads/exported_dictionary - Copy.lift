<gloss lang="ur-PK"><text>تہوں میں، دفعہ یا باری</text></gloss>
<example>
<form lang="bsk"><text>ja alʰto cherʰki ses ooriya. </text></form>
<translation type="Free translation">
<form lang="en"><text>I sent people in two rounds.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja alʰto cherki gaṭunz wellam ba. </text></form>
<translation type="Free translation">
