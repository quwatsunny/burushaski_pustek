<gloss lang="ur-PK"><text>ایسا کر کے، اِس طرح</text></gloss>
<example>
<form lang="bsk"><text>un ajo bláś doro ećum ba, akhi net espaśa awulluma. </text></form>
<translation type="Free translation">
<form lang="en"><text>You work very slow, having done (it) in such way,you won’t be able to settle it.</text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-30T05:09:47Z" dateModified="2025-11-15T02:11:51Z" id="akhi-akhi_d1c83158-3050-428d-b41f-a3da26650674" guid="d1c83158-3050-428d-b41f-a3da26650674">
<lexical-unit>
<form lang="bsk"><text>akhi-akhi</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>akhi-akhi</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>اکھیࣷ اکھیࣷ</text></form>
</field>
<sense id="64a49168-70e8-46c5-9232-9a7cc6054a10">
<grammatical-info value="Determiner">
</grammatical-info>
<gloss lang="en"><text>so and so, thus and so, such and such</text></gloss>
<gloss lang="ur-PK"><text>فلاں فلاں، ایسی ایسی، ایسا ایسا</text></gloss>
<example>
<form lang="bsk"><text>akhi-akhi ses, akhi-akhi doro, akhi-akhi gunz</text></form>
<translation type="Free translation">
<form lang="en"><text>so and so people, so and so work, such and such day </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-03-18T02:55:32Z" dateModified="2025-11-15T02:13:19Z" id="akhi_4bc3a671-03ed-4169-b11c-bb08438b66d1" guid="4bc3a671-03ed-4169-b11c-bb08438b66d1">
<lexical-unit>
