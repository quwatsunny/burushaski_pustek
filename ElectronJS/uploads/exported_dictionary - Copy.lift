<entry dateCreated="2024-05-01T03:31:34Z" dateModified="2025-10-08T01:12:46Z" id="khaṣiṣ_263d47d5-c345-4dac-8147-16d15c09203f" guid="263d47d5-c345-4dac-8147-16d15c09203f">
<lexical-unit>
