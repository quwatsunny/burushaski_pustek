<gloss lang="ur-PK"><text>تُندی، طوفانی ہوا</text></gloss>
<example>
<form lang="bsk"><text>holle, ajo babuẓán tiṣ án dusi.</text></form>
<translation type="Free translation">
<form lang="en"><text>A fierce wind started outside.  </text></form>
</translation>
</example>
</sense>
<sense id="1df383df-a0df-483a-be03-c771d10abd2b" order="1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>fiercely, aggressive, aggressor</text></gloss>
<gloss lang="ur-PK"><text>جارِح، تُند خوُ</text></gloss>
<example>
<form lang="bsk"><text>ne ajó babuẓán hir en bai.</text></form>
<translation type="Free translation">
<form lang="en"><text>He is a very fierce man.</text></form>
</translation>
</example>
</sense>
</entry>
