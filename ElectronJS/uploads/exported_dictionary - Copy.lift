<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>claim </text></gloss>
<gloss lang="ur-PK"><text>دعوایٰ</text></gloss>
<example>
<form lang="bsk"><text>har jinari yaṭe sáq ayet. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not claim or claim control over everything. </text></form>
</translation>
</example>
</sense>
</entry>
