<entry dateCreated="2020-05-20T07:29:56Z" dateModified="2025-12-10T15:32:51Z" id="beé ka_6427a300-5cbe-4289-a8d8-5b48c2f50e2d" guid="6427a300-5cbe-4289-a8d8-5b48c2f50e2d">
<lexical-unit>
<form lang="bsk"><text>bee ka</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<relation type="_component-lexeme" ref="">
<trait  name="complex-form-type" value="Unspecified Complex Form"/>
</relation>
<field type="IPA Burushaski">
<form lang="bsk"><text>bɛɛ ka</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بے کاࣷ</text></form>
</field>
<sense id="7080ea21-6a26-4d29-8232-eac4008a0d7d">
<grammatical-info value="Conjunction">
</grammatical-info>
<gloss lang="en"><text>otherwise, if not</text></gloss>
<gloss lang="ur-PK"><text>نہیں تو</text></gloss>
<example>
<form lang="bsk"><text>jaa daṅ diim duwa, beé ka goġa minyás án ećam cek.</text></form>
<translation type="Free translation">
<form lang="en"><text>I am sleepy otherwise I could have told you a story. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-11T02:42:38Z" dateModified="2025-12-15T04:11:07Z" id="beérum2_5cc47af7-3b86-45b6-9e02-99b47aafb858" guid="5cc47af7-3b86-45b6-9e02-99b47aafb858" order="1">
<lexical-unit>
<form lang="bsk"><text>beerum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<relation type="Compare" ref="akhurum án_5a564370-ac75-4c4b-8b6b-9c2f6f06ec50"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>bɛɛrum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بے رُم </text></form>
</field>
<sense id="6dcb5f77-cd42-4e8f-a5f2-f0d788416f9b">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>how much/how many</text></gloss>
<gloss lang="ur-PK"><text>کتنا یا کتنے۔</text></gloss>
<example>
<form lang="bsk"><text>gusee beerum yaṣc̣ duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>How much is the price of this?</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>goġa beérum den mani akho dokoo?</text></form>
<translation type="Free translation">
<form lang="en"><text>How many years have passed, after you having come here. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>beerum galʰtći ġoġa sená, bar aiyána. </text></form>
<translation type="Free translation">
<form lang="en"><text>How many times I told you, you did not take my advice. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-07-07T03:21:14Z" dateModified="2025-12-15T04:11:07Z" id="beérum1_1a91047e-72fb-4b3e-8400-c36f11a2e43a" guid="1a91047e-72fb-4b3e-8400-c36f11a2e43a" order="2">
<lexical-unit>
<form lang="bsk"><text>beerum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>bɛɛrum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بے رُم </text></form>
</field>
<sense id="ea446dd3-0a6d-4a1e-b8bb-83a2b2d18f00">
<grammatical-info value="Quantifier">
</grammatical-info>
<gloss lang="en"><text>some, as much as, many, several, so many</text></gloss>
<gloss lang="ur-PK"><text>اتنے، کچھ، کئی </text></gloss>
<example>
<form lang="bsk"><text>beerum sese beerum bariṅ eten. </text></form>
<translation type="Free translation">
<form lang="en"><text>So many people, said so many things. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>beerum ses acheći duya. </text></form>
<translation type="Free translation">
<form lang="en"><text>So many people came after me. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-05-11T02:50:30Z" dateModified="2025-12-15T04:12:46Z" id="beérum án_4691a537-95c8-40ea-9a83-e8423cfcf55c" guid="4691a537-95c8-40ea-9a83-e8423cfcf55c">
<lexical-unit>
<form lang="bsk"><text>beerum án</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>bɛɛrum ʌn</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>بے رُم اَن </text></form>
</field>
<sense id="c2d581aa-c752-4a73-9a8e-355c3a38b8e8">
<grammatical-info value="Interrogative Adverb">
</grammatical-info>
<gloss lang="en"><text>how much or how many (rough estimation required), some</text></gloss>
<gloss lang="ur-PK"><text>انذاً کتنا۔ کتنا کچھ</text></gloss>
<example>
<form lang="bsk"><text>beerum án sese senen. </text></form>
<translation type="Free translation">
<form lang="en"><text>Some people said. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>beérum án ses duya?</text></form>
<translation type="Free translation">
<form lang="en"><text>Roughly, how many people came?</text></form>
</translation>
</example>
</sense>
</entry>
