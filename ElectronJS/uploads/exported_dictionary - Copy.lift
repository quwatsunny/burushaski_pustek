<entry dateCreated="2019-10-15T18:46:10Z" dateModified="2025-10-23T23:44:58Z" id="xatarxa_56e97387-303a-4ca8-957b-b10f5710afae" guid="56e97387-303a-4ca8-957b-b10f5710afae">
<lexical-unit>
<form lang="bsk"><text>xatarxa</text></form>
</lexical-unit>
