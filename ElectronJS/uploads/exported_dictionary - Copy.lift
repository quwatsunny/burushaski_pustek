<entry dateCreated="2019-09-16T05:40:39Z" dateModified="2025-10-08T01:12:46Z" id="zaili1_830c46ad-01b1-4dde-88ed-c9e23a252f0a" guid="830c46ad-01b1-4dde-88ed-c9e23a252f0a">
<lexical-unit>
<form lang="bsk"><text>zaili</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>zaili</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ذیلی</text></form>
</field>
<sense id="6af3c03a-23a3-481d-978b-6093e68999cd" order="0">
<gloss lang="en"><text>being in a certain condition or way</text></gloss>
<gloss lang="ur-PK"><text>کی طرح ، کی حالت میں ہونا</text></gloss>
<example>
<form lang="bsk"><text>Bo zaili ba?</text></form>
<translation type="Free translation">
<form lang="en"><text>How are you? (What condition are you in?)</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne te zaili ya bai. </text></form>
<translation type="Free translation">
<form lang="en"><text>He is in that same condition. </text></form>
</translation>
</example>
</sense>
<sense id="cbfaae99-ac81-4147-a62a-8da526a3a50b" order="1">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>like, similarly</text></gloss>
<gloss lang="ur-PK"><text>کی طرح</text></gloss>
<example>
<form lang="bsk"><text>ne belʰtum girminum bai ka, un te zaili ya girmin. </text></form>
<translation type="Free translation">
<form lang="en"><text>However he has written, you write similar to that. </text></form>
</translation>
</example>
</sense>
<sense id="56278427-ce18-4f61-b87f-a549ef7f6121" order="2">
<gloss lang="en"><text>type, sort</text></gloss>
<gloss lang="ur-PK"><text>قسم</text></gloss>
<example>
<form lang="bsk"><text>Khin bo zaili hir en bai.</text></form>
<translation type="Free translation">
<form lang="en"><text>What type of a person is this. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>Islamabad bo zaili jaġa án duwa?</text></form>
<translation type="Free translation">
<form lang="en"><text>What sort of place is Islamabad?</text></form>
</translation>
</example>
</sense>
</entry>
