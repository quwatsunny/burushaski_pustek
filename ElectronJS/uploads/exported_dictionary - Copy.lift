<form lang="bsk"><text>bur tapari</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<relation type="Compare" ref="bür_b3246870-dc8f-489c-aa1a-1cd7fdbc394c"/>
<relation type="Compare" ref="tapari_75cef3be-bebf-4284-9775-c92b69f23135"/>
