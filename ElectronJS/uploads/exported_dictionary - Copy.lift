<gloss lang="ur-PK"><text>بُنیاد </text></gloss>
<example source="                ">
<form lang="bsk"><text>ja gamuná dohónam ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I have started (to) the foundation. </text></form>
</translation>
<note type="reference">
<form lang="en"><text>                </text></form>
</note>
</example>
</sense>
</entry>
