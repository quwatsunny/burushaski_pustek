<sense id="cf6a4fa7-9c4f-4141-a1d6-fda4ca2b9580">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>a very fine alluvial earth used as a  white clay ink to write on dark surfaces. The clay is also used as a paint to whiten walls.</text></gloss>
<trait name ="semantic-domain-ddp4" value="1.2.1 Land"/>
</sense>
</entry>
