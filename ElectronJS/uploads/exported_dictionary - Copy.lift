</field>
<sense id="87389f35-f8f9-435e-8c16-c0d5b8a75dc3">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>The path that is traced by light, radiation or photon. ray</text></gloss>
<gloss lang="ur-PK"><text>روشنی کی کرن</text></gloss>
<example>
<form lang="bsk"><text>thápe ćhar ce yárimo giyayen, ane mathan jiip an dia, ja guman.</text></form>
<translation type="Free translation">
<form lang="en"><text>At night, beams of light fell on the mountain, I guess there came a vehicle somewhere afar.</text></form>
</translation>
</example>
<trait name ="semantic-domain-ddp4" value="8.3.3 Light"/>
</sense>
</entry>
