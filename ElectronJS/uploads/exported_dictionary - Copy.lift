<gloss lang="en"><text>Ergative case marker used with words that already end in the vowel /u/</text></gloss>
<example>
<form lang="bsk"><text>dullaśuu (dullas + u + u)  uwelji yecen.</text></form>
<translation>
<form lang="en"><text>The boys saw in their dream. </text></form>
</translation>
<translation type="Free translation">
<form lang="en"><text>The Kids-ERG PL-dream-LOC saw-3PL-hx.</text></form>
</translation>
</example>
</sense>
<sense id="92339dec-0f44-495b-9263-0e785d667dcf" order="1">
<grammatical-info value="Genitive (e)">
</grammatical-info>
<gloss lang="en"><text>Genitive case marker, used with words already ending in the vowel /u/</text></gloss>
<example>
<form lang="bsk"><text>brayuu turyaṅ galjam bica. </text></form>
<translation type="Free translation">
<form lang="en"><text>ram-Pl-GEN horn-PL break-PL be-PL-PST. </text></form>
</translation>
<translation>
<form lang="en"><text>The horns of the rams have broken. </text></form>
</translation>
</example>
</sense>
</entry>
