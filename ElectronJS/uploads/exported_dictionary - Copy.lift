<entry dateCreated="2022-12-06T03:50:06Z" dateModified="2025-10-08T01:12:46Z" id="giraśa_17af007d-a976-4798-b9b5-934289fb3714" guid="17af007d-a976-4798-b9b5-934289fb3714">
<lexical-unit>
<form lang="bsk"><text>giraśa</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The /t/ of /girat/ drops as a result of  co-articulation of /t/ and /ś/.  gira(t)śa. </text></form>
</note>
<relation type="Compare" ref="girat_90059f61-6c3d-4771-8bb4-899afb1977d6"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>giraʃa</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>گراشاࣷ</text></form>
</field>
<sense id="e50337d8-2d8a-4a9f-91fd-bedef32d9d5d" order="0">
<grammatical-info value="Dative (a, ġa)">
</grammatical-info>
<gloss lang="en"><text>to/for dance</text></gloss>
<gloss lang="ur-PK"><text>ناچنے کے لیے</text></gloss>
<example>
<form lang="bsk"><text>ne hir giraśa duusi. </text></form>
<translation type="Free translation">
<form lang="en"><text>That man came out to dance.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>un giraśa awulumá</text></form>
<translation type="Free translation">
<form lang="en"><text>You would not be able to dance. </text></form>
</translation>
</example>
</sense>
<sense id="829495b4-ad3f-40e4-b8ed-553684066934" order="1">
<gloss lang="en"><text>when danced, upon dancing</text></gloss>
<gloss lang="ur-PK"><text>جب ناچا</text></gloss>
<example>
<form lang="bsk"><text>ne giraśa ja xarc etá.</text></form>
<translation type="Free translation">
<form lang="en"><text>I clapped when he started dancing.</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo giraśa ja c̣hiu amaná. </text></form>
<translation type="Free translation">
<form lang="en"><text>I became ecstatic when she danced. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-17T15:20:24Z" dateModified="2025-10-08T01:12:46Z" id="giraśum_aea72d96-e293-40a7-a604-d29410aef228" guid="aea72d96-e293-40a7-a604-d29410aef228">
