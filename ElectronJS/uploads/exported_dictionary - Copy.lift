</translation>
</example>
<example>
<form lang="bsk"><text>ja caṭ ćhaiṅgi huweya. </text></form>
<translation type="Free translation">
<form lang="en"><text>I ran straight down. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>cak caṭ deeyi. </text></form>
<translation type="Free translation">
<form lang="en"><text>Erect the prop straight up. </text></form>
</translation>
</example>
</sense>
</entry>
