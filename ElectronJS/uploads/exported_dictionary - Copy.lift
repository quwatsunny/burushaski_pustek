<sense id="32460d6b-8045-455e-b7b6-7674c89fc252">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>A stubborn argument, especially one based on unfounded claims</text></gloss>
<gloss lang="ur-PK"><text>بے جا تکرار ، بحث</text></gloss>
<example>
<form lang="bsk"><text>ne Rustame yé bai, muna baall bota?</text></form>
<translation type="Free translation">
