<entry dateCreated="2021-08-04T01:52:14Z" dateModified="2025-10-08T01:12:46Z" id="śóllśóll_cb754cb2-04b4-483b-b6f9-153ab1c1a4d0" guid="cb754cb2-04b4-483b-b6f9-153ab1c1a4d0">
<lexical-unit>
<form lang="bsk"><text>śóllśóll</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ʃɔɫʃɔɫ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>شوࣷلٚ شوࣷلٚ</text></form>
</field>
<field type="Plural Suffix">
<form lang="bsk"><text>iśu</text></form>
</field>
<sense id="5ae41645-9f12-4ce1-98da-007f80ee3189">
<grammatical-info value="Adverb">
</grammatical-info>
<gloss lang="en"><text>scattered in pieces or fragments</text></gloss>
<gloss lang="ur-PK"><text>بیکھرا بیکھرا</text></gloss>
<example>
<form lang="bsk"><text>jú yaara śollśoll manen. </text></form>
<translation type="Free translation">
<form lang="en"><text>Apricots fell down and became scattered. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hire gaṭunz dexeśa śollśoll manum biyen. </text></form>
<translation type="Free translation">
<form lang="en"><text>The clothes of that man, having gotten ripped, have become scattered in fragments. </text></form>
</translation>
</example>
</sense>
</entry>
