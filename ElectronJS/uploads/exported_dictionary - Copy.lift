<entry dateCreated="2022-12-30T04:53:23Z" dateModified="2025-10-08T01:12:46Z" id="kundu_15399080-811a-4291-b855-b6bedd404a34" guid="15399080-811a-4291-b855-b6bedd404a34">
<lexical-unit>
<form lang="bsk"><text>kundu</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>kundu</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>کُندُو</text></form>
</field>
<sense id="688b09f1-dd25-4194-bc1a-27806162e1f6">
<grammatical-info value="Noun">
</grammatical-info>
<gloss lang="en"><text>The core or innermost part of one's body. The term is rather subjective and could also mean one's heart, gut or even a woman's womb.  </text></gloss>
<example>
<form lang="bsk"><text>jaa kundu ġólí.</text></form>
<translation type="Free translation">
<form lang="en"><text>It gutted me to the core. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>nani mo kunduu mulʰtan</text></form>
<translation type="Free translation">
<form lang="en"><text>The blood of a mother's womb. </text></form>
</translation>
</example>
</sense>
</entry>
