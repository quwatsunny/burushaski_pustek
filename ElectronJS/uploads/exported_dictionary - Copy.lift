<gloss lang="ur-PK"><text>بدر کرنا، نکال باہر کرنا، جانے پر مجبور کرنا۔</text></gloss>
<example>
<form lang="bsk"><text>śum ses bathanum ehuc̣umaan.</text></form>
<translation type="Free translation">
<form lang="en"><text>Bad people are banished from the country.  </text></form>
</translation>
</example>
</sense>
</entry>
