</translation>
</example>
<example>
<form lang="bsk"><text>phuk án bo awućum cek ka, gucúm xośaan amayam cek. </text></form>
<translation type="Free translation">
<form lang="en"><text>I would have been happy with you, if you had given me something. </text></form>
</translation>
</example>
</sense>
</entry>
