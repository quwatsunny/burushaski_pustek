<form lang="ur-PK"><text>من</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>mán</text></form>
</field>
<trait name="Possessors" value="U-Obligatorily Possessors"/>
<sense id="2053a77e-83cb-4cc8-9722-7daa49a31c85">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>be, happen or become. It will always take Possessive affixes. </text></gloss>
<gloss lang="ur-PK"><text>ہو، بن جا۔ </text></gloss>
<example>
<form lang="bsk"><text>śuwa hir gumán</text></form>
<translation type="Free translation">
<form lang="en"><text>Be a good man.. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne hir lahaaz mani. </text></form>
<translation type="Free translation">
<form lang="en"><text>The man became sick. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja lahaaz amayam</text></form>
<translation type="Free translation">
<form lang="en"><text>I will become sick. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja malal amayam.</text></form>
<translation type="Free translation">
<form lang="en"><text>I will be late. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>mo gus chullum mumanú. </text></form>
<translation type="Free translation">
<form lang="en"><text>The lady became pregnant. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>bo maní le ac̣o.</text></form>
<translation type="Free translation">
<form lang="en"><text>What happened bro?</text></form>
</translation>
</example>
</sense>
</entry>
