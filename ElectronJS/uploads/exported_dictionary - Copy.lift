</translation>
</example>
</sense>
</entry>
<entry dateCreated="2020-11-29T22:19:18Z" dateModified="2025-11-12T02:35:14Z" id="aaġayini_d19a0e1c-afec-4c1c-a53f-b2332c2dbfaa" guid="d19a0e1c-afec-4c1c-a53f-b2332c2dbfaa">
