<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>یہ</text></form>
</field>
<trait name="Verb Types" value="et. TR."/>
<sense id="a38ddf51-5496-4873-bd2a-d03661e41a94">
<gloss lang="en"><text>cease, end, stop, no</text></gloss>
<gloss lang="ur-PK"><text>ترک، ختم ، بس، نہیں </text></gloss>
<example>
<form lang="bsk"><text>ne hire ṣic̣um yáh etum bai.</text></form>
<translation type="Free translation">
<form lang="en"><text>That man has stopped eating. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja phaiṅ ećum yáh eṭam ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I have given up telling lies. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>yáh tayi akuwáṇ</text></form>
<translation type="Free translation">
<form lang="en"><text>no, do not be like that. </text></form>
</translation>
</example>
</sense>
</entry>
