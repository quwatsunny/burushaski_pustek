<sense id="8025b3e0-2039-4b26-a10d-dca21743db35" order="1">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>word of contempt for unintelligent person</text></gloss>
<gloss lang="ur-PK"><text>بے وقوف کے لیے حقارت سے بولا جاتا ہے۔ </text></gloss>
<example>
