<translation type="Free translation">
<form lang="en"><text>My work needs to be done. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>neiṅga bariṅ etaas duwá.</text></form>
<translation type="Free translation">
<form lang="en"><text>He needs to be spoken to. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>awuśu ẓowas baan, ha khaas etaas duwá.</text></form>
<translation type="Free translation">
<form lang="en"><text>Guests are to come, the house needs to be cleaned. </text></form>
</translation>
</example>
</sense>
</entry>
