<entry dateCreated="2019-04-06T17:27:59Z" dateModified="2025-10-08T01:12:46Z" id="ŝhaďar_a91dbc2a-a265-4329-b227-a574bcda2f01" guid="a91dbc2a-a265-4329-b227-a574bcda2f01">
<lexical-unit>
<form lang="bsk"><text>ṣádar</text></form>
</lexical-unit>
