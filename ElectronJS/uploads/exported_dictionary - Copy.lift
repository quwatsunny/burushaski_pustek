<sense id="6727334d-8118-4c57-862e-f75f9918c9b6">
<grammatical-info value="Imperative">
</grammatical-info>
<gloss lang="en"><text>Do not forget</text></gloss>
<gloss lang="ur-PK"><text>بھول مت جانا، مت بھولو</text></gloss>
<example>
