<form lang="en"><text>I brought up my kids. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>jaa ayu dusmainen. </text></form>
<translation type="Free translation">
<form lang="en"><text>My kids grew up.</text></form>
</translation>
</example>
<example>
