<entry dateCreated="2019-09-19T15:37:17Z" dateModified="2025-10-20T13:26:11Z" id="túśi tenjo kam biyena_47d0f71b-7ebc-42d2-987e-e870ecbe8da3" guid="47d0f71b-7ebc-42d2-987e-e870ecbe8da3">
<lexical-unit>
<form lang="bsk"><text>túśi tenjo kam biyena</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
