<entry dateCreated="2020-03-11T03:30:16Z" dateModified="2025-10-08T01:12:46Z" id="darját_e148fc08-b35d-4798-b1fc-0e723ac384c6" guid="e148fc08-b35d-4798-b1fc-0e723ac384c6">
<lexical-unit>
