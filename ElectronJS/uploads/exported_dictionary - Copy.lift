<entry dateCreated="2022-11-16T03:26:37Z" dateModified="2025-10-08T01:12:46Z" id="ṅ_f57e5502-4b64-4773-a0bb-b5b93609d8b3" guid="f57e5502-4b64-4773-a0bb-b5b93609d8b3">
<lexical-unit>
<form lang="bsk"><text>ṅ</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ŋ</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ݩ</text></form>
</field>
<trait name="Review 1" value="202506151"/>
<sense id="8571aec6-f783-4f0f-9bcb-b67540a17a68">
<gloss lang="en"><text>voiced velar nasal, consonantal sound for ng, as in English. In a syllabic structure, it will never appear as an initial syllable. </text></gloss>
<example>
<form lang="bsk"><text>ṭiṅan gáli.</text></form>
<translation type="Free translation">
<form lang="en"><text>The egg broke. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>pháiṅ aiet. </text></form>
<translation type="Free translation">
<form lang="en"><text>Do not lie. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja ṭiṅan gállá.</text></form>
<translation type="Free translation">
<form lang="en"><text>I broke the egg. </text></form>
</translation>
</example>
</sense>
</entry>
