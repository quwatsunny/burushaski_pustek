</grammatical-info>
<gloss lang="en"><text>I (1SG, in a subjective case)</text></gloss>
<gloss lang="ur-PK"><text>میں</text></gloss>
<example>
<form lang="bsk"><text>ja go ġa senná</text></form>
<translation type="Free translation">
<form lang="en"><text>I told you. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja hir en ba. </text></form>
<translation type="Free translation">
<form lang="en"><text>I am a man. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-04-10T09:43:58Z" dateModified="2025-10-08T01:12:46Z" id="jaa_af00cce6-b0ad-425c-8ebb-e6d8589d9c54" guid="af00cce6-b0ad-425c-8ebb-e6d8589d9c54">
