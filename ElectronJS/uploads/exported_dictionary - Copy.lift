<entry dateCreated="2022-10-31T15:37:19Z" dateModified="2025-11-03T04:00:24Z" id="ećam_65498b10-d9a2-4cb3-b17b-70dcb43af963" guid="65498b10-d9a2-4cb3-b17b-70dcb43af963">
<lexical-unit>
<form lang="bsk"><text>ećam</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>The /t/ in the etćam (et+ćam) is dropped. /ćam/ is a FUT suffix used with 1SG. Other forms are ćan (1PL), ćuma(2SG), ćumu(3SG,hf), ćemen(3PL,2PL), ćimi(3SG,hm.x)</text></form>
</note>
<relation type="_component-lexeme" ref="étt_60304497-dab2-43e5-8696-8be2db986e51" order="0">
<trait name="is-primary" value="true"/>
<trait  name="complex-form-type" value="Inflection"/>
</relation>
<relation type="Compare" ref="ećan_06c040a3-07a2-4de0-8ef8-5c7e84591f0b"/>
<relation type="Compare" ref="étt_60304497-dab2-43e5-8696-8be2db986e51"/>
<trait name="Future Suffixes" value="Future Verb (ćam)"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛtʃam</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ایࣷچم</text></form>
</field>
<field type="Possessed">
<form lang="bsk"><text>et</text></form>
</field>
<sense id="15ca0592-b461-45a9-9576-070963ad470d">
<grammatical-info value="Verb">
</grammatical-info>
<gloss lang="en"><text>FUT of /et/, (1SG) will do or make</text></gloss>
<gloss lang="ur-PK"><text>فعل/ایۡت) کا مستقبل، یعنی کروں گا۔ </text></gloss>
<example>
<form lang="bsk"><text>ja bariṅ ećam. </text></form>
<translation type="Free translation">
<form lang="en"><text>I will do the talking. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ja ćai ećam,</text></form>
<translation type="Free translation">
<form lang="en"><text>I will make tea. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2022-10-31T15:22:51Z" dateModified="2025-11-03T04:01:46Z" id="ećam ba siya_7011a39c-d3bf-4fff-963e-c7290daf0e71" guid="7011a39c-d3bf-4fff-963e-c7290daf0e71">
<lexical-unit>
<form lang="bsk"><text>ećam ba siya</text></form>
</lexical-unit>
<trait  name="morph-type" value="phrase"/>
<note>
<form lang="en"><text>The Interjection usually comes in-between two statements. </text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>ɛtʃam ba siya</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ایࣷچم با سیاࣷ</text></form>
</field>
<sense id="be71280b-159a-4890-9ae6-212f695de845">
<grammatical-info value="Interjection">
</grammatical-info>
<gloss lang="en"><text>having said/done that</text></gloss>
<gloss lang="ur-PK"><text>اس کے بعد ( تکیہ کلام)</text></gloss>
<example>
<form lang="bsk"><text>ne akho diya,  ećam ba siya, ja haalle apám. </text></form>
<translation type="Free translation">
<form lang="en"><text>He came here, having done/said that, I was not home. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-12-07T16:33:13Z" dateModified="2025-11-03T04:20:05Z" id="ećan_06c040a3-07a2-4de0-8ef8-5c7e84591f0b" guid="06c040a3-07a2-4de0-8ef8-5c7e84591f0b">
