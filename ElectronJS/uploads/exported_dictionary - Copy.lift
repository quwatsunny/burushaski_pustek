</field>
<sense id="4d1c53f9-9f76-41ba-b23f-82db90cbc3c9">
<grammatical-info value="Determiner">
</grammatical-info>
<gloss lang="en"><text>Plural of /akhilʰc/, like these, these sort of</text></gloss>
<gloss lang="ur-PK"><text>ایسے /اس قسم کے</text></gloss>
<example>
<form lang="bsk"><text>ja akhilʰću ses <span lang="en">x</span>óś  ayoćám</text></form>
<translation type="Free translation">
<form lang="en"><text>I would not like such people. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-03-18T02:53:32Z" dateModified="2025-11-15T03:16:07Z" id="akho_876366cd-03d0-4999-a670-0363c768c51c" guid="876366cd-03d0-4999-a670-0363c768c51c">
