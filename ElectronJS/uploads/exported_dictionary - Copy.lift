<gloss lang="ur-PK"><text>رویہ، طرز عمل</text></gloss>
<example>
<form lang="bsk"><text>doġoi xaṣ nukućha, gute bo khasap?</text></form>
<translation type="Free translation">
<form lang="en"><text>Sleeping until noon, what kind of behavior is this?</text></form>
</translation>
</example>
</sense>
</entry>
