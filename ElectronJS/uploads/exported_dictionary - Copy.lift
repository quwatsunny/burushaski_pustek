<relation type="Compare" ref="yákalʰcum_20d916a1-658b-4373-8396-f6f0e90292f6"/>
<relation type="Compare" ref="cum dusum_364dcad8-be6b-41d7-a502-2ff6efc2feb4"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>tsum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ڎُم </text></form>
</field>
<sense id="565fc7e7-96c2-4e1f-b2f0-bc2064a02a65" order="0">
<grammatical-info value="Ablative (cum, um)">
</grammatical-info>
<gloss lang="en"><text>from, from the origin, side or point (ablative case marker)</text></gloss>
<gloss lang="ur-PK"><text>سے، ماخذ سے</text></gloss>
<example>
<form lang="bsk"><text>te cum gute śuwa duwa. </text></form>
<translation type="Free translation">
<form lang="en"><text>This is better from that. </text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>khenen New York cum akholla diya. </text></form>
<translation type="Free translation">
<form lang="en"><text>This one (over here) came from New York to here. </text></form>
</translation>
</example>
</sense>
<sense id="10f82ab7-6f57-443c-ab6b-0bc97f41959e" order="1">
<grammatical-info value="Ablative (cum, um)">
</grammatical-info>
<gloss lang="en"><text>from (ablative of place from which)</text></gloss>
<gloss lang="ur-PK"><text>سے</text></gloss>
<example>
<form lang="bsk"><text>we New York cum Waśingṭona  gallen.</text></form>
<translation type="Free translation">
<form lang="en"><text>From New York, they went to Washington. </text></form>
</translation>
</example>
</sense>
<sense id="8a2709c8-a1dd-4fdb-aec4-4ea7b6ada256" order="2">
<grammatical-info value="Ablative (cum, um)">
</grammatical-info>
<gloss lang="en"><text>from</text></gloss>
<gloss lang="ur-PK"><text>سے</text></gloss>
<example>
<form lang="bsk"><text>ja acum bo doġares</text></form>
<translation type="Free translation">
<form lang="en"><text>Ask something from me.</text></form>
<form lang="ur-PK"><text>مجھ سے کچھ پوچھو۔</text></form>
</translation>
</example>
<example>
<form lang="bsk"><text>ne halles gucum iljikan ehuruṭ. </text></form>
<translation type="Free translation">
<form lang="en"><text>Make the boy sit behind (from) you. </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2023-01-12T16:12:10Z" dateModified="2025-12-21T15:18:41Z" id="cum3_df2b88ed-ffb1-4851-b7a4-8b32685ab187" guid="df2b88ed-ffb1-4851-b7a4-8b32685ab187" order="3">
<lexical-unit>
<form lang="bsk"><text>cum</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<note>
<form lang="en"><text>For comparative construction, Burushaski uses source marker (like 'from'), thus 'better than you' literally is 'better from you'</text></form>
</note>
<field type="IPA Burushaski">
<form lang="bsk"><text>tsum</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>ڎُم</text></form>
</field>
<trait name="Review 1" value="202512211"/>
<sense id="cd747dd5-979b-4b73-b487-8f87c35a2638">
<grammatical-info value="Conjunction">
</grammatical-info>
<gloss lang="en"><text>(in comparison) than, from</text></gloss>
<gloss lang="ur-PK"><text>سے </text></gloss>
<example>
<form lang="bsk"><text>go gucum neé śuwa girmiinum bai. </text></form>
<translation type="Free translation">
<form lang="en"><text>He has written better than you. He has written better from you. </text></form>
</translation>
</example>
<example>
</example>
</sense>
</entry>
