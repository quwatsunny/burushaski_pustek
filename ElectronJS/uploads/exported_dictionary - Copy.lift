</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-12-26T20:29:36Z" dateModified="2025-12-03T17:02:29Z" id="baṭa boo gīc̣um_3e9ab380-322e-4f7a-b779-c4f73a5f385e" guid="3e9ab380-322e-4f7a-b779-c4f73a5f385e">
