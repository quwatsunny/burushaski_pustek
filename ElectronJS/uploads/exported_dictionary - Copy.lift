<trait name ="semantic-domain-ddp4" value="2.1 Body"/>
</sense>
</entry>
<entry dateCreated="2019-09-13T03:09:41Z" dateModified="2025-11-16T15:54:17Z" id="ámét_4b1d419a-0aae-4077-b0b1-bf70f3b9dca1" guid="4b1d419a-0aae-4077-b0b1-bf70f3b9dca1">
