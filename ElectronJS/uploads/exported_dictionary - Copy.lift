<entry dateCreated="2019-03-13T05:18:55Z" dateModified="2025-10-08T01:12:46Z" id="phüh1_d3e0d598-4083-4560-870c-6aaf9bde6821" guid="d3e0d598-4083-4560-870c-6aaf9bde6821">
<lexical-unit>
<form lang="bsk"><text>phuh</text></form>
</lexical-unit>
<trait  name="morph-type" value="stem"/>
<field type="IPA Burushaski">
<form lang="bsk"><text>pʰuh</text></form>
</field>
<field type="Perso Arabic Burushaski">
<form lang="ur-PK"><text>پُھہ</text></form>
</field>
<sense id="5006b6b3-0149-4316-8372-c9d84ade64de">
<grammatical-info value="Adjective">
</grammatical-info>
<gloss lang="en"><text>originated from the sound  of breath, the term is used as an intensifier for sudden disappearance or consumption. </text></gloss>
<gloss lang="ur-PK"><text>ایک دم سے ختم ہو جانا۔ ایسا جیسے ایک پھونک سے ختم ہو چکا  ہو۔  </text></gloss>
<example>
<form lang="bsk"><text>ẓakune mall nuśe phuh eti. </text></form>
<translation type="Free translation">
<form lang="en"><text>The donkey ate the crop (field) and finished it. (exaggeration) </text></form>
</translation>
</example>
</sense>
</entry>
<entry dateCreated="2019-03-13T05:21:28Z" dateModified="2025-10-08T01:12:46Z" id="phüh2_2d736436-1c27-4f24-abb3-d40106d474ff" guid="2d736436-1c27-4f24-abb3-d40106d474ff">
